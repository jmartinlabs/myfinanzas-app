{
  "name": "myfinanzas-app",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "typecheck": "tsc --noEmit",
    "build": "bun run --filter @myfinanzas/web build",
    "test": "NODE_ENV=${NODE_ENV:-test} bun test apps/api",
    "test:e2e": "playwright test",
    "setup": "NODE_ENV=${NODE_ENV:-development} bun apps/api/src/setup.ts",
    "backup": "NODE_ENV=${NODE_ENV:-development} bun apps/api/src/backup-cli.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "packageManager": "bun@1.4.3"
}
