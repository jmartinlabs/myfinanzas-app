#!/usr/bin/env python3
"""Synthetic lifecycle events: no model/client invocation or global configuration."""
import json
from pathlib import Path
import runpy
import subprocess
import sys
import tempfile
import unittest

ROOT = Path(__file__).resolve().parents[1]
API = runpy.run_path(str(ROOT / 'scripts/auto-agent-usage'))
SESSION = '11111111-1111-1111-1111-111111111111'
CHILD = '22222222-2222-2222-2222-222222222222'
TURN = '33333333-3333-3333-3333-333333333333'


def record(response, thread=SESSION):
    return {'type': 'token_usage_record', 'payload': {
        'session_id': SESSION, 'thread_id': thread, 'root_turn_id': TURN,
        'turn_id': TURN, 'response_id': response,
        'usage': {'input_tokens': 100, 'cached_input_tokens': 80, 'output_tokens': 10}}}


class AutoTests(unittest.TestCase):
    def setUp(self):
        temp = tempfile.TemporaryDirectory()
        self.addCleanup(temp.cleanup)
        self.root = Path(temp.name)
        self.logs = self.root / 'logs'
        self.logs.mkdir()
        self.output = self.root / 'reports'
        self.event = {'hook_event_name': 'Stop', 'session_id': SESSION, 'cwd': str(self.root),
                      'turn_id': TURN, 'last_assistant_message': 'PRIVATE_TEXT'}
        self.write([record('r1')])

    def write(self, records):
        (self.logs / 'rollout.jsonl').write_text(''.join(json.dumps(r) + '\n' for r in records))

    def update(self, event=None):
        return API['update'](event or self.event, self.logs, self.output)

    def test_repeated_events_do_not_duplicate_and_late_usage_refreshes(self):
        self.assertEqual(self.update(), 'updated')
        for event in ('Stop', 'SubagentStop', 'SessionEnd'):
            self.assertEqual(self.update(dict(self.event, hook_event_name=event, turn_id=CHILD)), 'unchanged')
        self.assertEqual(len(list(self.output.rglob('usage.md'))), 1)
        self.write([record('r1'), record('r2', CHILD)])
        self.assertEqual(self.update(), 'updated')
        self.assertEqual(len(list(self.output.rglob('usage.md'))), 2)
        state = json.loads((self.output / SESSION / 'latest.json').read_text())
        md = Path(state['markdown']).read_text()
        self.assertIn('Recorded input: 200', md)
        self.assertNotIn('PRIVATE_TEXT', md)

    def test_unsupported_events_and_path_traversal(self):
        self.assertEqual(self.update(dict(self.event, hook_event_name='PreToolUse')), 'ignored')
        self.assertFalse(self.output.exists())
        with self.assertRaises(ValueError):
            self.update(dict(self.event, session_id='../escape'))

    def test_concurrent_lock_never_overwrites_or_waits(self):
        self.update()
        lock = self.output / SESSION / '.update-lock'
        with lock.open('a') as stream:
            API['fcntl'].flock(stream, API['fcntl'].LOCK_EX | API['fcntl'].LOCK_NB)
            self.assertEqual(self.update(), 'busy')
            self.assertEqual(len(list(self.output.rglob('usage.md'))), 1)
        self.assertEqual(self.update(), 'unchanged')

    def test_empty_logs_leave_no_success_pointer_and_release_lock(self):
        (self.logs / 'rollout.jsonl').unlink()
        with self.assertRaises(ValueError):
            self.update()
        self.assertFalse((self.output / SESSION / 'latest.json').exists())
        self.write([record('r1')])
        self.assertEqual(self.update(), 'updated')

    def test_failed_refresh_keeps_previous_pointer(self):
        self.update()
        state = self.output / SESSION / 'latest.json'
        original = state.read_bytes()
        self.write([record('r1'), record('r2')])
        writer = API['REPORT']['write_report']
        def fail(*args, **kwargs):
            raise OSError('synthetic output failure')
        API['REPORT']['write_report'] = fail
        try:
            with self.assertRaises(OSError):
                self.update()
        finally:
            API['REPORT']['write_report'] = writer
        self.assertEqual(state.read_bytes(), original)
        self.assertEqual(self.update(), 'updated')

    def test_corrupt_pointer_is_advisory_failure(self):
        self.update()
        (self.output / SESSION / 'latest.json').write_text('[]')
        command = [sys.executable, str(ROOT / 'scripts/auto-agent-usage'),
                   '--sessions-dir', str(self.logs), '--output-dir', str(self.output)]
        result = subprocess.run(command, input=json.dumps(self.event), capture_output=True, text=True)
        self.assertEqual(result.returncode, 0)
        self.assertIn('systemMessage', json.loads(result.stdout))
        self.assertEqual(len(list(self.output.rglob('usage.md'))), 1)

    def test_protocol_does_not_request_continuation_even_on_failure(self):
        command = [sys.executable, str(ROOT / 'scripts/auto-agent-usage'),
                   '--sessions-dir', str(self.logs), '--output-dir', str(self.output)]
        for payload in (self.event, {}, {'hook_event_name': 'Stop', 'cwd': '/fixture', 'session_id': '../bad'}):
            with self.subTest(payload=payload):
                result = subprocess.run(command, input=json.dumps(payload), capture_output=True, text=True)
                self.assertEqual(result.returncode, 0)
                response = json.loads(result.stdout)
                self.assertNotIn('decision', response)
                self.assertNotIn('continue', response)
                self.assertNotIn('hookSpecificOutput', response)
        self.assertEqual(json.loads(subprocess.run(command, input=json.dumps(self.event),
                                                  capture_output=True, text=True).stdout), {})

    def test_configuration_is_only_local_advisory_lifecycle_hooks(self):
        config = json.loads((ROOT / '.codex/hooks.json').read_text())
        self.assertEqual(set(config['hooks']), {'Stop', 'SubagentStop', 'SessionEnd'})
        for groups in config['hooks'].values():
            hook = groups[0]['hooks'][0]
            self.assertEqual(hook['type'], 'command')
            self.assertLessEqual(hook['timeout'], 3)
            self.assertIn('scripts/auto-agent-usage', hook['command'])
            self.assertNotIn('async', hook)


if __name__ == '__main__':
    unittest.main()
