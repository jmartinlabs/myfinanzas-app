#!/usr/bin/env python3
"""Reproducibility regressions for the private release recipe (no Podman)."""
import io
import json
from pathlib import Path
import subprocess
import sys
import tarfile
import tempfile
import unittest
import uuid

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'infra'))
import release  # noqa: E402


OLD_CONTAINERFILE = b'FROM scratch\n# selected release\n'
OLD_HEALTHCHECK = b'console.log("selected release");\n'
NEW_CONTAINERFILE = b'FROM oven/bun:1.4.3-debian\n# builder HEAD\n'
NEW_HEALTHCHECK = b'console.log("builder HEAD");\n'
SEED_CONTAINERFILE = b'FROM scratch\n# test-only seed\n'
SEED_IMAGE = 'sha256:' + '1' * 64


class ReleaseContextTests(unittest.TestCase):
    def setUp(self):
        temp = tempfile.TemporaryDirectory()
        self.addCleanup(temp.cleanup)
        self.home = Path(temp.name).resolve()
        self.root = self.home / 'repo'
        self.root.mkdir()
        self.git('init', '-q', '--initial-branch=main')
        self.git('config', 'user.name', 'Fixture')
        self.git('config', 'user.email', 'fixture@example.invalid')
        self.git('config', 'commit.gpgsign', 'false')
        self.write_tree(OLD_CONTAINERFILE, OLD_HEALTHCHECK)
        self.a = self.commit('selected release')
        self.write('infra/Containerfile', NEW_CONTAINERFILE)
        self.write('infra/healthcheck.mjs', NEW_HEALTHCHECK)
        self.b = self.commit('builder HEAD')
        self.age = self.age_archive()
        self.original_source = release.SOURCE
        release.SOURCE = self.root
        self.addCleanup(self.restore_source)

    def restore_source(self):
        release.SOURCE = self.original_source

    def git(self, *args):
        return subprocess.check_output(['git', '-C', str(self.root), *args],
                                       stderr=subprocess.PIPE).decode().strip()

    def write(self, name, data):
        path = self.root / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(data if isinstance(data, bytes) else data.encode())

    def write_tree(self, containerfile, healthcheck):
        self.write('package.json', '{}\n')
        self.write('bun.lock', 'fixture lock\n')
        self.write('tsconfig.json', '{}\n')
        self.write('apps/api/package.json', '{"private": true}\n')
        self.write('apps/web/package.json', '{"private": true}\n')
        self.write('apps/web/index.html', '<div></div>\n')
        self.write('apps/web/vite.config.ts', 'export default {};\n')
        self.write('apps/api/src/database-identity.ts',
                   'export const schemaVersion = 18;\n')
        self.write('apps/api/src/backup.ts',
                   'export const contract = "e4.1-v18";\n')
        self.write('apps/api/src/contracts.json', '{}\n')
        self.write('apps/web/src/main.ts', 'export const amount = 1;\n')
        self.write('apps/web/public/themes.css', ':root { --bg: #141414; }\n')
        self.write('apps/web/public/theme-boot.js',
                   'document.documentElement.dataset.theme = "dark-s";\n')
        self.write('infra/Containerfile', containerfile)
        self.write('infra/healthcheck.mjs', healthcheck)
        self.write('infra/Containerfile.seed', SEED_CONTAINERFILE)
        self.write('tools/test-seed/cli.ts', 'export const seed = 1;\n')
        self.write('tools/test-seed/dataset/ft1.json', '{}\n')
        self.write('tools/test-seed/README.md', 'not copied into the context\n')

    def commit(self, message):
        subprocess.check_call(['git', '-C', str(self.root), 'add', '--all'])
        subprocess.check_call(['git', '-C', str(self.root), 'commit', '-qm', message])
        return self.git('rev-parse', 'HEAD')

    def age_archive(self):
        buffer = io.BytesIO()
        with tarfile.open(fileobj=buffer, mode='w:gz') as archive:
            for name in ('age', 'age-keygen'):
                data = b'#!/bin/sh\nexit 0\n'
                entry = tarfile.TarInfo('age/' + name)
                entry.size = len(data)
                entry.mode = 0o755
                archive.addfile(entry, io.BytesIO(data))
        return buffer.getvalue()

    def oci_archive(self, path, payload):
        blob = release.sha(payload)
        index = json.dumps({'manifests': [
            {'digest': 'sha256:' + blob}]}).encode()
        with tarfile.open(path, 'w') as archive:
            for name, data in (('index.json', index),
                               ('blobs/sha256/' + blob, payload)):
                entry = tarfile.TarInfo(name)
                entry.size = len(data)
                archive.addfile(entry, io.BytesIO(data))
        return 'sha256:' + blob

    def rewrite_manifest(self, directory, change):
        path = directory / 'manifest.json'
        manifest = json.loads(path.read_text())
        change(manifest)
        path.write_text(json.dumps(manifest, sort_keys=True))
        return release.sha(path.read_bytes())

    def synthetic_release(self, source, recipe_sha, healthcheck_sha, include_seed=True):
        directory = self.home / ('release-' + uuid.uuid4().hex)
        directory.mkdir()
        (directory / 'frontend').mkdir()
        (directory / 'frontend/assets').mkdir()
        (directory / 'frontend/index.html').write_text('<div></div>\n')
        (directory / 'frontend/assets/app.js').write_text('export const app = 1;\n')
        frontend_files = {
            'index.html': release.sha((directory / 'frontend/index.html').read_bytes()),
            'assets/app.js': release.sha((directory / 'frontend/assets/app.js').read_bytes()),
        }
        app_archive = directory / 'image.oci.tar'
        app_digest = self.oci_archive(app_archive, b'application')
        seed_archive = directory / 'image.seed.oci.tar'
        seed_digest = self.oci_archive(seed_archive, b'seed')
        contracts = release.contracts_for(source)
        lock = release.sha(release.source_bytes(source, 'bun.lock'))
        manifest = {
            'format': 1,
            'image': 'sha256:' + '2' * 64,
            'oci_manifest_digest': app_digest,
            'rootfs_payload_sha256': '3' * 64,
            'inputs': {
                'source': source,
                'contracts': contracts,
                'lock_sha256': lock,
                'recipe_sha256': recipe_sha,
                'healthcheck_sha256': healthcheck_sha,
            },
            'oci_archive_sha256': release.sha(app_archive.read_bytes()),
            'frontend_files': frontend_files,
        }
        if include_seed:
            manifest['seed'] = {
                'image': SEED_IMAGE,
                'oci_manifest_digest': seed_digest,
                'rootfs_payload_sha256': '4' * 64,
                'recipe_sha256': release.sha(SEED_CONTAINERFILE),
                'source': source,
                'contracts': contracts,
                'lock_sha256': lock,
                'oci_archive_sha256': release.sha(seed_archive.read_bytes()),
            }
        path = directory / 'manifest.json'
        path.write_text(json.dumps(manifest, sort_keys=True))
        return directory, release.sha(path.read_bytes())

    def test_context_uses_selected_commit_not_builder_head(self):
        target = self.home / 'context-a'
        target.mkdir()
        inputs = release.context(self.a, target, self.age)
        release.check_context(target, inputs)
        self.assertEqual(inputs['source'], self.a)
        self.assertEqual(inputs['builder_source'], self.b)
        self.assertEqual((target / 'Containerfile').read_bytes(), OLD_CONTAINERFILE)
        self.assertEqual((target / 'healthcheck.mjs').read_bytes(), OLD_HEALTHCHECK)
        self.assertEqual(inputs['recipe_sha256'],
                         release.sha((target / 'Containerfile').read_bytes()))
        self.assertEqual(inputs['healthcheck_sha256'],
                         release.sha((target / 'healthcheck.mjs').read_bytes()))
        # N1: pre-fix context materialized and hashed builder HEAD (commit B).
        # These assertions turn red if that fallback returns.
        self.assertNotEqual(inputs['recipe_sha256'], release.sha(NEW_CONTAINERFILE))
        self.assertNotEqual(inputs['healthcheck_sha256'], release.sha(NEW_HEALTHCHECK))
        self.assertNotEqual(inputs['recipe_sha256'],
                            release.sha(release.source_bytes('HEAD', 'infra/Containerfile')))

    def test_context_carries_vite_public_assets(self):
        target = self.home / 'context-public'
        target.mkdir()
        release.context(self.a, target, self.age)
        self.assertTrue((target / 'apps/web/public/themes.css').is_file())
        self.assertTrue((target / 'apps/web/public/theme-boot.js').is_file())

    def test_release_rejects_referenced_asset_outside_frontend(self):
        # Regression: index.html referenced /themes.css and /theme-boot.js while
        # the release shipped only index.html and assets/.
        html = (b'<script src="/theme-boot.js"></script>'
                b'<link rel="stylesheet" href="/themes.css" />'
                b'<script type="module" src="/assets/app.js"></script>')
        self.assertEqual(
            release.missing_frontend_assets(html, {'index.html': 'x', 'assets/app.js': 'y'}),
            ['theme-boot.js', 'themes.css'])
        self.assertEqual(release.missing_frontend_assets(
            html, {'theme-boot.js': 'x', 'themes.css': 'y', 'assets/app.js': 'z'}), [])
        self.assertEqual(release.missing_frontend_assets(
            b'<link href="//cdn.example/x.css"><script src="https://e/x.js"></script>', {}), [])

    def test_seed_context_uses_same_commit_base_and_lock(self):
        target = self.home / 'seed-context-a'
        target.mkdir()
        inputs = release.seed_context(self.a, target)
        release.check_context(target, inputs, release.SEED_CONTEXT_FILES)
        self.assertEqual(inputs['source'], self.a)
        self.assertEqual(inputs['builder_source'], self.b)
        self.assertEqual(inputs['base'], release.BASE)
        self.assertEqual(inputs['lock_sha256'],
                         release.sha(release.source_bytes(self.a, 'bun.lock')))
        self.assertEqual(inputs['recipe_sha256'], release.sha(SEED_CONTAINERFILE))
        self.assertEqual((target / 'Containerfile.seed').read_bytes(), SEED_CONTAINERFILE)
        self.assertTrue((target / 'tools/test-seed/cli.ts').is_file())
        self.assertTrue((target / 'tools/test-seed/dataset/ft1.json').is_file())
        self.assertFalse((target / 'tools/test-seed/README.md').exists())

    def test_seed_recipe_is_pinned_and_test_only(self):
        recipe = (ROOT / 'infra/Containerfile.seed').read_text()
        self.assertIn('FROM ' + release.BASE, recipe)
        self.assertIn('COPY tools/test-seed tools/test-seed', recipe)
        self.assertIn('USER 10001:10001', recipe)
        self.assertIn('ENTRYPOINT ["/usr/local/bin/bun"]', recipe)
        self.assertIn('CMD ["tools/test-seed/cli.ts"]', recipe)
        self.assertNotIn('test-seed', (ROOT / 'infra/Containerfile').read_text())

    def test_production_context_excludes_test_seed(self):
        target = self.home / 'context-no-seed'
        target.mkdir()
        inputs = release.context(self.a, target, self.age)
        release.check_context(target, inputs)
        self.assertFalse((target / 'tools/test-seed').exists())
        self.assertFalse((target / 'Containerfile.seed').exists())

    def test_verify_requires_seed_block(self):
        directory, digest = self.synthetic_release(
            self.a, release.sha(OLD_CONTAINERFILE), release.sha(OLD_HEALTHCHECK),
            include_seed=False)
        with self.assertRaises(release.ReleaseError) as caught:
            release.verify(directory, self.a, digest)
        self.assertIn('seed image is missing', str(caught.exception))

    def test_previous_release_verifies_without_seed(self):
        directory, digest = self.synthetic_release(
            self.a, release.sha(OLD_CONTAINERFILE), release.sha(OLD_HEALTHCHECK),
            include_seed=False)
        manifest = release.verify(directory, self.a, digest, require_seed=False)
        self.assertNotIn('seed', manifest)

    def test_previous_verification_rejects_an_unexpected_seed(self):
        directory, digest = self.synthetic_release(
            self.a, release.sha(OLD_CONTAINERFILE), release.sha(OLD_HEALTHCHECK),
            include_seed=True)
        with self.assertRaises(release.ReleaseError) as caught:
            release.verify(directory, self.a, digest, require_seed=False)
        self.assertIn('unexpectedly declares a seed', str(caught.exception))

    def test_verify_rejects_seed_archive_and_digest_mismatch(self):
        directory, digest = self.synthetic_release(
            self.a, release.sha(OLD_CONTAINERFILE), release.sha(OLD_HEALTHCHECK))
        archive = directory / 'image.seed.oci.tar'
        archive.write_bytes(archive.read_bytes() + b'x')
        with self.assertRaises(release.ReleaseError) as caught:
            release.verify(directory, self.a, digest)
        self.assertIn('seed OCI integrity', str(caught.exception))

        directory, digest = self.synthetic_release(
            self.a, release.sha(OLD_CONTAINERFILE), release.sha(OLD_HEALTHCHECK))
        digest = self.rewrite_manifest(
            directory, lambda manifest: manifest['seed'].update(
                {'oci_manifest_digest': 'sha256:' + '0' * 64}))
        with self.assertRaises(release.ReleaseError) as caught:
            release.verify(directory, self.a, digest)
        self.assertIn('seed OCI manifest digest', str(caught.exception))

    def test_verify_rejects_seed_source_contract_lock_and_recipe_mismatch(self):
        cases = [
            ('source', lambda manifest: manifest['seed'].update({'source': '0' * 40}),
             'seed/app source'),
            ('contracts', lambda manifest: manifest['seed'].update(
                {'contracts': {'schema': 0}}), 'seed/app contract'),
            ('lock', lambda manifest: manifest['seed'].update({'lock_sha256': '0' * 64}),
             'seed/app lock'),
            ('recipe', lambda manifest: manifest['seed'].update({'recipe_sha256': '0' * 64}),
             'recipe_sha256'),
        ]
        for label, change, expected in cases:
            with self.subTest(label=label):
                directory, digest = self.synthetic_release(
                    self.a, release.sha(OLD_CONTAINERFILE), release.sha(OLD_HEALTHCHECK))
                digest = self.rewrite_manifest(directory, change)
                with self.assertRaises(release.ReleaseError) as caught:
                    release.verify(directory, self.a, digest)
                self.assertIn(expected, str(caught.exception))

    def test_verify_rejects_builder_head_recipe_hash(self):
        directory, digest = self.synthetic_release(
            self.a, release.sha(NEW_CONTAINERFILE), release.sha(OLD_HEALTHCHECK))
        with self.assertRaises(release.ReleaseError) as caught:
            release.verify(directory, self.a, digest)
        self.assertIn('infra/Containerfile', str(caught.exception))
        self.assertIn(self.a, str(caught.exception))

    def test_verify_rejects_builder_head_healthcheck_hash(self):
        directory, digest = self.synthetic_release(
            self.a, release.sha(OLD_CONTAINERFILE), release.sha(NEW_HEALTHCHECK))
        with self.assertRaises(release.ReleaseError) as caught:
            release.verify(directory, self.a, digest)
        self.assertIn('infra/healthcheck.mjs', str(caught.exception))
        self.assertIn(self.a, str(caught.exception))

    def test_single_build_test_artifact_is_explicit_and_verified(self):
        directory, digest = self.synthetic_release(
            self.a, release.sha(OLD_CONTAINERFILE), release.sha(OLD_HEALTHCHECK))
        def single(manifest):
            for item in (manifest, manifest['seed']):
                item['reproducibility'] = {
                    'mode': 'single-build', 'payload_equal': None,
                    'builds': [{'rootfs_payload_sha256': item['rootfs_payload_sha256']}],
                }
        digest = self.rewrite_manifest(directory, single)
        verified = release.verify(directory, self.a, digest)
        self.assertEqual(verified['reproducibility']['mode'], 'single-build')
        digest = self.rewrite_manifest(
            directory, lambda m: m['seed']['reproducibility']['builds'][0].update(
                {'rootfs_payload_sha256': '0' * 64}))
        with self.assertRaises(release.ReleaseError):
            release.verify(directory, self.a, digest)

    def test_single_build_cannot_claim_two_build_proof(self):
        directory, digest = self.synthetic_release(
            self.a, release.sha(OLD_CONTAINERFILE), release.sha(OLD_HEALTHCHECK))
        digest = self.rewrite_manifest(directory, lambda m: m['seed'].update({
            'reproducibility': {'mode': 'single-build', 'payload_equal': True,
                                'builds': [{'rootfs_payload_sha256': '4' * 64}]}
        }))
        with self.assertRaises(release.ReleaseError):
            release.verify(directory, self.a, digest)

    def test_verify_accepts_selected_commit_recipe_hashes(self):
        directory, digest = self.synthetic_release(
            self.a, release.sha(OLD_CONTAINERFILE), release.sha(OLD_HEALTHCHECK))
        manifest = release.verify(directory, self.a, digest)
        self.assertEqual(manifest['inputs']['source'], self.a)

    def missing_release_file(self, path, branch):
        self.git('switch', '-q', '-c', branch, self.a)
        (self.root / path).unlink()
        commit = self.commit('missing ' + path)
        target = self.home / ('context-' + branch)
        target.mkdir()
        with self.assertRaises(release.ReleaseError) as caught:
            release.context(commit, target, self.age)
        message = str(caught.exception)
        self.assertIn(path, message)
        self.assertIn(commit, message)
        self.assertEqual(list(target.iterdir()), [])
        directory, digest = self.synthetic_release(
            commit, release.sha(OLD_CONTAINERFILE), release.sha(OLD_HEALTHCHECK))
        with self.assertRaises(release.ReleaseError) as caught:
            release.verify(directory, commit, digest)
        message = str(caught.exception)
        self.assertIn(path, message)
        self.assertIn(commit, message)
        return commit

    def test_missing_containerfile_fails_closed_without_artifact(self):
        self.missing_release_file('infra/Containerfile', 'without-containerfile')

    def test_missing_healthcheck_fails_closed_without_artifact(self):
        self.missing_release_file('infra/healthcheck.mjs', 'without-healthcheck')

    def test_source_bytes_names_absent_path_and_commit(self):
        with self.assertRaises(release.ReleaseError) as caught:
            release.source_bytes(self.a, 'infra/missing.txt')
        message = str(caught.exception)
        self.assertIn('infra/missing.txt', message)
        self.assertIn(self.a, message)

    def test_dirty_builder_is_still_rejected(self):
        output = self.home / 'dirty-release'
        (self.root / 'dirty.txt').write_text('uncommitted\n')
        with self.assertRaises(release.ReleaseError) as caught:
            release.build(output)
        self.assertIn('clean checkout required', str(caught.exception))
        self.assertFalse(output.exists())


if __name__ == '__main__':
    unittest.main(verbosity=2)
