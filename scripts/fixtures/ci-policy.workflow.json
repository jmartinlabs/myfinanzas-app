{
  "name": "Validate project",
  "on": {
    "push": {
      "tags": [
        "deploy-test-v*"
      ]
    },
    "pull_request": {
      "branches": [
        "main",
        "test"
      ],
      "types": [
        "opened",
        "synchronize",
        "reopened",
        "ready_for_review"
      ]
    },
    "workflow_dispatch": {}
  },
  "permissions": {
    "contents": "read"
  },
  "concurrency": {
    "group": "${{ github.workflow }}:${{ github.event.pull_request.head.repo.full_name || github.repository }}:${{ github.ref_type == 'tag' && 'tag' || 'branch' }}:${{ github.head_ref || github.ref_name }}:${{ github.event_name == 'workflow_dispatch' && github.run_id || 'automatic' }}",
    "cancel-in-progress": "${{ github.event_name == 'pull_request' }}"
  },
  "jobs": {
    "required": {
      "runs-on": "ubuntu-24.04",
      "timeout-minutes": 25,
      "permissions": {
        "contents": "read",
        "pull-requests": "read"
      },
      "outputs": {
        "profile": "${{ steps.plan.outputs.profile }}"
      },
      "steps": [
        {
          "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
          "with": {
            "fetch-depth": 0,
            "persist-credentials": false
          }
        },
        {
          "uses": "actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0",
          "with": {
            "python-version": "3.12"
          }
        },
        {
          "id": "context",
          "name": "Resolve integration context",
          "env": {
            "GH_TOKEN": "${{ github.token }}"
          },
          "run": "python3 scripts/ci_context.py"
        },
        {
          "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
          "with": {
            "fetch-depth": 0,
            "persist-credentials": false,
            "ref": "${{ steps.context.outputs.ref }}"
          }
        },
        {
          "id": "snapshot",
          "name": "Freeze validated checkout",
          "env": {
            "CI_CHECKOUT_REF": "${{ steps.context.outputs.ref }}"
          },
          "run": "python3 scripts/ci_context.py snapshot"
        },
        {
          "id": "plan",
          "name": "Select conservative CI execution profile",
          "run": "set -eu\nprofile=\"$(python3 scripts/verify ci-plan)\"\ncase \"$profile\" in docs|fast|critical|full) ;; *) echo \"Invalid CI profile\" >&2; exit 1;; esac\nprintf 'profile=%s\\n' \"$profile\" >> \"$GITHUB_OUTPUT\"\n",
          "env": {
            "CI_CHECKOUT_REF": "${{ steps.context.outputs.ref }}"
          }
        },
        {
          "id": "summary",
          "name": "Publish selected CI profile",
          "env": {
            "CI_PROFILE": "${{ steps.plan.outputs.profile }}"
          },
          "run": "profile=\"$(printf '%s' \"$CI_PROFILE\" | tr '[:lower:]' '[:upper:]')\"\ncase \"$profile\" in DOCS|FAST|CRITICAL|FULL) ;; *) echo \"Invalid CI profile\" >&2; exit 1;; esac\nprintf 'Perfil CI: %s\\n' \"$profile\" >> \"$GITHUB_STEP_SUMMARY\"\n"
        },
        {
          "id": "baseline",
          "name": "Repository, project and document checks",
          "run": "python3 scripts/verify baseline",
          "env": {
            "CI_CHECKOUT_REF": "${{ steps.context.outputs.ref }}"
          }
        },
        {
          "id": "bun",
          "if": "${{ steps.plan.outputs.profile != 'docs' }}",
          "uses": "oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6",
          "with": {
            "bun-version-file": ".bun-version"
          }
        },
        {
          "id": "install",
          "if": "${{ steps.plan.outputs.profile != 'docs' }}",
          "run": "bun install --frozen-lockfile"
        },
        {
          "id": "prepare",
          "if": "${{ steps.plan.outputs.profile == 'full' }}",
          "name": "Prepare Linux full dependencies",
          "env": {
            "CI_PROFILE": "${{ steps.plan.outputs.profile }}"
          },
          "run": "python3 scripts/ci_prepare_linux.py"
        },
        {
          "id": "browser",
          "if": "${{ steps.plan.outputs.profile == 'full' }}",
          "run": "node node_modules/@playwright/test/cli.js install chromium"
        },
        {
          "id": "verify",
          "name": "Canonical CI application verification",
          "env": {
            "CI_CHECKOUT_REF": "${{ steps.context.outputs.ref }}"
          },
          "run": "python3 scripts/verify ci"
        },
        {
          "name": "Reject failed, cancelled or unexpectedly skipped phases",
          "if": "${{ always() }}",
          "env": {
            "CI_CONTEXT": "${{ steps.context.outcome }}",
            "CI_SNAPSHOT": "${{ steps.snapshot.outcome }}",
            "CI_PLAN": "${{ steps.plan.outcome }}",
            "CI_BASELINE": "${{ steps.baseline.outcome }}",
            "CI_VERIFY": "${{ steps.verify.outcome }}",
            "CI_BUN": "${{ steps.bun.outcome }}",
            "CI_INSTALL": "${{ steps.install.outcome }}",
            "CI_PREPARE": "${{ steps.prepare.outcome }}",
            "CI_BROWSER": "${{ steps.browser.outcome }}",
            "CI_PROFILE": "${{ steps.plan.outputs.profile }}"
          },
          "run": "python3 scripts/verify ci-result"
        }
      ]
    },
    "profile": {
      "name": "CI profile: ${{ needs.required.outputs.profile || 'UNKNOWN' }}",
      "needs": "required",
      "if": "${{ always() }}",
      "runs-on": "ubuntu-24.04",
      "timeout-minutes": 5,
      "steps": [
        {
          "name": "Record selected CI profile",
          "env": {
            "CI_PROFILE": "${{ needs.required.outputs.profile || 'UNKNOWN' }}"
          },
          "run": "printf 'CI profile: %s\\n' \"$CI_PROFILE\"\n"
        }
      ]
    }
  }
}
