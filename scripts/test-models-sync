#!/usr/bin/env python3
"""Selector safety and native adapters on disposable Git fixtures. No models or real apply."""
import copy
import json
import os
from pathlib import Path
import runpy
import shutil
import subprocess
import sys
import tempfile
import unittest
from unittest.mock import patch

ROOT = Path(__file__).resolve().parents[1]
SCRIPT = ROOT / 'scripts/models-sync'
MODULE = runpy.run_path(str(SCRIPT))
CHOICE = {'provider': 'provider-a', 'model': 'future-large', 'effort': 'high'}
try:
    import tomllib
    parse_toml = tomllib.loads
except ImportError:  # Python3.10: generated TOML uses only JSON-compatible string scalars.
    def parse_toml(text):
        return {key.strip(): json.loads(value) for key, value in
                (line.split('=', 1) for line in text.splitlines())}



class ModelsSync(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        self.root = Path(self.tmp.name).resolve().resolve() / 'repo'
        self.root.mkdir()
        for directory in ('.agents/roles', '.claude/agents', '.opencode/agents'):
            shutil.copytree(ROOT / directory, self.root / directory)
        (self.root / '.gitignore').write_text((ROOT / '.gitignore').read_text())
        self.git('init', '-q')
        self.git('add', '.')
        self.config = {'version': 1, 'roles': {'implementation': CHOICE.copy()}}
        client = {'version': '1.0', 'session_provider': 'provider-a',
                  'models': [{'provider': 'provider-a', 'model': 'future-large', 'efforts': ['high', 'low']},
                             {'provider': 'provider-b', 'model': 'other', 'efforts': ['max']}]}
        self.catalog = {'version': 1, 'source': 'fixture-observation', 'observed_at': '2026-11-18T10:00:00Z',
                        'clients': {name: client | {'format': fmt} for name, fmt in MODULE['FORMATS'].items()}}
        self.save()

    def git(self, *args):
        return subprocess.run(['git', '-C', str(self.root), *args], check=True,
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE).stdout

    def save(self):
        (self.root / '.agents/models.local.yaml').write_text(json.dumps(self.config))
        (self.root / '.agents/models.catalog.local.json').write_text(json.dumps(self.catalog))

    def call(self, *args, status=0, client='codex'):
        result = subprocess.run([sys.executable, str(SCRIPT), '--root', str(self.root),
                                 '--client', client, *args], capture_output=True, text=True)
        self.assertEqual(result.returncode, status, result.stdout + result.stderr)
        self.assertNotRegex(result.stdout, r'(?m)^PASS(?: |:)')
        return result.stdout + result.stderr

    def snapshot(self):
        return {str(p.relative_to(self.root)): (p.read_bytes(), p.stat().st_mtime_ns, p.stat().st_mode)
                for p in self.root.rglob('*') if p.is_file()}

    def generated(self, client='codex', role='implementation'):
        suffix = 'toml' if client == 'codex' else 'md'
        return self.root / f'.{client}/agents/models-local-{role}.{suffix}'

    def test_check_is_read_only_preview(self):
        before = self.snapshot()
        out = self.call()
        self.assertIn('proposed', out)
        self.assertIn('CONFIG_ONLY', out)
        self.assertIn('UNVERIFIED', out)
        self.assertEqual(before, self.snapshot())
        self.assertFalse((self.root / '.codex').exists())

    def test_explicit_apply_required_client(self):
        result = subprocess.run([sys.executable, str(SCRIPT), '--root', str(self.root), '--apply'],
                                capture_output=True, text=True)
        self.assertEqual(result.returncode, 2)
        self.assertIn('requires --client', result.stderr)

    def test_codex_high_model_no_default_ceiling(self):
        self.call('--apply')
        fields = parse_toml(self.generated().read_text())
        self.assertEqual(fields['model'], 'future-large')
        self.assertEqual(fields['model_reasoning_effort'], 'high')
        self.assertEqual(fields['developer_instructions'], (self.root / '.agents/roles/implementation.md').read_text())
        self.assertNotIn('model_provider', fields)
        self.assertEqual(fields['name'], 'models-local-implementation')
        self.assertFalse((self.root / '.codex/config.toml').exists())
        self.assertEqual(self.generated().stat().st_mode & 0o777, 0o600)

    def test_idempotence_content_and_mtime(self):
        self.call('--apply'); before = self.snapshot()
        self.assertIn('0 changed files', self.call('--apply'))
        self.assertEqual(before, self.snapshot())

    def test_codex_unicode_prompt_is_valid_native_toml(self):
        source = self.root / '.agents/roles/implementation.md'
        original = source.read_text() + '\nUnicode: 😀 𝄞; escaped control: \x7f\n'
        source.write_text(original)
        self.call('--apply')
        text = self.generated().read_text()
        self.assertNotRegex(text, r'\\u[dD][89a-fA-F][0-9a-fA-F]{2}')
        self.assertEqual(parse_toml(text)['developer_instructions'], original)

    def test_ignored_and_untracked(self):
        self.call('--apply')
        for path in (self.generated(), self.root / MODULE['MANIFEST'],
                     self.root / '.agents/models.local.yaml', self.root / '.agents/models.catalog.local.json'):
            self.git('check-ignore', str(path.relative_to(self.root)))
        self.assertNotIn(b'models-local', self.git('ls-files'))

    def test_claude_preserves_prompt_and_permissions(self):
        original = (self.root / '.claude/agents/implementation.md').read_text()
        self.call('--apply', client='claude')
        generated = self.generated('claude').read_text()
        self.assertEqual(original.split('\n---\n', 1)[1], generated.split('\n---\n', 1)[1])
        self.assertIn('tools: Read, Glob, Grep, Bash, Edit, Write', generated)
        self.assertIn('name: models-local-implementation', generated)
        self.assertIn('model: future-large\neffort: high', generated)
        self.assertEqual(original, (self.root / '.claude/agents/implementation.md').read_text())

    def test_opencode_native_roles_mixed_providers_and_no_coordinator(self):
        self.config['roles']['functional'] = {'provider': 'provider-b', 'model': 'other', 'effort': 'max'}
        self.save(); original = (self.root / '.opencode/agents/implementation.md').read_bytes()
        self.call('--apply', client='opencode')
        data = json.loads((self.root / '.opencode/opencode.json').read_text())
        self.assertEqual(data, {'agents': {'implementation': {'model': 'provider-a/future-large#high'},
                                         'functional': {'model': 'provider-b/other#max'}}})
        self.assertEqual(original, (self.root / '.opencode/agents/implementation.md').read_bytes())

    def test_shared_review_qa_alias(self):
        self.config['roles'] = {'review': CHOICE.copy(), 'qa': CHOICE.copy()}; self.save()
        for client in ('codex', 'claude'):
            self.call('--apply', client=client)
            self.assertTrue(self.generated(client, 'qa-review').exists())
        self.assertIn('QA execution UNSUPPORTED', self.call('--apply', client='opencode'))
        self.assertEqual(list(json.loads((self.root / '.opencode/opencode.json').read_text())['agents']), ['review'])

    def test_shared_review_qa_conflict_no_partial_writes(self):
        self.config['roles'].update(review=CHOICE.copy(), qa=CHOICE | {'effort': 'low'}); self.save()
        before = self.snapshot()
        for client in ('codex', 'claude', 'opencode'):
            self.assertIn('CONFLICT shared', self.call('--apply', client=client, status=2))
        self.assertEqual(before, self.snapshot())

    def test_overrides_and_explicit_allowlists(self):
        self.config['clients'] = {'codex': {'roles': {'implementation': {'effort': 'low'}}}}
        self.config['constraints'] = {'providers': ['provider-a'], 'models': ['future-large'], 'efforts': ['low']}
        self.save(); self.call('--apply')
        self.assertEqual(parse_toml(self.generated().read_text())['model_reasoning_effort'], 'low')

    def test_allowlist_violation(self):
        for field, values in [('providers', ['other']), ('models', ['other']), ('efforts', ['low'])]:
            with self.subTest(field=field):
                self.config['constraints'] = {field: values}; self.save()
                self.assertIn('allowlist', self.call('--apply', status=2))
        self.assertFalse(self.generated().exists())

    def test_inherited_provider(self):
        self.config['roles']['implementation']['provider'] = 'inherit'
        self.config['constraints'] = {'providers': ['provider-a']}
        self.save()
        self.call('--apply')
        self.assertNotIn('model_provider', self.generated().read_text())

    def test_wrong_session_provider_unsupported(self):
        self.config['roles']['implementation'] = {'provider': 'provider-b', 'model': 'other', 'effort': 'max'}
        self.save()
        for client in ('codex', 'claude'):
            self.assertIn('UNSUPPORTED per-role provider', self.call('--apply', client=client, status=2))
        self.assertFalse(self.generated().exists())

    def test_provider_tokenplan_and_slash_model_are_valid(self):
        choice = {'provider': 'alibaba-token-plan', 'model': 'deepseek/deepseek-v4.1-flash-1017'}
        self.config['roles']['implementation'] = choice
        self.catalog['clients']['opencode']['models'].append(choice | {'efforts': []})
        self.save(); self.call('--apply', client='opencode')
        data = json.loads((self.root / '.opencode/opencode.json').read_text())
        self.assertEqual(data['agents']['implementation']['model'],
                         'alibaba-token-plan/deepseek/deepseek-v4.1-flash-1017')

    def test_coordinator_sentinel_only(self):
        self.config['coordinator'] = 'client-selected'; self.save(); self.call()
        self.config['coordinator'] = 'future-large'; self.save()
        self.assertIn('coordinator must remain', self.call('--apply', status=2))

    def test_unknown_provider_model_effort(self):
        for field in ('provider', 'model', 'effort'):
            self.config['roles']['implementation'] = CHOICE | {field: 'not-available'}; self.save()
            self.assertIn('UNSUPPORTED', self.call('--apply', status=2))

    def test_missing_catalog_unverified_refuses_apply(self):
        (self.root / '.agents/models.catalog.local.json').unlink()
        self.assertIn('UNVERIFIED', self.call(status=2))
        self.assertIn('catalog required', self.call('--apply', status=2))
        self.assertFalse(self.generated().exists())

    def test_missing_catalog_client(self):
        del self.catalog['clients']['codex']; self.save()
        self.assertIn('no client catalog', self.call(status=2))

    def test_unsupported_native_format(self):
        self.catalog['clients']['codex']['format'] = 'unknown'; self.save()
        self.assertIn('UNSUPPORTED native format', self.call('--apply', status=2))

    def test_hermes_check_only_manual(self):
        self.assertIn('MANUAL/UNSUPPORTED', self.call(client='hermes', status=2))
        before = self.snapshot()
        self.assertIn('UNSUPPORTED Hermes apply', self.call('--apply', client='hermes', status=2))
        self.assertEqual(before, self.snapshot())

    def test_duplicate_unknown_schema_and_yaml(self):
        for raw in ('{"version":1,"version":1,"roles":{}}',
                    '{"version":1,"roles":{},"coordinator":{}}',
                    '{"version":1,"roles":{"unknown":{}}}',
                    'version: 1\nroles: {}\n', '!!python/object:bad {}',
                    '{"version":true,"roles":{}}', '{"version":1,"roles":{},"constraints":{"models":[]}}'):
            with self.subTest(raw=raw):
                (self.root / '.agents/models.local.yaml').write_text(raw)
                self.call('--apply', status=2)
        self.assertFalse(self.generated().exists())

    def test_credentials_and_control_characters_redacted(self):
        for secret in ('sk-test-confidential-value', 'ghp_confidential', 'https://' + 'user:password' + '@host',
                       'model\nname', '../escape', 'model;command'):
            self.config['roles']['implementation']['model'] = secret; self.save()
            result = self.call('--apply', status=2)
            self.assertNotIn(secret, result)
            self.assertIn('redacted', result)
        (self.root / '.agents/models.local.yaml').write_text('{"version":1,"roles":{},"private-secret-value":"very-private"}')
        result = self.call(status=2)
        self.assertNotIn('very-private', result)
        self.assertNotIn('private-secret-value', result)

    def test_catalog_duplicate_and_unknown_keys(self):
        self.catalog['clients']['codex']['models'].append(copy.deepcopy(self.catalog['clients']['codex']['models'][0]))
        self.save(); self.assertIn('duplicate catalog model', self.call(status=2))
        self.catalog['api_key'] = 'never-print-me'; self.save()
        self.assertNotIn('never-print-me', self.call(status=2))

    def test_unowned_config_preserved_without_content_leak(self):
        path = self.root / '.opencode/opencode.json'
        path.write_text('{"credential":"private-content"}')
        before = self.snapshot()
        out = self.call('--apply', client='opencode', status=2)
        self.assertIn('CONFLICT unowned', out); self.assertNotIn('private-content', out)
        self.assertEqual(before, self.snapshot())

    def test_user_edit_conflict(self):
        self.call('--apply'); self.generated().write_text('private-user-change')
        before = self.snapshot()
        self.assertIn('CONFLICT prior', self.call('--apply', status=2))
        self.assertEqual(before, self.snapshot())

    def test_source_prompt_edit_conflict(self):
        self.call('--apply')
        path = self.root / '.agents/roles/implementation.md'; path.write_text(path.read_text() + '\nChanged\n')
        self.assertIn('CONFLICT canonical source', self.call('--apply', status=2))

    def test_stale_alias_refuses_instead_of_silent_old_choice(self):
        self.call('--apply'); self.config['roles'] = {}; self.save()
        before = self.snapshot()
        self.assertIn('STALE_OUTPUT', self.call('--apply', status=2))
        self.assertEqual(before, self.snapshot())

    def test_opencode_markdown_override_conflict(self):
        path = self.root / '.opencode/agents/implementation.md'
        path.write_text(path.read_text().replace('---\n', '---\nmodel: provider-a/other\n', 1))
        self.assertIn('markdown model', self.call('--apply', client='opencode', status=2))

    def test_claude_complex_frontmatter_unsupported(self):
        path = self.root / '.claude/agents/implementation.md'
        path.write_text(path.read_text().replace('tools: Read, Glob, Grep, Bash, Edit, Write', 'tools:\n  - Read'))
        self.assertIn('UNSUPPORTED complex', self.call('--apply', client='claude', status=2))

    def test_missing_canonical_role(self):
        (self.root / '.agents/roles/implementation.md').unlink()
        self.call('--apply', status=2)
        self.assertFalse(self.generated().exists())

    def test_symlink_output_directory_escape(self):
        outside = Path(self.tmp.name).resolve() / 'outside'; outside.mkdir()
        (self.root / '.codex').symlink_to(outside, target_is_directory=True)
        self.assertIn('symlink', self.call('--apply', status=2))
        self.assertEqual(list(outside.iterdir()), [])

    def test_symlink_config(self):
        outside = Path(self.tmp.name).resolve() / 'config'; outside.write_text(json.dumps(self.config))
        path = self.root / '.agents/models.local.yaml'; path.unlink(); path.symlink_to(outside)
        self.assertIn('symlink', self.call('--apply', status=2))

    def test_symlink_output_file(self):
        folder = self.root / '.codex/agents'; folder.mkdir(parents=True)
        outside = Path(self.tmp.name).resolve() / 'outside'; outside.write_text('preserve')
        self.generated().symlink_to(outside)
        self.assertIn('symlink', self.call('--apply', status=2))
        self.assertEqual(outside.read_text(), 'preserve')

    def test_tracked_and_unignored_output_refusal(self):
        self.generated().parent.mkdir(parents=True)
        self.generated().write_text('existing')
        self.git('add', '-f', str(self.generated()))
        self.assertIn('tracked destination', self.call('--apply', status=2))
        self.git('rm', '--cached', str(self.generated()))
        self.generated().unlink()
        (self.root / '.gitignore').write_text('')
        self.assertIn('must be Git ignored', self.call('--apply', status=2))

    def test_all_destinations_preflight(self):
        self.config['roles']['infrastructure'] = CHOICE.copy(); self.save()
        path = self.generated(role='infrastructure'); path.parent.mkdir(parents=True); path.write_text('unowned')
        before = self.snapshot()
        self.call('--apply', status=2)
        self.assertEqual(before, self.snapshot())
        self.assertFalse(self.generated().exists())

    def test_transaction_rollback_on_write_failure(self):
        self.config['roles']['infrastructure'] = CHOICE.copy(); self.save()
        outputs = MODULE['render'](self.root, 'codex', self.config['roles'], {})
        before = self.snapshot(); original = MODULE['atomic_file']; calls = []
        def fail_second(*args):
            calls.append(args[0])
            if len(calls) == 2:
                raise OSError('synthetic write failure')
            return original(*args)
        with patch.dict(MODULE['activate'].__globals__, atomic_file=fail_second):
            with self.assertRaises(OSError):
                MODULE['activate'](self.root, outputs)
        self.assertEqual(before, self.snapshot())
        self.assertFalse((self.root / '.codex').exists())

    def test_rollback_preserves_existing_content_and_mode(self):
        self.call('--apply')
        before = self.snapshot()
        outputs = {'.codex/agents/models-local-implementation.toml': b'changed',
                   '.codex/agents/models-local-functional.toml': b'new'}
        original = MODULE['atomic_file']; calls = []
        def fail_second(*args):
            calls.append(args[0])
            if len(calls) == 2:
                raise OSError('synthetic')
            return original(*args)
        with patch.dict(MODULE['activate'].__globals__, atomic_file=fail_second):
            with self.assertRaises(OSError):
                MODULE['activate'](self.root, outputs)
        # Restored bytes/mode; an actual rollback can change mtime of restored files.
        after = self.snapshot()
        self.assertEqual({k: (v[0], v[2]) for k, v in before.items()},
                         {k: (v[0], v[2]) for k, v in after.items()})

    def test_external_explicit_selector_for_worktrees(self):
        external = Path(self.tmp.name).resolve() / 'preferences.yaml'; external.write_text(json.dumps(self.config))
        (self.root / '.agents/models.local.yaml').unlink()
        self.call('--apply', '--config', str(external))
        self.assertTrue(self.generated().exists())

    def test_global_client_profile_root_refused_with_decoy_home(self):
        # Mock Path.home, never operate in any real client profile.
        decoy_home = self.root.parent
        for relative in ('.codex', '.claude', '.hermes', '.opencode', '.config/opencode'):
            profile = decoy_home / relative
            profile.mkdir(parents=True, exist_ok=True)
            subprocess.run(['git', 'init', '-q', str(profile)], check=True)
            with patch.object(Path, 'home', return_value=decoy_home):
                with self.assertRaises(MODULE['Refusal']):
                    MODULE['root_path'](str(profile))

    def test_non_git_and_nested_root_refused(self):
        external = Path(self.tmp.name).resolve() / 'not-git'; external.mkdir()
        result = subprocess.run([sys.executable, str(SCRIPT), '--root', str(external)], capture_output=True, text=True)
        self.assertEqual(result.returncode, 2)
        self.assertIn('Git repository root', self.call('--root', str(self.root / '.agents'), status=2))

    def test_default_does_not_guess_external_preferences(self):
        external = Path(self.tmp.name).resolve() / 'models.local.yaml'; external.write_text(json.dumps(self.config))
        (self.root / '.agents/models.local.yaml').unlink()
        self.call('--apply', status=2)
        self.assertFalse(self.generated().exists())

    def test_alias_name_collision_in_other_native_file(self):
        for client, filename, text in (
                ('codex', 'unrelated.toml', 'name = "models-local-implementation"\n'),
                ('claude', 'unrelated.md', '---\nname: models-local-implementation\ndescription: Existing agent\n---\nPrivate body\n')):
            with self.subTest(client=client):
                folder = self.root / f'.{client}/agents'; folder.mkdir(parents=True, exist_ok=True)
                (folder / filename).write_text(text)
                before = self.snapshot()
                out = self.call('--apply', client=client, status=2)
                self.assertIn('CONFLICT native alias', out)
                self.assertNotIn('Private body', out)
                self.assertEqual(before, self.snapshot())

    def test_unsupported_native_name_is_conservative(self):
        folder = self.root / '.codex/agents'; folder.mkdir(parents=True)
        (folder / 'unrelated.toml').write_text('name = """complex\nname"""\n')
        self.assertIn('UNSUPPORTED complex native', self.call('--apply', status=2))

    def test_empty_preferences_do_not_create_manifest(self):
        self.config['roles'] = {}; self.save()
        before = self.snapshot(); self.call('--apply')
        self.assertEqual(before, self.snapshot())
        self.assertFalse((self.root / MODULE['MANIFEST']).exists())

    def test_coordinator_and_tracked_sources_untouched(self):
        (self.root / '.codex').mkdir()
        config = self.root / '.codex/config.toml'; config.write_text('model = "coordinator-choice"\n')
        before = {str(path): path.read_bytes() for path in self.root.rglob('*.md')}
        self.call('--apply')
        self.assertEqual(config.read_text(), 'model = "coordinator-choice"\n')
        self.assertEqual(before, {str(path): path.read_bytes() for path in self.root.rglob('*.md')})


if __name__ == '__main__':
    unittest.main()
