#!/usr/bin/env python3
"""Deterministic usage accounting fixtures; no real conversations or model calls."""
import csv
import json
import os
from pathlib import Path
import runpy
import subprocess
import sys
import tempfile
import unittest

ROOT = Path(__file__).resolve().parents[1]
API = runpy.run_path(str(ROOT / 'scripts/report-agent-usage'))
SESSION = '11111111-1111-1111-1111-111111111111'
CHILD = '22222222-2222-2222-2222-222222222222'
TURN = '33333333-3333-3333-3333-333333333333'
OTHER = '44444444-4444-4444-4444-444444444444'


def usage(response='r1', thread=SESSION, root_turn=TURN, values=None, session=SESSION):
    return {'type': 'token_usage_record', 'payload': {
        'session_id': session, 'thread_id': thread, 'root_turn_id': root_turn,
        'turn_id': root_turn, 'response_id': response,
        'usage': values if values is not None else {
            'input_tokens': 100, 'cached_input_tokens': 80, 'output_tokens': 10},
        'thread_token_usage': {'input_tokens': 999999}}}


class UsageTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name)
        self.logs = self.root / 'logs'
        self.logs.mkdir()

    def write(self, name, records):
        (self.logs / name).write_text(''.join(json.dumps(r) + '\n' for r in records))

    def collect(self, turn=None):
        return API['collect'](self.logs, SESSION, turn)

    def test_deduplicate_inherited_records_and_ignore_cumulative_events(self):
        one = usage()
        self.write('a.jsonl', [one, usage('r2'), {'type': 'event_msg', 'payload': {
            'type': 'token_count', 'info': {'total_token_usage': {'input_tokens': 999999}}}}])
        self.write('fork.jsonl', [one])
        rows, _ = self.collect()
        self.assertEqual(len(rows), 1)
        self.assertEqual((rows[0]['requests'], rows[0]['input_tokens'], rows[0]['cached_input_tokens']),
                         (2, 200, 160))

    def test_subagent_attribution_and_turn_filter(self):
        self.write('a.jsonl', [
            {'type': 'session_meta', 'payload': {'id': CHILD, 'agent_path': '/root/qa'}},
            {'type': 'turn_context', 'payload': {'turn_id': TURN, 'model': 'fixture-model'}},
            usage(thread=CHILD), usage(), usage('r2', root_turn=OTHER),
            usage('foreign', session=OTHER)])
        rows, _ = self.collect(TURN)
        self.assertEqual({r['agent'] for r in rows}, {'/root', '/root/qa'})
        self.assertTrue(all(r['model'] == 'fixture-model' for r in rows))
        self.assertEqual(sum(r['requests'] for r in rows), 2)

    def test_conflicting_duplicate_fails(self):
        self.write('a.jsonl', [usage(), usage(values={'input_tokens': 101})])
        with self.assertRaises(API['ReportError']):
            self.collect()

    def test_invalid_counters_fail(self):
        for values in ({'input_tokens': -1}, {'output_tokens': True},
                       {'input_tokens': 1, 'cached_input_tokens': 2}):
            with self.subTest(values=values):
                self.write('a.jsonl', [usage(values=values)])
                with self.assertRaises(API['ReportError']):
                    self.collect()

    def test_missing_counts_are_not_zero(self):
        self.write('a.jsonl', [usage(), usage('r2', values={'input_tokens': 3})])
        rows, warnings = self.collect()
        self.assertIsNone(rows[0]['output_tokens'])
        self.assertIsNone(rows[0]['cached_input_tokens'])
        self.assertTrue(any('not zero' in warning for warning in warnings))

    def test_malformed_tail_warns(self):
        self.write('a.jsonl', [usage()])
        with (self.logs / 'a.jsonl').open('a') as stream:
            stream.write('{unfinished')
        _, warnings = self.collect()
        self.assertTrue(any('Malformed' in warning for warning in warnings))

    def test_unsupported_or_absent_data_fails(self):
        for records in ([], [{'type': 'event_msg', 'payload': {'type': 'token_count'}}]):
            self.write('a.jsonl', records)
            with self.assertRaises(API['ReportError']):
                self.collect()

    def test_output_is_private_unique_and_contains_no_prompt(self):
        self.write('a.jsonl', [usage(), {'type': 'response_item', 'payload': {'text': 'PRIVATE_PROMPT'}}])
        rows, warnings = self.collect()
        output = self.root / 'reports'
        a = API['write_report'](rows, warnings, output, SESSION, '=formula\n|label')
        b = API['write_report'](rows, warnings, output, SESSION, 'second')
        self.assertNotEqual(a, b)
        md = (a / 'usage.md').read_text()
        self.assertNotIn('PRIVATE_PROMPT', md)
        self.assertIn('not money', md)
        with (a / 'usage.csv').open() as stream:
            row = next(csv.DictReader(stream))
        self.assertEqual(row['input_tokens'], '100')
        self.assertEqual(row['cached_input_tokens'], '80')
        if os.name == 'posix':
            self.assertEqual(a.stat().st_mode & 0o777, 0o700)
            self.assertEqual((a / 'usage.md').stat().st_mode & 0o777, 0o600)
        self.assertTrue(API['safe']('=SUM(1,2)').startswith("'"))

    def test_cli_success_and_bad_selection(self):
        self.write('a.jsonl', [usage()])
        command = [sys.executable, str(ROOT / 'scripts/report-agent-usage'),
                   '--session', SESSION, '--sessions-dir', str(self.logs),
                   '--output-dir', str(self.root / 'output')]
        result = subprocess.run(command, capture_output=True, text=True)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn('Markdown:', result.stdout)
        failed = subprocess.run(command + ['--turn', OTHER], capture_output=True, text=True)
        self.assertNotEqual(failed.returncode, 0)
        self.assertIn('No supported', failed.stderr)
        failed = subprocess.run(command + ['--session', '../escape'], capture_output=True)
        self.assertNotEqual(failed.returncode, 0)


if __name__ == '__main__':
    unittest.main()
