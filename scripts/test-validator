 def test_usage_structure(self):
  for name in ('scripts/report-agent-usage','scripts/auto-agent-usage','scripts/test-agent-usage',
               'scripts/test-auto-agent-usage','.codex/hooks.json','docs/USAGE_REPORTS.md'):
   with self.subTest(name=name):
    p=self.root/name; old=p.read_bytes()
    try:
     p.unlink(); self.assertRule('structure')
    finally: p.write_bytes(old)
 def test_usage_hook_scope(self):
  import json
  p=self.root/'.codex/hooks.json'; original=p.read_text()
  for mutation in ('event','command','timeout','extra'):
   with self.subTest(mutation=mutation):
    config=json.loads(original); hooks=config['hooks']
    if mutation=='event': hooks['PreToolUse']=hooks.pop('Stop')
    if mutation=='command': hooks['Stop'][0]['hooks'][0]['command']='echo skip'
    if mutation=='timeout': hooks['Stop'][0]['hooks'][0]['timeout']=600
    if mutation=='extra': hooks['Stop'][0]['hooks'][0]['async']=True
    try:
     p.write_text(json.dumps(config)); self.assertRule('usage-hooks')
    finally: p.write_text(original)
 def test_legitimate_project(self):
  self.neutralize_readme_headings()
  self.change('specs/guidelines/architecture.md','# Architecture','# Architecture\nApproved for this project: Rust and SQLite.')
  self.append('README.md','\n[Folder](templates) [External](https://example.com)\nUNDECIDED api_key: YOUR_KEY\n')
  self.assertEqual(validate(self.root),[])
 def test_cli_exit_status(self):
  command=[sys.executable,str(ROOT/'scripts/validate-template'),str(self.root)]
  self.assertEqual(subprocess.run(command,capture_output=True).returncode,0)
  (self.root/'README.md').unlink()
  self.assertEqual(subprocess.run(command,capture_output=True).returncode,1)
 def test_nonvisual(self):
  (self.root/'specs/guidelines/ui.md').write_text('# UI\nNot applicable: CLI project.\n'); self.assertEqual(validate(self.root),[])
class LifecycleBehaviorTests(unittest.TestCase):
 """Reference invariants for the documented post-merge cleanup sequence.

  Every fixture is an isolated temporary repository or directory. These tests never
  create, inspect or remove a real user worktree, branch or handoff. The Git cases
  exercise the documented safe commands for real; the PR-state and restoration cases
  encode the documented decision table because this project has no executable merge
  or handoff gate, so they are documentary evidence, not enforcement.
  """
 def setUp(self):
  temp=tempfile.TemporaryDirectory(); self.addCleanup(temp.cleanup)
  self.tmp=Path(temp.name)
 def git(self,root,*args,check=True):
  return subprocess.run(['git','-c','user.name=Test','-c','user.email=test@example.invalid',
    '-c','commit.gpgsign=false','-c','init.defaultBranch=main','-C',str(root),*args],
    check=check,capture_output=True,text=True)
 def repository(self):
  root=self.tmp/'repo'; root.mkdir()
  self.git(root,'init','-q'); (root/'README.md').write_text('# base\n')
  self.git(root,'add','-A'); self.git(root,'commit','-qm','base')
  self.default_branch=self.git(root,'symbolic-ref','--short','HEAD').stdout.strip()
  return root
 def add_worktree(self,root,branch,name):
  path=self.tmp/name
  self.git(root,'worktree','add','-q','-b',branch,str(path))
  return path
 def cleanup_verdict(self,pr='MERGED',confirmed=True,owned=True,clean=True,integrated=True):
  # Documentary transcription of approvals.md; not wired to a real PR gate.
  if pr!='MERGED' or not confirmed: return 'preserve'
  return 'remove' if owned and clean and integrated else 'preserve'
 def restoration_verdict(self,root,consolidated,discrepancy=False):
  # Documentary transcription of the handoff retirement rules.
  handoff=root/'specs/session-handoff.md'
  durable=[p for p in (root/'specs').glob('*.md') if p.name!='session-handoff.md']
  if not handoff.exists(): return 'normal'
  return 'remove' if consolidated and durable and not discrepancy else 'preserve'
 def test_clean_merged_worktree_and_branch_can_be_removed(self):
  root=self.repository(); worktree=self.add_worktree(root,'feature-merged','wt-merged')
  (worktree/'feature.txt').write_text('feature\n')
  self.git(worktree,'add','-A'); self.git(worktree,'commit','-qm','feature')
  self.git(root,'merge','--no-ff','feature-merged','-qm','merge feature')
  self.assertEqual(self.git(root,'worktree','remove',str(worktree),check=False).returncode,0)
  self.assertFalse(worktree.exists())
  self.assertEqual(self.git(root,'branch','-d','feature-merged',check=False).returncode,0)
  self.assertNotIn('feature-merged',self.git(root,'branch','--list').stdout)
 def test_dirty_worktree_is_preserved(self):
  root=self.repository(); worktree=self.add_worktree(root,'feature-dirty','wt-dirty')
  (worktree/'pending.txt').write_text('pending\n')
  self.assertNotEqual(self.git(root,'worktree','remove',str(worktree),check=False).returncode,0)
  self.assertTrue(worktree.exists())
  (worktree/'pending.txt').unlink()
  (worktree/'README.md').write_text('# base\nstaged\n')
  self.git(worktree,'add','-A')
  self.assertNotEqual(self.git(root,'worktree','remove',str(worktree),check=False).returncode,0)
  self.assertTrue(worktree.exists())
 def test_unmerged_or_unknown_branch_is_preserved(self):
  root=self.repository(); self.git(root,'branch','feature-unmerged')
  self.git(root,'checkout','-q','feature-unmerged')
  (root/'later.txt').write_text('later\n')
  self.git(root,'add','-A'); self.git(root,'commit','-qm','unmerged')
  self.git(root,'checkout','-q',self.default_branch)
  self.assertNotEqual(self.git(root,'branch','-d','feature-unmerged',check=False).returncode,0)
  self.assertIn('feature-unmerged',self.git(root,'branch','--list').stdout)
 def test_other_task_resources_are_preserved(self):
  root=self.repository(); first=self.add_worktree(root,'feature-one','wt-one')
  second=self.add_worktree(root,'feature-two','wt-two')
  self.assertEqual(self.git(root,'worktree','remove',str(first),check=False).returncode,0)
  self.assertFalse(first.exists()); self.assertTrue(second.exists())
  self.assertEqual(self.git(root,'branch','-d','feature-one',check=False).returncode,0)
  self.assertIn('feature-two',self.git(root,'branch','--list').stdout)
 def test_open_or_unconfirmed_pr_blocks_cleanup(self):
  self.assertEqual(self.cleanup_verdict(),'remove')
  for kwargs in ({'pr':'OPEN'},{'pr':'UNCONFIRMED'},{'confirmed':False},{'owned':False},
                 {'clean':False},{'integrated':False}):
   with self.subTest(condition=kwargs):
    self.assertEqual(self.cleanup_verdict(**kwargs),'preserve')
 def test_untracked_handoff_is_removable_after_consolidation(self):
  root=self.repository(); (root/'specs').mkdir()
  handoff=root/'specs/session-handoff.md'; handoff.write_text('STOP REQUESTED\n')
  (root/'specs/progress.md').write_text('durable state\n')
  self.assertEqual(self.restoration_verdict(root,consolidated=True),'remove')
  handoff.unlink()
  self.assertFalse(handoff.exists()); self.assertTrue((root/'specs/progress.md').exists())
 def test_incomplete_restoration_or_discrepancy_preserves_handoff(self):
  root=self.repository(); (root/'specs').mkdir()
  handoff=root/'specs/session-handoff.md'; handoff.write_text('STOP REQUESTED\n')
  self.assertEqual(self.restoration_verdict(root,consolidated=True),'preserve')
  (root/'specs/progress.md').write_text('durable state\n')
  self.assertEqual(self.restoration_verdict(root,consolidated=False),'preserve')
  self.assertEqual(self.restoration_verdict(root,consolidated=True,discrepancy=True),'preserve')
  self.assertTrue(handoff.exists())
 def test_no_temporary_handoff_is_normal(self):
  root=self.repository(); (root/'specs').mkdir()
  (root/'specs/progress.md').write_text('durable state\n')
  self.assertEqual(self.restoration_verdict(root,consolidated=True),'normal')
 def test_tracked_handoff_removal_is_a_normal_task_change(self):
  root=self.repository(); (root/'specs').mkdir()
  handoff=root/'specs/session-handoff.md'; handoff.write_text('temporary\n')
  self.git(root,'add','-A'); self.git(root,'commit','-qm','add handoff')
  self.git(root,'rm','-q','specs/session-handoff.md')
  self.assertIn('D  specs/session-handoff.md',self.git(root,'status','--short').stdout)
if __name__=='__main__': unittest.main(verbosity=2)
