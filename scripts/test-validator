#!/usr/bin/env python3
"""Positive and isolated negative fixtures for every validation category."""
from pathlib import Path
import json
import runpy
import shutil
import subprocess
import sys
import tempfile
import unittest
ROOT=Path(__file__).resolve().parents[1]
validate=runpy.run_path(str(ROOT/'scripts/validate-template'))['validate']
class ValidationTests(unittest.TestCase):
 def setUp(self):
  temp=tempfile.TemporaryDirectory(); self.addCleanup(temp.cleanup)
  self.root=Path(temp.name)/'fixture'
  shutil.copytree(ROOT,self.root,ignore=shutil.ignore_patterns('.git','__pycache__','artifacts','node_modules','dist','.local','test-results','playwright-report'))
 def change(self,name,old,new):
  p=self.root/name; text=p.read_text()
  self.assertIn(old,text,f'{name}: fixture anchor not found: {old!r}')
  p.write_text(text.replace(old,new))
 def append(self,name,text):
  p=self.root/name; p.write_text(p.read_text()+text)
 def neutralize_readme_headings(self):
  # README titles are presentation, not part of the validator contract. Rename
  # headings before injecting a rule-specific defect so fixtures cannot drift with
  # documentation wording.
  p=self.root/'README.md'; lines=[]
  for line in p.read_text().splitlines():
   if line.startswith('#'):
    line=line.replace('Skills','Capacidades').replace('Universal','Plantilla base')
   lines.append(line)
  p.write_text('\n'.join(lines)+'\n')
 def assertRule(self,rule): self.assertTrue(any(e.startswith(rule+':') for e in validate(self.root)),rule)
 def test_valid(self): self.assertEqual(validate(self.root),[])
 def test_change_requires_original_text(self):
  with self.assertRaisesRegex(AssertionError,'fixture anchor not found'):
   self.change('README.md','text absent from this README','replacement')
 def test_structure(self):
  (self.root/'specs/project-rules.md').unlink(); self.assertRule('structure')
 def test_links(self):
  self.neutralize_readme_headings()
  self.append('README.md','\n[Broken](missing.md)\n'); self.assertRule('links')
 def test_fragment_anchor(self):
  self.change('specs/README.md','methodology/ci-policy.md#myfinanzas--local-first-vigente-2026-10-27','methodology/ci-policy.md#missing-anchor'); self.assertRule('fragments')
 def test_orchestrator_only_is_required(self):
  self.change('AGENTS.md','The user talks only to the orchestrator','Anyone may talk to any role'); self.assertRule('orchestrator-only')
 def test_agents(self):
  self.change('AGENTS.md','(specs/guidelines/ui.md)','(README.md)'); self.assertRule('agents')
 def test_agents_requires_project_rules(self):
  self.change('AGENTS.md','(specs/project-rules.md)','(README.md)'); self.assertRule('agents')
 def test_thin_agents(self):
  self.change('AGENTS.md','# Agent','# Agent'+'\n'*70); self.assertRule('agents')
 def external_config(self): return json.loads((self.root/'.agents/harnesses/claude.json').read_text())
 def write_external_config(self,cfg): (self.root/'.agents/harnesses/claude.json').write_text(json.dumps(cfg))
 def test_external_agents_file_is_required(self):
  (self.root/'.agents/harnesses/claude.json').unlink(); self.assertRule('structure')
 def test_external_agents_rejects_invalid_values(self):
  def broken(mutate):
   cfg=self.external_config(); mutate(cfg); self.write_external_config(cfg); self.assertRule('harness-config')
  broken(lambda c: c.update(version=1))
  broken(lambda c: c['external']['codex'].update(transport='mcp'))
  broken(lambda c: c['external']['codex']['tasks'].update(investigate='automatic'))
  broken(lambda c: c['external']['codex']['tasks'].update(develop='automatic'))
  broken(lambda c: c['external']['codex']['tasks'].update(review='sometimes'))
  broken(lambda c: c['external']['codex']['tasks'].update(refactor='on_request'))
  broken(lambda c: c['external']['codex'].update(model=''))
  broken(lambda c: c['external']['codex'].update(provider='openai'))
  (self.root/'.agents/harnesses/claude.json').write_text('{not json'); self.assertRule('harness-config')
 def test_external_agents_has_no_closed_client_list(self):
  cfg=self.external_config(); cfg['external']['newclient']={'enabled':False,'transport':'cli','model':None,'effort':None,'tasks':{'review':'on_request'}}
  self.write_external_config(cfg); self.assertEqual(validate(self.root),[])
 def test_shipped_defaults_keep_the_automatic_codex_review(self):
  cfg=json.loads((ROOT/'.agents/harnesses/claude.json').read_text()); codex=cfg['external']['codex']
  self.assertTrue(codex['enabled']); self.assertEqual(codex['tasks']['review'],'automatic')
  self.assertEqual(codex['model'],'gpt-6.2-sol'); self.assertEqual(codex['effort'],'low')
  self.assertEqual(cfg['external']['opencode']['model'],'alibaba-token-plan/deepseek-v4.1-flash-1017#high')
  for agent in ('codex','opencode'): self.assertEqual(cfg['external'][agent]['tasks']['develop'],'on_request'); self.assertEqual(cfg['external'][agent]['tasks']['investigate'],'on_request')
  self.assertEqual(cfg['external']['opencode']['tasks']['review'],'on_request')
 def test_v2_harness_rejects_legacy_and_checks_all_files(self):
  legacy=self.root/'.agents/external-agents.json'
  legacy.write_text('{}')
  self.assertRule('harness-config')
  legacy.unlink()
  other=self.root/'.agents/harnesses/codex.json'
  other.write_text(json.dumps(self.external_config()))
  self.assertRule('harness-config')  # Claude's standing permission cannot travel.
  other.write_text('{"version":2}')
  self.assertEqual(validate(self.root),[])
  other.rename(other.with_name('unknown.json'))
  self.assertRule('harness-config')
 def test_antigravity_harness_is_valid(self):
  cfg=json.loads((ROOT/'.agents/harnesses/antigravity.json').read_text())
  self.assertEqual(cfg['version'],2)
  self.assertEqual(cfg['local']['model'],'hydrogen')
  self.assertEqual(cfg['local']['effort'],'medium')
  self.assertEqual(set(cfg['local']['profiles'].keys()),{'functional','implementation','qa-review','infrastructure'})
  self.assertEqual(cfg['external'],{})
  self.assertEqual(validate(self.root),[])
 def test_v2_harness_checks_native_profiles_and_duplicate_keys(self):
  cfg=self.external_config()
  profiles={
   'functional': {'standard': {'effort':'low'}, 'complex': {'effort':'high'}},
   'implementation': {'standard': {'effort':'low'}, 'complex': {'model':None,'effort':'high'}},
   'qa-review': {'standard': {'model':'review-model'}, 'complex': {'effort':'high'}},
   'infrastructure': {'standard': {'effort':'low'}, 'complex': {'effort':'high'}},
  }
  cfg['local']={'model':'example','profiles':profiles}
  self.write_external_config(cfg)
  self.assertEqual(validate(self.root),[])
  del profiles['functional']
  del profiles['qa-review']['complex']
  self.write_external_config(cfg)
  self.assertEqual(validate(self.root),[])
  for role, level, profile in (
    ('review', 'standard', {'effort':'low'}),
    ('qa-review', 'urgent', {'effort':'high'}),
    ('implementation', 'complex', {'model':None,'effort':None}),
    ('infrastructure', 'standard', {}),
  ):
   with self.subTest(role=role, level=level):
    invalid={**cfg,'local':{**cfg['local'],'profiles':{role:{level:profile}}}}
    self.write_external_config(invalid)
    self.assertRule('harness-config')
  for raw in ('{"version":2,"version":2}', 'null', '{"version":2.0}'):
   with self.subTest(raw=raw):
    (self.root/'.agents/harnesses/claude.json').write_text(raw)
    self.assertRule('harness-config')
 def host_config(self): return json.loads((self.root/'.agents/harnesses/t3.json').read_text())
 def write_host_config(self,cfg,name='t3.json'): (self.root/'.agents/harnesses'/name).write_text(json.dumps(cfg))
 def test_t3_host_harness_is_valid(self):
  cfg=json.loads((ROOT/'.agents/harnesses/t3.json').read_text())
  self.assertEqual(cfg['version'],2)
  self.assertEqual(cfg['local']['provider'],'antigravity')
  self.assertEqual(cfg['local']['model'],'gemini-4-hydrogen')
  self.assertEqual(cfg['local']['effort'],'medium')
  self.assertEqual(cfg['local']['profiles'],{
   'qa-review':{'provider':'opencode','model':'alibaba-token-plan/glm-5.3','effort':'low'},
   'review':{'provider':'codex','model':'gpt-6.1-terra','effort':'low'},
  })
  self.assertEqual(validate(self.root),[])
 def test_t3_host_harness_accepts_tiered_and_single_profiles_and_local_override(self):
  cfg=self.host_config()
  cfg['local']['profiles']['implementation']={
   'standard':{'provider':'codex','model':'gpt-6.1-terra','effort':'low'},
   'complex':{'provider':'codex','model':'gpt-6.2-sol','effort':'high'},
  }
  self.write_host_config(cfg,'t3.local.json')
  self.assertEqual(validate(self.root),[])
 def test_t3_host_harness_rejects_invalid_configs(self):
  def broken(mutate):
   cfg=self.host_config(); mutate(cfg); self.write_host_config(cfg); self.assertRule('harness-config')
  broken(lambda c: c.update(version=1))
  broken(lambda c: c.update(version='2'))
  broken(lambda c: c.update(external={}))
  broken(lambda c: c['local'].update(extra=True))
  broken(lambda c: c['local'].pop('provider'))
  broken(lambda c: c['local'].pop('model'))
  broken(lambda c: c['local'].update(effort=123))
  broken(lambda c: c['local'].update(effort=''))
  broken(lambda c: c['local']['profiles']['qa-review'].pop('provider'))
  broken(lambda c: c['local']['profiles']['qa-review'].pop('model'))
  broken(lambda c: c['local']['profiles']['qa-review'].update(effort=False))
  broken(lambda c: c['local']['profiles'].update(unknown={'provider':'codex','model':'gpt-6.1-terra'}))
  broken(lambda c: c['local']['profiles'].update(review={'standard':{'provider':'codex','model':'gpt-6.1-terra','effort':'low'}}))
  broken(lambda c: c['local']['profiles']['review'].update(extra='x'))
  for raw in ('{"version":2,"version":2}', '{"version":NaN}'):
   with self.subTest(raw=raw):
    (self.root/'.agents/harnesses/t3.json').write_text(raw)
    self.assertRule('harness-config')
 def test_prompt(self):
  self.change('NEW_PROJECT_PROMPT.md','[PROJECT_NAME]','Name'); self.assertRule('prompt')
 def test_secrets(self):
  self.neutralize_readme_headings()
  self.append('README.md','\n'+'gh'+'p_'+'a'*36+'\n'); self.assertRule('secrets')
 # Every credential shape stays detectable: the shared literal prefilter must not
 # let a rule go silent. Values are assembled from fragments so this file never
 # contains a complete token.
 def secret_shape(self,value):
  self.neutralize_readme_headings()
  self.append('README.md','\n'+value+'\n'); self.assertRule('secrets')
 def test_secret_private_key(self): self.secret_shape('-----BEGIN '+'RSA PRIVATE KEY-----')
 def test_secret_github_pat(self): self.secret_shape('github'+'_pat_'+'a'*36)
 def test_secret_github_pat_isolated_document(self):
  # El README del template ya contiene 'gh', así que un documento aislado es el que
  # prueba de verdad el literal del prefiltro, no solo el patrón.
  self.neutralize_readme_headings()
  (self.root/'specs'/'pat-only.md').write_text('github'+'_pat_'+'a'*36)
  self.assertRule('secrets')
 def test_secret_aws_key(self): self.secret_shape('AKIA'+'A'*16)
 def test_secret_api_token(self): self.secret_shape('sk-'+'a'*32)
 def test_secret_credential_assignment(self): self.secret_shape('password'+': '+'a'*24)
 def test_token_like_text_without_a_complete_secret_passes(self):
  self.neutralize_readme_headings()
  self.append('README.md','\nshort fragments only: '+'gh'+'p_short and '+'AKI'+'A plus '+'sk-short\n')
  self.assertEqual(validate(self.root),[])
 def test_portability(self):
  self.neutralize_readme_headings()
  self.append('README.md','\n'+'/'+'home/example/project'+'\n'); self.assertRule('portability')
 def test_neutrality(self):
  self.change('AGENTS.md','# Agent','# Agent\nAll projects must use ExampleStack.'); self.assertRule('neutrality')
 def test_coordination_obligations(self):
  # Structural drift guards only, not a claim that real clients followed the rules.
  cases = (
   ('specs/project-rules.md', 'revisión técnica independiente'),
   ('specs/project-rules.md', 'UNRUN'),
   ('specs/project-rules.md', 'invoke_subagent'),
   ('specs/project-rules.md', 'Dev32/PR30'),
   ('specs/methodology/approvals.md', 'Publicación de rama y PR'),
   ('specs/methodology/approvals.md', 'No se necesita otra aprobación de'),
   ('specs/methodology/approvals.md', 'Nunca activar auto-merge'),
   ('specs/methodology/myfinanzas-coordination.md', 'nunca auto-merge'),
  )
  for name,token in cases:
   with self.subTest(name=name,token=token):
    p=self.root/name; original=p.read_text()
    self.assertIn(token,original)
    try:
     p.write_text(original.replace(token,'REMOVED'))
     self.assertRule('coordination')
    finally:
     p.write_text(original)
 def test_fixed_ceiling_reintroduction_rejected(self):
  for name in ('specs/project-rules.md',
               'specs/methodology/myfinanzas-coordination.md'):
   p=self.root/name; original=p.read_text()
   try:
    p.write_text(original+'\nThe maximum permitted combination is `fixed-model` + `low`.\n')
    self.assertRule('resource-policy')
   finally:
    p.write_text(original)
 def test_lifecycle_contract(self):
  cases = (
   ('specs/methodology/approvals.md', '## Limpieza local posterior al merge'),
   ('specs/methodology/approvals.md', 'cierre ordinario'),
   ('specs/methodology/approvals.md', 'la PR está `MERGED`'),
   ('specs/methodology/approvals.md', 'git worktree remove <worktree-de-la-tarea>'),
   ('specs/methodology/approvals.md', 'git branch -d <rama-de-la-tarea>'),
   ('specs/methodology/approvals.md', 'sin `--force`'),
   ('specs/methodology/approvals.md', 'sin `-D`'),
   ('specs/methodology/approvals.md', 'No exigir que cada commit'),
   ('specs/methodology/approvals.md', 'preservar la rama'),
   ('specs/methodology/approvals.md', 'git reset --hard'),
   ('specs/methodology/approvals.md', 'git clean -fd'),
   ('specs/methodology/approvals.md', 'ramas remotas'),
   ('specs/methodology/approvals.md', 'otra tarea'),
   ('specs/README.md', 'se retira tras restaurar y consolidar'),
   ('specs/README.md', 'mismo cambio de la tarea'),
   ('specs/README.md', 'nunca en una PR creada solo para borrarlo'),
  )
  for name,token in cases:
   with self.subTest(name=name,token=token):
    p=self.root/name; original=p.read_text()
    self.assertIn(token,original)
    try:
     p.write_text(original.replace(token,'REMOVED')); self.assertRule('lifecycle')
    finally: p.write_text(original)
 def test_ci(self):
  self.change('.github/workflows/validate.yml','python3 scripts/verify baseline','echo skip'); self.assertRule('ci')
 def test_verification_contract(self):
  for name,token in (('specs/methodology/ci-policy.md','each required suite once'),
                     ('AGENTS.md','--full')):
   with self.subTest(name=name):
    p=self.root/name; old=p.read_text()
    try:
     p.write_text(old.replace(token,'REMOVED')); self.assertRule('verification-entry')
    finally: p.write_text(old)
 def test_legitimate_project(self):
  self.neutralize_readme_headings()
  self.change('specs/guidelines/architecture.md','# Architecture','# Architecture\nApproved for this project: Rust and SQLite.')
  self.append('README.md','\n[Folder](specs) [External](https://example.com)\nUNDECIDED api_key: YOUR_KEY\n')
  self.assertEqual(validate(self.root),[])
 def test_cli_exit_status(self):
  command=[sys.executable,str(ROOT/'scripts/validate-template'),str(self.root)]
  self.assertEqual(subprocess.run(command,capture_output=True).returncode,0)
  (self.root/'README.md').unlink()
  self.assertEqual(subprocess.run(command,capture_output=True).returncode,1)
 def test_nonvisual(self):
  (self.root/'specs/guidelines/ui.md').write_text('# UI\nNot applicable: CLI project.\n'); self.assertEqual(validate(self.root),[])
class LifecycleBehaviorTests(unittest.TestCase):
 """Reference invariants for the documented post-merge cleanup sequence.

  Every fixture is an isolated temporary repository or directory. These tests never
  create, inspect or remove a real user worktree, branch or handoff. The Git cases
  exercise the documented safe commands for real; the PR-state and restoration cases
  encode the documented decision table because this project has no executable merge
  or handoff gate, so they are documentary evidence, not enforcement.
  """
 def setUp(self):
  temp=tempfile.TemporaryDirectory(); self.addCleanup(temp.cleanup)
  self.tmp=Path(temp.name)
 def git(self,root,*args,check=True):
  return subprocess.run(['git','-c','user.name=Test','-c','user.email=test@example.invalid',
    '-c','commit.gpgsign=false','-c','init.defaultBranch=main','-C',str(root),*args],
    check=check,capture_output=True,text=True)
 def repository(self):
  root=self.tmp/'repo'; root.mkdir()
  self.git(root,'init','-q'); (root/'README.md').write_text('# base\n')
  self.git(root,'add','-A'); self.git(root,'commit','-qm','base')
  self.default_branch=self.git(root,'symbolic-ref','--short','HEAD').stdout.strip()
  return root
 def add_worktree(self,root,branch,name):
  path=self.tmp/name
  self.git(root,'worktree','add','-q','-b',branch,str(path))
  return path
 def cleanup_verdict(self,pr='MERGED',confirmed=True,owned=True,clean=True,integrated=True):
  # Documentary transcription of approvals.md; not wired to a real PR gate.
  if pr!='MERGED' or not confirmed: return 'preserve'
  return 'remove' if owned and clean and integrated else 'preserve'
 def restoration_verdict(self,root,consolidated,discrepancy=False):
  # Documentary transcription of the handoff retirement rules.
  handoff=root/'specs/session-handoff.md'
  durable=[p for p in (root/'specs').glob('*.md') if p.name!='session-handoff.md']
  if not handoff.exists(): return 'normal'
  return 'remove' if consolidated and durable and not discrepancy else 'preserve'
 def test_clean_merged_worktree_and_branch_can_be_removed(self):
  root=self.repository(); worktree=self.add_worktree(root,'feature-merged','wt-merged')
  (worktree/'feature.txt').write_text('feature\n')
  self.git(worktree,'add','-A'); self.git(worktree,'commit','-qm','feature')
  self.git(root,'merge','--no-ff','feature-merged','-qm','merge feature')
  self.assertEqual(self.git(root,'worktree','remove',str(worktree),check=False).returncode,0)
  self.assertFalse(worktree.exists())
  self.assertEqual(self.git(root,'branch','-d','feature-merged',check=False).returncode,0)
  self.assertNotIn('feature-merged',self.git(root,'branch','--list').stdout)
 def test_dirty_worktree_is_preserved(self):
  root=self.repository(); worktree=self.add_worktree(root,'feature-dirty','wt-dirty')
  (worktree/'pending.txt').write_text('pending\n')
  self.assertNotEqual(self.git(root,'worktree','remove',str(worktree),check=False).returncode,0)
  self.assertTrue(worktree.exists())
  (worktree/'pending.txt').unlink()
  (worktree/'README.md').write_text('# base\nstaged\n')
  self.git(worktree,'add','-A')
  self.assertNotEqual(self.git(root,'worktree','remove',str(worktree),check=False).returncode,0)
  self.assertTrue(worktree.exists())
 def test_unmerged_or_unknown_branch_is_preserved(self):
  root=self.repository(); self.git(root,'branch','feature-unmerged')
  self.git(root,'checkout','-q','feature-unmerged')
  (root/'later.txt').write_text('later\n')
  self.git(root,'add','-A'); self.git(root,'commit','-qm','unmerged')
  self.git(root,'checkout','-q',self.default_branch)
  self.assertNotEqual(self.git(root,'branch','-d','feature-unmerged',check=False).returncode,0)
  self.assertIn('feature-unmerged',self.git(root,'branch','--list').stdout)
 def test_other_task_resources_are_preserved(self):
  root=self.repository(); first=self.add_worktree(root,'feature-one','wt-one')
  second=self.add_worktree(root,'feature-two','wt-two')
  self.assertEqual(self.git(root,'worktree','remove',str(first),check=False).returncode,0)
  self.assertFalse(first.exists()); self.assertTrue(second.exists())
  self.assertEqual(self.git(root,'branch','-d','feature-one',check=False).returncode,0)
  self.assertIn('feature-two',self.git(root,'branch','--list').stdout)
 def test_open_or_unconfirmed_pr_blocks_cleanup(self):
  self.assertEqual(self.cleanup_verdict(),'remove')
  for kwargs in ({'pr':'OPEN'},{'pr':'UNCONFIRMED'},{'confirmed':False},{'owned':False},
                 {'clean':False},{'integrated':False}):
   with self.subTest(condition=kwargs):
    self.assertEqual(self.cleanup_verdict(**kwargs),'preserve')
 def test_untracked_handoff_is_removable_after_consolidation(self):
  root=self.repository(); (root/'specs').mkdir()
  handoff=root/'specs/session-handoff.md'; handoff.write_text('STOP REQUESTED\n')
  (root/'specs/progress.md').write_text('durable state\n')
  self.assertEqual(self.restoration_verdict(root,consolidated=True),'remove')
  handoff.unlink()
  self.assertFalse(handoff.exists()); self.assertTrue((root/'specs/progress.md').exists())
 def test_incomplete_restoration_or_discrepancy_preserves_handoff(self):
  root=self.repository(); (root/'specs').mkdir()
  handoff=root/'specs/session-handoff.md'; handoff.write_text('STOP REQUESTED\n')
  self.assertEqual(self.restoration_verdict(root,consolidated=True),'preserve')
  (root/'specs/progress.md').write_text('durable state\n')
  self.assertEqual(self.restoration_verdict(root,consolidated=False),'preserve')
  self.assertEqual(self.restoration_verdict(root,consolidated=True,discrepancy=True),'preserve')
  self.assertTrue(handoff.exists())
 def test_no_temporary_handoff_is_normal(self):
  root=self.repository(); (root/'specs').mkdir()
  (root/'specs/progress.md').write_text('durable state\n')
  self.assertEqual(self.restoration_verdict(root,consolidated=True),'normal')
 def test_tracked_handoff_removal_is_a_normal_task_change(self):
  root=self.repository(); (root/'specs').mkdir()
  handoff=root/'specs/session-handoff.md'; handoff.write_text('temporary\n')
  self.git(root,'add','-A'); self.git(root,'commit','-qm','add handoff')
  self.git(root,'rm','-q','specs/session-handoff.md')
  self.assertIn('D  specs/session-handoff.md',self.git(root,'status','--short').stdout)
if __name__=='__main__': unittest.main(verbosity=2)
