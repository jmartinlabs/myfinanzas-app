 def test_lifecycle_contract(self):
  # Documentary token coverage. The merge/PR-state and handoff-retirement gates
  # below have no executable gate in this project: removing the rule text must
  # make structural validation fail, but that proves the contract is present, not
  # that an agent obeyed it. Git-command invariants live in LifecycleBehaviorTests.
  cases = (
   ('specs/methodology/approvals.md', '## Limpieza local posterior al merge'),
   ('specs/methodology/approvals.md', 'cierre ordinario'),
   ('specs/methodology/approvals.md', 'la PR está `MERGED`'),
   ('specs/methodology/approvals.md', 'git worktree remove <worktree-de-la-tarea>'),
   ('specs/methodology/approvals.md', 'git branch -d <rama-de-la-tarea>'),
   ('specs/methodology/approvals.md', 'sin `--force`'),
   ('specs/methodology/approvals.md', 'sin `-D`'),
   ('specs/methodology/approvals.md', 'No exigir que cada commit'),
   ('specs/methodology/approvals.md', 'preservar la rama'),
   ('specs/methodology/approvals.md', 'git reset --hard'),
   ('specs/methodology/approvals.md', 'git clean -fd'),
   ('specs/methodology/approvals.md', 'ramas remotas'),
   ('specs/methodology/approvals.md', 'otra tarea'),
   ('.agents/skills/handoff/SKILL.md', '## Next session and checkpoint retirement'),
   ('.agents/skills/handoff/SKILL.md', 'successful restoration'),
   ('.agents/skills/handoff/SKILL.md', 'tracked by Git'),
   ('.agents/skills/handoff/SKILL.md', 'standalone PR'),
   ('.agents/skills/handoff/SKILL.md', 'never remove permanent'),
   ('specs/README.md', 'se retira tras restaurar y consolidar'),
   ('specs/README.md', 'mismo cambio de la tarea'),
   ('specs/README.md', 'nunca en una PR creada solo para borrarlo'),
   ('.agents/skills/orchestrate/SKILL.md', 'limpieza-local-posterior-al-merge'),
   ('.agents/skills/orchestrate/SKILL.md', 'next-session-and-checkpoint-retirement'),
   ('.agents/skills/orchestrate/SKILL.md', 'Preserve dirty, unknown or other-task resources.'),
  )
  for name,token in cases:
   with self.subTest(name=name,token=token):
    p=self.root/name; original=p.read_text()
    self.assertIn(token,original)
    try:
     p.write_text(original.replace(token,'REMOVED')); self.assertRule('lifecycle')
    finally: p.write_text(original)
