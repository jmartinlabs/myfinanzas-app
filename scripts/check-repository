#!/usr/bin/env python3
"""Review index, tracked working files and reachable commit history; never print values."""
from contextlib import contextmanager
from pathlib import Path
import re
import subprocess
import sys

SENSITIVE = re.compile(
    r'(^|/)(\.env(?:\..*)?|id_rsa|id_ed25519|credentials)(?:$|/)|'
    r'\.(?:xlsx?|csv|ofx|qif|db|sqlite3?|pem|key|p12|pfx)(?:$|-)', re.I)
PATTERNS = (
    ('private-key', rb'-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----'),
    ('github-token', rb'\b(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,})\b'),
    ('aws-key', rb'\bAKIA[A-Z0-9]{16}\b'),
    ('api-token', rb'\bsk-[A-Za-z0-9_-]{32,}\b'),
    ('credential-assignment', rb'(?im)^\s*(?:password|api_key|access_token|secret)\s*[:=]\s*[\x22\x27]?[A-Za-z0-9+/=_-]{20,}'),
    ('url-credentials', rb'https?://[^\s/:]+:[^\s/@]+@'),
)


# A rule can only match when its literal is present. Each literal is a necessary
# condition of the pattern above, so skipping a blob without it cannot hide a
# finding; it only avoids running six regular expressions over every historical
# blob. The match itself stays authoritative, and `test-checks` proves each rule
# still fires on its own fixture.
PREFILTER = {
    'private-key': (b'-----begin ',),
    'github-token': (b'gh', b'github_pat_'),
    'aws-key': (b'akia',),
    'api-token': (b'sk-',),
    'credential-assignment': (b'password', b'api_key', b'access_token', b'secret'),
    'url-credentials': (b'://',),
}


def inspect_content(data):
    lower = data.lower()
    rules = [name for name, pattern in PATTERNS
             if any(literal in lower for literal in PREFILTER[name])
             and re.search(pattern, data)]
    if data.startswith(b'SQLite format 3\x00'):
        rules.append('sqlite-content')
    return rules


def inspect_path(path):
    return bool(SENSITIVE.search(path)) and Path(path).name != '.env.example'


@contextmanager
def batch_reader(root):
    """One long-lived `git cat-file --batch` instead of a process per object.

    Each historical blob is still inspected byte-for-byte; only the process
    launch per object is removed, which dominated the scan of a full history.
    """
    process = subprocess.Popen(['git', '-C', str(root), 'cat-file', '--batch'],
                               stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                               stderr=subprocess.PIPE)
    try:
        def read(oid):
            try:
                process.stdin.write(oid.encode() if isinstance(oid, str) else oid)
                process.stdin.write(b'\n')
                process.stdin.flush()
                header = process.stdout.readline()
            except (BrokenPipeError, OSError) as error:
                raise ValueError('history unreadable') from error
            fields = header.split()
            if len(fields) != 3 or fields[1] in (b'missing', b'ambiguous'):
                raise ValueError('missing object in history')
            size = int(fields[2])
            chunks = []
            remaining = size
            while remaining:
                chunk = process.stdout.read(remaining)
                if not chunk:
                    raise ValueError('truncated object in history')
                chunks.append(chunk)
                remaining -= len(chunk)
            process.stdout.read(1)
            return b''.join(chunks)
        yield read
    finally:
        try:
            process.stdin.close()
        except OSError:
            pass
        process.wait()
        process.stdout.close()
        process.stderr.close()


def scan(root):
    root = Path(root)
    def git(*args):
        return subprocess.check_output(['git', '-C', str(root), *args], stderr=subprocess.PIPE)
    if git('rev-parse', '--is-shallow-repository').strip() != b'false':
        raise ValueError('full history required; fetch without shallow depth')
    findings = set()
    content_seen = set()
    commits = git('rev-list', 'HEAD').decode().splitlines()
    reachable = set(commits)
    messages = git('log', '--no-color', '--format=%H%x00%B%x00', 'HEAD').split(b'\0')
    with batch_reader(root) as read_blob:
        for index in range(0, len(messages) - 1, 2):
            commit = messages[index].strip().decode('utf-8', errors='replace')
            if commit not in reachable:
                continue
            for rule in inspect_content(messages[index + 1]):
                findings.add((commit[:7], '(commit-message)', rule))
        for commit in commits:
            records = git('ls-tree', '-rz', commit).split(b'\0')
            for record in records:
                if not record:
                    continue
                header, raw_path = record.split(b'\t', 1)
                mode, kind, oid = header.split()
                path = raw_path.decode('utf-8', errors='replace')
                if inspect_path(path):
                    findings.add((commit[:7], path, 'sensitive-path'))
                if mode == b'120000':
                    findings.add((commit[:7], path, 'symlink-review'))
                if kind == b'blob' and oid not in content_seen:
                    content_seen.add(oid)
                    for rule in inspect_content(read_blob(oid.decode())):
                        findings.add((commit[:7], path, rule))
        records = git('ls-files', '--stage', '-z').split(b'\0')
        for record in records:
            if not record:
                continue
            header, raw_path = record.split(b'\t', 1)
            mode, oid, stage = header.split()
            path = raw_path.decode('utf-8', errors='replace')
            if stage != b'0':
                findings.add(('index', path, 'unmerged-index'))
            if inspect_path(path):
                findings.add(('index', path, 'sensitive-path'))
            if mode == b'120000':
                findings.add(('index', path, 'symlink-review'))
            for rule in inspect_content(read_blob(oid.decode())):
                findings.add(('index', path, rule))
            local = root / path
            if local.is_file() and not local.is_symlink():
                for rule in inspect_content(local.read_bytes()):
                    findings.add(('working-tree', path, rule))
    return sorted(findings), len(commits), len(content_seen)


if __name__ == '__main__':
    if len(sys.argv) != 1:
        sys.exit('Usage: check-repository')
    try:
        findings, commits, blobs = scan(Path(__file__).resolve().parents[1])
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        sys.exit(f'Repository inspection could not complete: {type(error).__name__}; full readable history required.')
    for revision, path, rule in findings:
        print(f'{revision}: {path}: {rule} (value withheld)', file=sys.stderr)
    if findings:
        sys.exit(1)
    print(f'Repository checks passed: {commits} commits, {blobs} historical blobs, index and tracked working files. Heuristics require manual review too.')
