#!/usr/bin/env python3
"""Behavioral evidence for the shared classifier and supported workflow graph."""
import copy
import contextlib
import io
import itertools
import json
import os
from pathlib import Path
import re
import runpy
import shutil
import subprocess
import tempfile
from types import SimpleNamespace
import unittest

ROOT = Path(__file__).resolve().parents[1]
POLICY = runpy.run_path(str(ROOT / 'scripts/ci_policy.py'))
WORKFLOW = runpy.run_path(str(ROOT / 'scripts/ci_workflow.py'))
CONTEXT = runpy.run_path(str(ROOT / 'scripts/ci_context.py'))
LINUX = runpy.run_path(str(ROOT / 'scripts/ci_prepare_linux.py'))


def by_id(workflow, step_id):
    return next(s for s in workflow['jobs']['required']['steps'] if s.get('id') == step_id)


def by_run(workflow, job, command):
    return next(s for s in workflow['jobs'][job]['steps'] if s.get('run') == command)


CANDIDATE = ROOT / 'scripts/fixtures/ci-policy.workflow.json'


class CiClassifierTests(unittest.TestCase):
    def setUp(self):
        tmp = tempfile.TemporaryDirectory()
        self.addCleanup(tmp.cleanup)
        self.root = Path(tmp.name)
        self.git('init', '-q', '--initial-branch=main')
        # Many real commits must not spawn maintenance racing fixture cleanup.
        self.git('config', 'gc.auto', '0')
        self.git('config', 'maintenance.auto', 'false')
        self.write('README.md', 'fixture')
        self.base = self.commit()

    def git(self, *args):
        return subprocess.check_output(['git', '-C', str(self.root), *args], stderr=subprocess.PIPE)

    def write(self, name, text='fictional documentation'):
        p = self.root / name
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(text)

    def commit(self, stage=True):
        if stage:
            self.git('add', '.')
        self.git('-c', 'user.name=Fixture', '-c', 'user.email=fixture@example.invalid',
                 '-c', 'commit.gpgsign=false', 'commit', '-qm', 'fixture')
        return self.git('rev-parse', 'HEAD').decode().strip()

    def classify(self, head=None, base=None, pr=False):
        return POLICY['classify_git'](self.root, base or self.base, head or self.commit(), pull_request=pr)

    def test_allowlisted_add_modify_delete_and_unusual_paths(self):
        for name in ('normal.md', 'con espacios.md', 'línea\ncon\ttab.md', '-leading.md'):
            self.write('specs/backlog/' + name)
        added = self.commit()
        self.assertEqual(self.classify(added), 'docs')
        self.write('specs/backlog/normal.md', 'changed')
        changed = self.commit()
        self.assertEqual(self.classify(changed, added), 'docs')
        (self.root / 'specs/backlog/normal.md').unlink()
        self.assertEqual(self.classify(base=changed), 'docs')

    def test_documentation_any_directory_add_modify_rename_delete(self):
        for name in ('docs/guide.md', 'infra/README.md',
                     'specs/investigations/note.md', 'unknown.md'):
            with self.subTest(name=name):
                before = self.git('rev-parse', 'HEAD').decode().strip()
                self.write(name, 'docs fixture')
                added = self.commit(); self.assertEqual(self.classify(added, before), 'docs')
                self.write(name, 'changed docs fixture')
                changed = self.commit(); self.assertEqual(self.classify(changed, added), 'docs')
                renamed = name + '.renamed.md'
                self.git('mv', name, renamed)
                moved = self.commit(); self.assertEqual(self.classify(moved, changed), 'docs')
                (self.root / renamed).unlink()
                self.assertEqual(self.classify(base=moved), 'docs')

    def test_pr_107_equivalent_markdown_only_is_docs(self):
        names = [
            'specs/26-e48-precierre-brainstorming.md',
            'specs/26-e48-precierre-specification.md',
            'specs/26-e48-precierre-testplan.md',
            'specs/27-e49-cierre-financiero-brainstorming.md',
            'specs/27-e49-cierre-financiero-specification.md',
            'specs/27-e49-cierre-financiero-testplan.md',
            'specs/investigations/dt5-write-impact-inventory.md',
            'specs/investigations/dt5-e48-e49-specification-proposal.md',
        ]
        for name in names:
            self.write(name)
        head = self.commit()
        self.assertEqual(self.classify(head, self.base, pr=True), 'docs')
        self.assertEqual(self.classify(head, self.base), 'docs')

    def test_docs_rename_touching_functional_path_is_full(self):
        self.write('docs/guide.md', 'same content')
        start = self.commit()
        (self.root / 'apps/api').mkdir(parents=True, exist_ok=True)
        self.git('mv', 'docs/guide.md', 'apps/api/guide.md')
        moved = self.commit()
        self.assertEqual(self.classify(moved, start), 'full')
        self.git('mv', 'apps/api/guide.md', 'docs/guide.md')
        self.assertEqual(self.classify(base=moved), 'full')

    def test_protected_unknown_and_mixed_paths(self):
        protected = [
            'AGENTS.md', 'specs/backlog/AGENTS.md', 'specs/backlog/SKILL.md',
            '.agents/skills/demo/SKILL.md', '.claude/skills/demo/SKILL.md',
            'CLAUDE.md', 'NEW_PROJECT_PROMPT.md', 'PROMPT_BACKUP.md',
            'specs/methodology/ci-policy.md', 'specs/guidelines/quality.md',
            'specs/README.md', 'docs/CLAUDE_CODE.md', 'docs/GUIA_VISUAL_ORQUESTACION.md',
            'templates/specification.md',
            'apps/api/contract.md', 'packages/ui/README.md', 'tests/fixtures/expected.md',
            'scripts/guide.md', '.github/ISSUE_TEMPLATE/config.md',
            'specs/fixtures/README.md', 'build/notes.md', 'dist/notes.md',
            'schema.sql', 'package.json', 'bun.lock', 'tsconfig.json',
            '.github/workflows/validate.yml', 'scripts/check-project',
            'apps/web/src/App.tsx', 'unknown.txt', 'specs/backlog/config.yml',
        ]
        for name in protected:
            with self.subTest(name=name):
                data = ('A\0specs/backlog/demo.md\0M\0' + name + '\0').encode()
                self.assertEqual(POLICY['classify_records'](data), 'full')
        docs = [
            'README.md', 'infra/README.md', 'docs/USAGE_REPORTS.md',
            'specs/investigations/new.md', 'specs/31-sqlite-produccion-x.md',
            'specs/backlog/nested/file.md', 'unknown.md',
            'specs/09-plan-ciclo/plan-specification.md',
        ]
        for name in docs:
            with self.subTest(name=name):
                self.assertEqual(POLICY['classify_records'](('A\0' + name + '\0').encode()), 'docs')

    def test_each_product_family_and_exact_path_git_lifecycle(self):
        names = ['specs/09-plan-' + kind + '.md' for kind in
                 ('brainstorming', 'specification', 'progress', 'testplan')]
        names += ['specs/backlog/fixture.md'] + ['specs/' + n for n in
                 ('project.md', 'roadmap.md', 'setup-progress.md', 'epic-board.md', 'functional-reference-v5.11.md')]
        for index, name in enumerate(names):
            with self.subTest(name=name):
                before = self.commit() if self.git('status', '--porcelain') else self.git('rev-parse', 'HEAD').decode().strip()
                self.write(name, 'unique ' + name)
                added = self.commit(); self.assertEqual(self.classify(added, before), 'docs')
                self.write(name, 'changed unique ' + name)
                changed = self.commit(); self.assertEqual(self.classify(changed, added), 'docs')
                renamed = 'specs/backlog/rename-' + str(index) + '.md'
                (self.root / renamed).parent.mkdir(parents=True, exist_ok=True)
                self.git('mv', name, renamed)
                moved = self.commit(); self.assertEqual(self.classify(moved, changed), 'docs')
                self.git('mv', renamed, name)
                returned = self.commit(); self.assertEqual(self.classify(returned, moved), 'docs')
                (self.root / name).unlink()
                self.assertEqual(self.classify(base=returned), 'docs')

    def test_protected_categories_git_lifecycle_alone_and_product_mixes(self):
        protected = ['AGENTS.md', 'specs/backlog/AgEnTs.Md', '.agents/skills/demo/SKILL.md',
                     '.claude/skills/demo/SKILL.md', 'specs/methodology/policy.md',
                     'specs/guidelines/quality.md', 'specs/README.md',
                     'docs/CLAUDE_CODE.md', 'templates/specification.md',
                     'NEW_PROJECT_PROMPT.md', 'PROMPT_BACKUP_COMPLETE.md',
                     'apps/api/contract.md', 'tests/fixtures/expected.md',
                     'scripts/guide.md', 'specs/fixtures/README.md',
                     '.github/ISSUE_TEMPLATE/config.md',
                     'scripts/verify', '.github/workflows/validate.yml',
                     'config.json', 'schema.sql', 'package.json',
                     'bun.lock', 'apps/api/code.ts']
        families = ['specs/backlog/fixture.md', 'specs/project.md'] + [
                    'specs/09-plan-' + kind + '.md' for kind in
                    ('brainstorming', 'specification', 'progress', 'testplan')]
        for path in protected:
            with self.subTest(path=path):
                before = self.git('rev-parse', 'HEAD').decode().strip()
                self.write(path, 'protected added'); added = self.commit()
                self.assertEqual(self.classify(added, before), 'full')
                self.write(path, 'protected changed'); changed = self.commit()
                self.assertEqual(self.classify(changed, added), 'full')
                for index, family in enumerate(families):
                    base = self.git('rev-parse', 'HEAD').decode().strip()
                    self.write(path, 'protected mixed ' + str(index))
                    self.write(family, 'product mixed ' + path)
                    self.assertEqual(self.classify(base=base), 'full')
                base = self.git('rev-parse', 'HEAD').decode().strip(); (self.root / path).unlink()
                self.assertEqual(self.classify(base=base), 'full')

    def test_real_renames_both_directions_for_every_product_family(self):
        families = ['specs/backlog/fixture.md', 'specs/project.md'] + [
                    'specs/09-plan-' + kind + '.md' for kind in
                    ('brainstorming', 'specification', 'progress', 'testplan')]
        for index, family in enumerate(families):
            with self.subTest(family=family):
                protected = 'specs/methodology/protected-' + str(index) + '.md'
                self.write(protected, 'unique rename ' + str(index)); before = self.commit()
                (self.root / family).parent.mkdir(parents=True, exist_ok=True)
                self.git('mv', protected, family); forward = self.commit()
                self.assertEqual(self.classify(forward, before), 'full')
                self.git('mv', family, protected)
                self.assertEqual(self.classify(base=forward), 'full')

    def test_complete_range_includes_earlier_code_change(self):
        self.write('apps/api/code.ts', 'export const fictional = 1;')
        self.commit()
        self.write('specs/backlog/last.md')
        self.assertEqual(self.classify(), 'full')

    def test_functional_documents_real_add_modify_delete_and_rename(self):
        names = ['specs/09-plan-ciclo-' + kind + '.md' for kind in
                 ('brainstorming', 'specification', 'progress', 'testplan')]
        names += ['specs/' + name for name in
                  ('project.md', 'roadmap.md', 'setup-progress.md', 'epic-board.md',
                   'functional-reference-v5.11.md')]
        for name in names:
            self.write(name, 'fixture ' + name)
        added = self.commit()
        self.assertEqual(self.classify(added), 'docs')
        self.write(names[0], 'changed fixture')
        changed = self.commit()
        self.assertEqual(self.classify(changed, added), 'docs')
        (self.root / names[1]).unlink()
        deleted = self.commit()
        self.assertEqual(self.classify(deleted, changed), 'docs')
        self.git('mv', names[0], 'specs/10-next-brainstorming.md')
        self.assertEqual(self.classify(base=deleted), 'docs')

    def test_functional_docs_do_not_allow_unknown_or_operational_markdown(self):
        forbidden = ['specs/AGENTS.md', 'specs/CLAUDE.md', 'specs/SKILL.md',
                     'specs/instructions.md', 'specs/methodology/09-policy-specification.md',
                     'specs/guidelines/09-guide-specification.md',
                     '.agents/skills/09-plan-specification.md',
                     '.claude/skills/09-plan-specification.md',
                     'templates/09-plan-specification.md',
                     'specs/README.md', 'docs/CLAUDE_CODE.md',
                     'NEW_PROJECT_PROMPT.md', 'PROMPT_BACKUP.md',
                     'apps/api/09-plan-specification.md',
                     'tests/fixtures/09-plan-specification.md',
                     'scripts/09-plan-specification.md',
                     'specs/fixtures/09-plan-specification.md',
                     '.github/09-plan-specification.md',
                     'unknown.txt', 'specs/backlog/config.yml']
        for name in forbidden:
            with self.subTest(name=name):
                for status in ('A', 'M', 'D'):
                    records = (status + '\0' + name + '\0').encode()
                    self.assertEqual(POLICY['classify_records'](records), 'full')
                    mixed = b'A\0specs/09-plan-specification.md\0' + records
                    self.assertEqual(POLICY['classify_records'](mixed), 'full')
        for name in ('specs/unknown.md', 'README.md', 'docs/guide.md',
                     'infra/README.md', 'specs/09-plan-ciclo/plan-specification.md'):
            with self.subTest(docs=name):
                self.assertEqual(POLICY['classify_records'](('A\0' + name + '\0').encode()), 'docs')

    def test_functional_rename_checks_both_endpoints(self):
        self.write('specs/guidelines/quality.md', 'identical fixture')
        before = self.commit()
        self.git('mv', 'specs/guidelines/quality.md', 'specs/09-plan-specification.md')
        middle = self.commit()
        self.assertEqual(self.classify(middle, before), 'full')
        (self.root / 'apps/api').mkdir(parents=True, exist_ok=True)
        self.git('mv', 'specs/09-plan-specification.md', 'apps/api/unknown.md')
        self.assertEqual(self.classify(base=middle), 'full')

    def test_deleted_protected_file(self):
        self.write('AGENTS.md')
        before = self.commit()
        (self.root / 'AGENTS.md').unlink()
        self.assertEqual(self.classify(base=before), 'full')

    def test_local_git_config_cannot_hide_gitlink_mixed_with_docs(self):
        self.write('specs/backlog/demo.md')
        self.git('add', '.')
        self.git('update-index', '--add', '--cacheinfo', '160000,' + self.base + ',vendor/fixture')
        head = self.commit(stage=False)
        self.git('config', 'diff.ignoreSubmodules', 'all')
        hidden = self.git('diff', '--name-status', '-z', self.base, head)
        self.assertEqual(POLICY['classify_records'](hidden), 'docs')
        self.assertEqual(self.classify(head), 'full')

    def test_both_sides_of_real_renames(self):
        self.write('apps/api/code.md', 'same content for rename detection')
        start = self.commit()
        (self.root / 'specs/backlog').mkdir(parents=True)
        self.git('mv', 'apps/api/code.md', 'specs/backlog/demo.md')
        middle = self.commit()
        self.assertEqual(self.classify(middle, start), 'full')
        self.git('mv', 'specs/backlog/demo.md', 'apps/api/other.md')
        self.assertEqual(self.classify(base=middle), 'full')

    def test_document_to_document_rename(self):
        self.write('specs/backlog/old.md')
        start = self.commit()
        self.git('mv', 'specs/backlog/old.md', 'specs/backlog/new name.md')
        self.assertEqual(self.classify(base=start), 'docs')

    def test_empty_invalid_incomplete_and_unknown_records(self):
        cases = [b'', b'A\0', b'A\0x', b'A\0\0', b'R100\0specs/backlog/a.md\0',
                 b'M\0specs/backlog/a.md\0junk', b'Z\0specs/backlog/a.md\0',
                 b'M\0specs/backlog/\xff.md\0', b'M\0specs/backlog/../a.md\0',
                 b'M\0/specs/backlog/a.md\0']
        for value in cases:
            with self.subTest(value=value):
                self.assertEqual(POLICY['classify_records'](value), 'full')

    def test_missing_empty_comparison_shallow_and_failed_git(self):
        self.assertEqual(self.classify(self.base), 'full')
        self.assertEqual(self.classify('f' * 40), 'full')
        self.assertEqual(self.classify(self.base, base='0' * 40), 'full')
        self.assertEqual(self.classify(self.base, base='--help'), 'full')
        self.write('specs/backlog/demo.md')
        head = self.commit()
        (self.root / '.git/shallow').write_text(self.base + '\n')
        self.assertEqual(self.classify(head), 'full')
        self.assertEqual(POLICY['classify_git'](self.root / 'missing', self.base, head), 'full')

    def test_push_and_pr_event_bases_and_manual_fallback(self):
        self.write('specs/backlog/demo.md')
        head = self.commit()
        self.assertEqual(POLICY['classify_event'](self.root, 'push',
                         {'before': self.base, 'after': head}), 'docs')
        self.assertEqual(POLICY['classify_event'](self.root, 'pull_request',
                         {'pull_request': {'base': {'sha': self.base}, 'head': {'sha': head}}}), 'docs')
        for event in ('workflow_dispatch', 'unknown', 'push', 'pull_request'):
            self.assertEqual(POLICY['classify_event'](self.root, event, {}), 'full')

    def test_pr_merge_base_excludes_base_branch_only_code(self):
        self.git('switch', '-qc', 'feature')
        self.write('specs/backlog/demo.md')
        head = self.commit()
        self.git('switch', '-q', 'main')
        self.write('apps/api/base-only.ts')
        base = self.commit()
        self.assertEqual(self.classify(head, base, pr=True), 'docs')
        self.assertEqual(self.classify(head, base), 'full')

    def test_snapshot_pins_merge_and_rejects_a_moved_pr_head(self):
        self.git('switch', '-qc', 'feature')
        self.write('specs/backlog/demo.md')
        head = self.commit()
        self.git('switch', '-q', 'main')
        self.write('apps/api/base.ts')
        self.commit()
        self.git('-c', 'user.name=Fixture', '-c', 'user.email=fixture@example.invalid',
                 '-c', 'commit.gpgsign=false', 'merge', '--no-ff', '-qm', 'fixture integration', 'feature')
        event = {'after': head}
        snapshot = CONTEXT['snapshot'](self.root, 'push', event, 'refs/pull/7/merge')
        self.assertEqual(snapshot, self.git('rev-parse', 'HEAD').decode().strip())
        self.assertEqual(POLICY['classify_event'](self.root, 'push',
                                               {'before': self.base, 'after': head},
                                               'refs/pull/7/merge'), 'docs')
        with self.assertRaises(ValueError):
            CONTEXT['snapshot'](self.root, 'push', {'after': self.base}, 'refs/pull/7/merge')
        with self.assertRaises(ValueError):
            CONTEXT['snapshot'](self.root, 'push', event, head)

    def test_snapshot_peels_annotated_deploy_tag_to_the_event_commit(self):
        actual = self.git('rev-parse', 'HEAD').decode().strip()
        ref = 'refs/tags/deploy-test-v1.2.3'
        self.git('-c', 'user.name=Fixture', '-c', 'user.email=fixture@example.invalid',
                 'tag', '-a', 'deploy-test-v1.2.3', '-m', 'fixture', actual)
        tag_object = self.git('rev-parse', ref).decode().strip()
        self.assertNotEqual(tag_object, actual)
        event = {'ref': ref, 'after': tag_object}
        # GITHUB_SHA may be the tag object or its peeled commit.
        self.assertEqual(CONTEXT['snapshot'](self.root, 'push', event, ref, actual), actual)
        self.assertEqual(CONTEXT['snapshot'](self.root, 'push', event, ref, tag_object), actual)
        for forged, checkout in ((None, ref), ('b' * 40, ref), (actual, 'refs/tags/other')):
            with self.subTest(forged=forged, checkout=checkout), self.assertRaises(ValueError):
                CONTEXT['snapshot'](self.root, 'push', event, checkout, forged)
        for malformed in ('refs/tags/deploy-test-v1.2', 'refs/tags/deploy-test-v01.2.3',
                          'refs/tags/deploy-test-v1.2.3.4'):
            with self.subTest(malformed=malformed), self.assertRaises(ValueError):
                CONTEXT['snapshot'](self.root, 'push',
                                    {'ref': malformed, 'after': actual}, malformed, actual)
        # A lightweight deploy tag is rejected before any application checks.
        light = 'refs/tags/deploy-test-v9.9.9'
        self.git('tag', 'deploy-test-v9.9.9', actual)
        with self.assertRaises(ValueError):
            CONTEXT['snapshot'](self.root, 'push', {'ref': light, 'after': actual}, light, actual)
        # A rewritten tag ref is no longer an annotated tag object either.
        self.git('update-ref', ref, actual)
        with self.assertRaises(ValueError):
            CONTEXT['snapshot'](self.root, 'push', {'ref': ref, 'after': actual}, ref, tag_object)

    def test_lightweight_deploy_tag_is_rejected_before_full(self):
        actual = self.git('rev-parse', 'HEAD').decode().strip()
        light = 'refs/tags/deploy-test-v9.9.9'
        self.git('tag', 'deploy-test-v9.9.9', actual)
        event = {'ref': light, 'after': actual, 'repository': {'default_branch': 'main'}}
        with self.assertRaises(ValueError):
            CONTEXT['select_ref']('push', event, 'fixture/project', lambda *_: [], self.root)
        with self.assertRaises(ValueError):
            CONTEXT['snapshot'](self.root, 'push', event, light, actual)
        with self.assertRaises(ValueError):
            POLICY['ci_profile'](self.root, 'push', event, light)
        # The annotated SemVer tag is accepted and selects full.
        annotated = 'refs/tags/deploy-test-v9.9.10'
        self.git('-c', 'user.name=Fixture', '-c', 'user.email=fixture@example.invalid',
                 'tag', '-a', 'deploy-test-v9.9.10', '-m', 'fixture', actual)
        event = {'ref': annotated, 'after': actual, 'repository': {'default_branch': 'main'}}
        self.assertEqual(CONTEXT['select_ref']('push', event, 'fixture/project',
                                               lambda *_: [], self.root), annotated)
        self.assertEqual(POLICY['ci_profile'](self.root, 'push', event, annotated), 'full')

    def test_surviving_docs_push_keeps_full_for_accumulated_pr_code(self):
        self.git('switch', '-qc', 'feature')
        self.write('apps/api/code.ts', 'fictional code')
        before = self.commit()
        self.write('specs/backlog/last.md')
        head = self.commit()
        self.git('switch', '-q', 'main')
        self.write('README.md', 'base branch advanced')
        base = self.commit()
        self.git('-c', 'user.name=Fixture', '-c', 'user.email=fixture@example.invalid',
                 '-c', 'commit.gpgsign=false', 'merge', '--no-ff', '-qm', 'fixture integration', 'feature')
        push = {'before': before, 'after': head}
        pr = {'pull_request': {'base': {'sha': base}, 'head': {'sha': head}}}
        self.assertEqual(POLICY['classify_event'](self.root, 'push', push), 'docs')
        self.assertEqual(POLICY['classify_event'](self.root, 'push', push, 'refs/pull/7/merge'), 'full')
        self.assertEqual(POLICY['classify_event'](self.root, 'pull_request', pr, 'refs/pull/7/merge'), 'full')
        self.assertEqual(POLICY['classify_event'](self.root, 'push', push, ''), 'full')
        self.assertEqual(POLICY['classify_event'](self.root, 'push', {**push, 'after': self.base},
                                               'refs/pull/7/merge'), 'full')

    def test_cli_reads_full_event_and_missing_event_falls_back(self):
        self.write('specs/backlog/demo.md')
        head = self.commit()
        script = self.root / 'scripts/verify'
        script.parent.mkdir()
        shutil.copy2(ROOT / 'scripts/ci_policy.py', script)
        event = self.root / 'event.json'
        event.write_text(json.dumps({'before': self.base, 'after': head}))
        env = {**os.environ, 'GITHUB_EVENT_NAME': 'push', 'GITHUB_EVENT_PATH': str(event)}
        # The synthetic event must not inherit the CI step's verified integration ref.
        env.pop('CI_CHECKOUT_REF', None)
        command = ['python3', str(script), 'classify']
        self.assertEqual(subprocess.check_output(command, env=env).strip(), b'docs')
        self.assertEqual(subprocess.check_output(command + ['--base', self.base, '--head', head],
                                                env=env).strip(), b'docs')
        event.write_text('{incomplete')
        self.assertEqual(subprocess.check_output(command, env=env).strip(), b'full')
        event.unlink()
        self.assertEqual(subprocess.check_output(command, env=env).strip(), b'full')

    def test_ci_profiles_critical_unknown_renames_and_fast_allowlist(self):
        profiles = POLICY['profile_records']
        critical = [
            'apps/api/src/app.ts', 'apps/web/src/Unknown.tsx', 'apps/web/src/amount.ts',
            'scripts/verify', 'infra/Containerfile', 'bun.lock',
            'apps/api/contract.md', 'tests/fixtures/expected.md', 'scripts/guide.md',
            'specs/fixtures/README.md', 'AGENTS.md', 'specs/methodology/policy.md',
            'templates/specification.md', 'unknown.txt',
        ]
        for path in critical:
            for status in ('A', 'M', 'D'):
                self.assertEqual(profiles((status + '\0' + path + '\0').encode()), 'critical')
            for endpoints in ((path, 'apps/web/src/style.css'), ('apps/web/src/style.css', path)):
                self.assertEqual(profiles(('R100\0' + '\0'.join(endpoints) + '\0').encode()), 'critical')
        sensitive = [
            'apps/api/src/backup.ts', 'apps/api/src/backup-cli.ts', 'apps/api/src/database.ts',
            'apps/api/src/database-schema.ts', 'apps/api/src/database-identity.ts',
            'apps/api/src/private-state.ts', 'apps/api/src/schema-contract.ts',
            'apps/api/src/sqlite-opening.ts', 'apps/api/src/e411-schema.ts',
            'infra/migrations/27-to-28.json', 'infra/compatibility.py', 'infra/release.py',
            'infra/smoke.py',
        ]
        for path in sensitive:
            for status in ('A', 'M', 'D'):
                self.assertEqual(profiles((status + '\0' + path + '\0').encode()), 'full')
            for endpoints in ((path, 'apps/web/src/style.css'), ('apps/web/src/style.css', path)):
                self.assertEqual(profiles(('R100\0' + '\0'.join(endpoints) + '\0').encode()), 'full')
        self.assertEqual(profiles(('M\0specs/project.md\0M\0apps/api/src/backup.ts\0').encode()), 'full')
        for path in ('apps/api/src/app.test.ts', 'apps/api/src/security-review.test.ts'):
            self.assertEqual(profiles(('M\0' + path + '\0').encode()), 'full')
        self.assertNotEqual(profiles(('M\0apps/api/src/amount.test.ts\0').encode()), 'full')
        self.assertNotEqual(profiles(('M\0apps/api/src/not-a-file.test.ts\0').encode()), 'full')
        docs = ['specs/project.md', 'specs/investigations/new.md', 'docs/guide.md',
                'README.md', 'specs/31-sqlite-produccion-x.md', 'unknown.md']
        for path in docs:
            self.assertEqual(profiles(('M\0' + path + '\0').encode()), 'docs')
        self.assertEqual(profiles(b'M\0apps/web/src/style.css\0'), 'fast')
        self.assertEqual(profiles(('M\0specs/project.md\0M\0apps/web/src/style.css\0').encode()), 'fast')
        self.assertEqual(profiles(('R100\0specs/project.md\0specs/investigations/new.md\0').encode()), 'docs')
        self.assertEqual(profiles(('R100\0specs/project.md\0apps/api/code.ts\0').encode()), 'critical')
        self.assertEqual(profiles(b'M\0apps/web/../amount.css\0'), 'critical')
        for bad in (b'', b'M\0', b'R100\0apps/web/a.css\0', b'Z\0apps/web/a.css\0', b'M\0bad\xff\0'):
            self.assertEqual(profiles(bad), 'critical')

    def test_ci_profile_compares_entire_pr_and_verified_integration_base(self):
        self.git('switch', '-qc', 'feature')
        self.write('apps/web/src/amount.ts', 'export const total = 1;')
        self.commit()
        self.write('specs/backlog/last.md')
        head = self.commit()
        self.git('switch', '-q', 'main')
        base = self.git('rev-parse', 'HEAD').decode().strip()
        self.git('-c', 'user.name=Fixture', '-c', 'user.email=fixture@example.invalid',
                 '-c', 'commit.gpgsign=false', 'merge', '--no-ff', '-qm', 'integration', 'feature')
        event = {'pull_request': {'base': {'ref': 'main', 'sha': base}, 'head': {'sha': head}}}
        select = POLICY['ci_profile']
        self.assertEqual(select(self.root, 'pull_request', event, 'refs/pull/7/merge'), 'critical')
        event['pull_request']['base'] = {'ref': 'test', 'sha': base}
        self.assertEqual(select(self.root, 'pull_request', event, 'refs/pull/7/merge'), 'critical')
        event['pull_request']['base']['sha'] = head
        with self.assertRaises(ValueError):
            select(self.root, 'pull_request', event, 'refs/pull/7/merge')
        for arbitrary in ('other', 'feature', 'Main'):
            event['pull_request']['base'] = {'ref': arbitrary, 'sha': base}
            with self.assertRaises(ValueError):
                select(self.root, 'pull_request', event, 'refs/pull/7/merge')
        actual = self.git('rev-parse', 'HEAD').decode().strip()
        for ref in ('refs/heads/main', 'refs/heads/test'):
            self.assertEqual(select(self.root, 'push', {'ref': ref, 'after': actual}, actual), 'fast')
        self.write('specs/backlog/main-docs.md')
        docs_head = self.commit()
        for ref in ('refs/heads/main', 'refs/heads/test'):
            self.assertEqual(select(self.root, 'push', {'ref': ref, 'before': actual,
                                                        'after': docs_head}, docs_head), 'docs')
        self.write('apps/web/src/main-code.ts', 'export const total = 1;')
        code_head = self.commit()
        for ref in ('refs/heads/main', 'refs/heads/test'):
            self.assertEqual(select(self.root, 'push', {'ref': ref, 'before': docs_head,
                                                        'after': code_head}, code_head), 'fast')
            self.assertEqual(select(self.root, 'push', {'ref': ref, 'after': code_head}, code_head), 'fast')
        for ref in ('refs/heads/feature', 'refs/tags/v1', 'refs/heads/test-extra'):
            with self.assertRaises(ValueError):
                select(self.root, 'push', {'ref': ref, 'before': docs_head, 'after': code_head}, code_head)
        self.assertEqual(select(self.root, 'workflow_dispatch', {}, code_head), 'full')
        with self.assertRaises(ValueError): select(self.root, 'unknown', {}, code_head)

    def test_ci_profile_deploy_tags_run_full_on_the_exact_tag_commit(self):
        select = POLICY['ci_profile']
        actual = self.git('rev-parse', 'HEAD').decode().strip()
        ref = 'refs/tags/deploy-test-v1.2.3'
        self.git('-c', 'user.name=Fixture', '-c', 'user.email=fixture@example.invalid',
                 'tag', '-a', 'deploy-test-v1.2.3', '-m', 'fixture', actual)
        self.assertEqual(select(self.root, 'push', {'ref': ref, 'after': actual}, ref), 'full')
        # An annotated tag push may expose the tag object as the event SHA.
        annotated = 'refs/tags/deploy-test-v2.0.0'
        self.git('-c', 'user.name=Fixture', '-c', 'user.email=fixture@example.invalid',
                 'tag', '-a', 'deploy-test-v2.0.0', '-m', 'fixture', actual)
        tag_object = self.git('rev-parse', annotated).decode().strip()
        self.assertEqual(select(self.root, 'push', {'ref': annotated, 'after': tag_object}, annotated), 'full')
        # A checked-out commit that differs from the tag commit is refused.
        self.git('-c', 'user.name=Fixture', '-c', 'user.email=fixture@example.invalid',
                 'tag', '-a', 'deploy-test-v3.0.0', '-m', 'fixture', self.base)
        self.write('specs/backlog/after-tag.md')
        self.commit()
        with self.assertRaises(ValueError):
            select(self.root, 'push', {'ref': 'refs/tags/deploy-test-v3.0.0', 'after': self.base},
                   'refs/tags/deploy-test-v3.0.0')
        for event, checkout in (
                ({'ref': ref, 'after': actual}, actual),           # raw SHA instead of the tag ref
                ({'ref': ref, 'after': '0' * 40}, ref),            # deleted tag
                ({'ref': 'refs/tags/v1', 'after': actual}, 'refs/tags/v1'),
                ({'ref': 'refs/tags/deploy-test-v1.2', 'after': actual},
                 'refs/tags/deploy-test-v1.2'),
                ({'ref': 'refs/tags/deploy-test-v01.2.3', 'after': actual},
                 'refs/tags/deploy-test-v01.2.3'),
                ({'ref': ref, 'after': actual}, 'refs/heads/main')):
            with self.subTest(event=event, checkout=checkout), self.assertRaises(ValueError):
                select(self.root, 'push', event, checkout)

    def test_ci_profile_accepts_a_base_that_only_advanced_and_rejects_races(self):
        select = POLICY['ci_profile']
        merge = ('-c', 'user.name=Fixture', '-c', 'user.email=fixture@example.invalid',
                 '-c', 'commit.gpgsign=false', 'merge', '--no-ff', '-qm', 'integration')
        # A docs-only PR whose merge ref was rebuilt after main advanced: the event
        # still carries the older base, which is a legitimate ancestor.
        self.git('switch', '-qc', 'advanced-docs')
        self.write('specs/backlog/advanced.md')
        docs_head = self.commit()
        self.git('switch', '-q', 'main')
        stale_docs = self.git('rev-parse', 'HEAD').decode().strip()
        self.write('apps/api/base-only-docs.ts', 'export const base = 1;')
        self.commit()
        self.git(*merge, 'advanced-docs')
        docs_event = {'pull_request': {'base': {'ref': 'main', 'sha': stale_docs},
                                       'head': {'sha': docs_head}}}
        self.assertEqual(select(self.root, 'pull_request', docs_event, 'refs/pull/7/merge'), 'docs')
        # The same event with a rewritten/divergent base still fails closed.
        for forged in (docs_head, self.git('rev-parse', 'HEAD').decode().strip()):
            event = {'pull_request': {'base': {'ref': 'main', 'sha': forged},
                                      'head': {'sha': docs_head}}}
            with self.assertRaises(ValueError):
                select(self.root, 'pull_request', event, 'refs/pull/7/merge')
        # A head that differs from the checked-out merge ref still fails closed.
        event = {'pull_request': {'base': {'ref': 'main', 'sha': stale_docs},
                                  'head': {'sha': stale_docs}}}
        with self.assertRaises(ValueError):
            select(self.root, 'pull_request', event, 'refs/pull/7/merge')
        # A merge ref older than the event snapshot is not accepted by ancestry.
        self.write('apps/api/later-main.ts', 'export const later = 2;')
        later_main = self.commit()
        integration = self.git('rev-parse', 'HEAD^').decode().strip()
        self.git('checkout', '-q', '--detach', integration)
        event = {'pull_request': {'base': {'ref': 'main', 'sha': later_main},
                                  'head': {'sha': docs_head}}}
        with self.assertRaises(ValueError):
            select(self.root, 'pull_request', event, 'refs/pull/7/merge')
        # Code in the PR never degrades to docs when the base advanced.
        self.git('switch', '-q', 'main')
        self.git('switch', '-qc', 'advanced-code')
        self.write('apps/web/src/advanced.ts', 'export const total = 3;')
        code_head = self.commit()
        self.git('switch', '-q', 'main')
        stale_code = self.git('rev-parse', 'HEAD').decode().strip()
        self.write('apps/api/base-only-code.ts', 'export const base = 4;')
        self.commit()
        self.git(*merge, 'advanced-code')
        code_event = {'pull_request': {'base': {'ref': 'main', 'sha': stale_code},
                                       'head': {'sha': code_head}}}
        self.assertEqual(select(self.root, 'pull_request', code_event, 'refs/pull/7/merge'), 'critical')



class CiWorkflowTests(unittest.TestCase):
    def setUp(self):
        tmp = tempfile.TemporaryDirectory()
        self.addCleanup(tmp.cleanup)
        self.root = Path(tmp.name)
        self.candidate = json.loads(CANDIDATE.read_text())

    def errors(self, value):
        path = self.root / 'workflow.json'
        path.write_text(json.dumps(value))
        return WORKFLOW['validate_workflow'](path)

    def test_valid_candidate_and_actual_no_legacy_exception(self):
        self.assertEqual(self.errors(self.candidate), [])
        self.assertEqual(WORKFLOW['validate_workflow'](ROOT / '.github/workflows/validate.yml'), [])
        legacy = self.root / 'legacy.yml'
        legacy.write_text('name: Legacy\non: [push, pull_request]\njobs: {}\n')
        self.assertTrue(WORKFLOW['validate_workflow'](legacy))

    def test_required_check_name_is_stable_and_profile_job_publishes_the_profile(self):
        required = self.candidate['jobs']['required']
        # No job-level name: the protected check keeps the fixed id `required`.
        self.assertNotIn('name', required)
        self.assertEqual(required['outputs'], {'profile': '${{ steps.plan.outputs.profile }}'})
        profile = self.candidate['jobs']['profile']
        self.assertEqual(profile['name'],
                         "CI profile: ${{ needs.required.outputs.profile || 'UNKNOWN' }}")
        self.assertEqual(profile['needs'], 'required')
        self.assertEqual(profile['if'], '${{ always() }}')
        self.assertEqual(len(profile['steps']), 1)
        self.assertNotIn('scripts/verify', profile['steps'][0]['run'])

    def test_reject_semantic_mutations(self):
        mutations = {
            'missing selector': lambda w: w['jobs']['required']['steps'].remove(by_id(w, 'plan')),
            'disabled job': lambda w: w['jobs']['required'].update({'if': False}),
            'disabled baseline': lambda w: by_id(w, 'baseline').update({'if': False}),
            'missing final': lambda w: w['jobs'].pop('required'),
            'skippable final': lambda w: w['jobs']['required']['steps'][-1].pop('if'),
            'final always succeeds': lambda w: w['jobs']['required']['steps'][-1].update(run='echo success'),
            'allowed failure': lambda w: by_id(w, 'verify').update({'continue-on-error': True}),
            'job allowed failure': lambda w: w['jobs']['required'].update({'continue-on-error': True}),
            'commented command': lambda w: by_id(w, 'verify').update(run='# python3 scripts/verify ci'),
            'event path filter': lambda w: w['on']['pull_request'].update(paths=['apps/**']),
            'missing ready_for_review': lambda w: w['on']['pull_request']['types'].remove('ready_for_review'),
            'draft job skip': lambda w: w['jobs']['required'].update({'if': 'github.event.pull_request.draft == false'}),
            'draft step skip': lambda w: by_id(w, 'verify').update({'if': 'github.event.pull_request.draft == false'}),
            'redundant feature push': lambda w: w['on'].update(push={}),
            'missing deploy tag push': lambda w: w['on'].pop('push'),
            'missing deploy tag filter': lambda w: w['on']['push'].pop('tags'),
            'wrong deploy tag filter': lambda w: w['on']['push'].update(tags=['v*']),
            'automatic branch push': lambda w: w['on']['push'].update(branches=['main', 'test']),
            'missing test PR base': lambda w: w['on']['pull_request']['branches'].remove('test'),
            'arbitrary PR base': lambda w: w['on']['pull_request']['branches'].append('feature'),
            'arbitrary push branch': lambda w: w['on']['push'].update(branches=['feature']),
            'test push cancellation allowed': lambda w: w['concurrency'].update(
                {'cancel-in-progress': "${{ github.ref != 'refs/heads/main' && github.event_name != 'workflow_dispatch' }}"}),
            'missing profile summary': lambda w: w['jobs']['required']['steps'].remove(by_id(w, 'summary')),
            'summary loses profile': lambda w: by_id(w, 'summary').update(run='echo ok'),
            'summary trusts declared profile': lambda w: by_id(w, 'summary').pop('env'),
            'privileged event': lambda w: w.update({'on': ['pull_request_target']}),
            'write permissions': lambda w: w.update(permissions={'contents': 'write'}),
            'unpinned action': lambda w: w['jobs']['required']['steps'][0].update(uses='actions/checkout@v4'),
            'shallow history': lambda w: w['jobs']['required']['steps'][0]['with'].update({'fetch-depth': 1}),
            'persist credentials': lambda w: w['jobs']['required']['steps'][0]['with'].update({'persist-credentials': True}),
            'result env missing': lambda w: w['jobs']['required']['steps'][-1]['env'].pop('CI_VERIFY'),
            'selector error suppressed': lambda w: by_id(w, 'plan').update(run='python3 scripts/verify ci-plan || true'),
            'application bypasses entry': lambda w: by_id(w, 'verify').update(run='bun run test'),
            'baseline bypasses entry': lambda w: by_id(w, 'baseline').update(run='./scripts/test-checks'),
            'baseline loses verified context': lambda w: by_id(w, 'baseline').pop('env'),
            'baseline trusts declared profile': lambda w: by_id(w, 'baseline')['env'].update(
                {'CI_PROFILE': '${{ steps.plan.outputs.profile }}'}),
            'missing concurrency': lambda w: w.pop('concurrency'),
            'wrong event group': lambda w: w['concurrency'].update(group='${{ github.event_name }}-${{ github.ref }}'),
            'no cancellation': lambda w: w['concurrency'].update({'cancel-in-progress': False}),
            'missing PR context': lambda w: w['jobs']['required']['steps'].remove(by_id(w, 'context')),
            'selector loses PR context': lambda w: by_id(w, 'plan').pop('env'),
            'snapshot guard removed': lambda w: by_id(w, 'snapshot').update(run='git rev-parse HEAD'),
            'moving runner': lambda w: w['jobs']['required'].update({'runs-on': 'ubuntu-latest'}),
            'skip Linux setup': lambda w: by_id(w, 'prepare').update({'if': False}),
            'system browser substitution': lambda w: w['jobs']['required'].update(env={'PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH': '/usr/bin/chromium'}),
            'application skipped': lambda w: by_id(w, 'verify').update({'if': False}),
            'profile job removed': lambda w: w['jobs'].pop('profile'),
            'profile check name loses profile': lambda w: w['jobs']['profile'].update(
                {'name': 'CI profile'}),
            'profile job loses dependency': lambda w: w['jobs']['profile'].pop('needs'),
            'profile job can be skipped': lambda w: w['jobs']['profile'].pop('if'),
            'required loses profile output': lambda w: w['jobs']['required'].pop('outputs'),
            'profile job runs verification': lambda w: w['jobs']['profile']['steps'][0].update(
                run='python3 scripts/verify baseline'),
            'extra job': lambda w: w['jobs'].update(
                extra={'runs-on': 'ubuntu-24.04', 'steps': [{'run': 'echo extra'}]}),
        }
        for name, mutate in mutations.items():
            with self.subTest(name=name):
                value = copy.deepcopy(self.candidate)
                mutate(value)
                self.assertTrue(self.errors(value))

    def test_unreadable_malformed_duplicate_keys_and_boolean_number(self):
        p = self.root / 'bad.json'
        for data in ('{}', '{', 'null', '{"on":[],"on":[]}'):
            p.write_text(data)
            self.assertTrue(WORKFLOW['validate_workflow'](p))
        self.assertTrue(WORKFLOW['validate_workflow'](self.root / 'missing'))
        value = copy.deepcopy(self.candidate)
        value['jobs']['required']['steps'][0]['with']['persist-credentials'] = 0
        self.assertTrue(self.errors(value))

    def test_classifier_step_rejects_invalid_output_and_crashes(self):
        script = self.root / 'scripts/verify'
        script.parent.mkdir()
        output = self.root / 'output'
        env = {**os.environ, 'GITHUB_OUTPUT': str(output)}
        step = by_id(self.candidate, 'plan')['run']
        for body, expected in (("print('docs')", 0), ("print('fast')", 0), ("print('critical')", 0), ("print('full')", 0),
                               ("print('bogus')", 1), ("print('')", 1),
                               ("print('docs\\nfull')", 1), ('raise RuntimeError()', 1)):
            with self.subTest(body=body):
                script.write_text(body)
                output.unlink(missing_ok=True)
                r = subprocess.run(['bash', '-c', step], cwd=self.root, env=env, capture_output=True)
                self.assertEqual(r.returncode == 0, expected == 0)
                if expected:
                    self.assertFalse(output.exists())
                else:
                    self.assertIn(output.read_text(), ('profile=docs\n', 'profile=fast\n', 'profile=critical\n', 'profile=full\n'))


class FullOnlyTests(unittest.TestCase):
    def test_list_is_unique_and_every_name_exists_in_the_api_suite(self):
        names = POLICY['FULL_ONLY_TESTS']
        self.assertTrue(names)
        self.assertEqual(len(names), len(set(names)))
        texts = '\n'.join(path.read_text(encoding='utf-8')
                          for path in (ROOT / 'apps/api/src').glob('*.test.ts'))
        for name in names:
            self.assertIn(name, texts)
        self.assertEqual(len(names), 33)
        self.assertEqual(POLICY['full_only_expected'](), 36)
        for prefix in POLICY['FULL_ONLY_PREFIXES']:
            self.assertIn(prefix, texts)

    def test_pattern_excludes_every_full_only_test_and_keeps_a_control(self):
        pattern = POLICY['full_only_pattern']()
        for name in POLICY['FULL_ONLY_TESTS']:
            self.assertIsNone(re.fullmatch(pattern, name))
        for suffix in ('bundle.tmp/auth.key', 'database.sqlite/bundle.tmp', 'database #?.sqlite/key #?.bin'):
            self.assertIsNone(re.fullmatch(
                pattern, '31 S3: reserved-name rejection / encrypted restore for ' + suffix))
        self.assertIsNotNone(re.fullmatch(pattern, 'AC01: a regular critical test'))


class CiResultTests(unittest.TestCase):
    def test_all_result_combinations(self):
        for classification, baseline, full in itertools.product(
                ('docs', 'full', '', 'invalid'),
                ('success', 'failure', 'skipped', 'cancelled'),
                ('success', 'failure', 'skipped', 'cancelled')):
            expected = (classification, baseline, full) in (
                ('docs', 'success', 'skipped'), ('full', 'success', 'success'))
            self.assertEqual(POLICY['result_ok'](classification, baseline, full), expected)

    def test_final_cli_valid_paths_and_unexpected_skips_failures(self):
        command = ['python3', str(ROOT / 'scripts/ci_policy.py'), 'result']
        for classification, baseline, full in (
                ('docs', 'success', 'skipped'), ('full', 'success', 'success'),
                ('docs', 'failure', 'skipped'), ('full', 'success', 'skipped'),
                ('full', 'success', 'failure'), ('docs', 'skipped', 'skipped'),
                ('invalid', 'success', 'success'), ('', 'success', 'skipped'),
                ('docs', 'cancelled', 'skipped'), ('full', 'success', 'cancelled')):
            with self.subTest(classification=classification, baseline=baseline, full=full):
                env = {**os.environ, 'CI_CLASS': classification, 'CI_BASELINE': baseline, 'CI_FULL': full}
                r = subprocess.run(command, env=env, capture_output=True)
                expected = (classification, baseline, full) in (
                    ('docs', 'success', 'skipped'), ('full', 'success', 'success'))
                self.assertEqual(r.returncode == 0, expected)

    def test_single_job_result_matrix_rejects_every_missing_failed_skipped_cancelled_phase(self):
        gate = POLICY['ci_result_ok']
        for profile in ('docs', 'fast', 'critical', 'full'):
            states = {name: 'success' for name in ('context','snapshot','plan','baseline','verify')}
            states.update({name: 'success' if profile != 'docs' else 'skipped' for name in ('bun','install')})
            states['prepare'] = 'success' if profile == 'full' else 'skipped'
            states['browser'] = 'success' if profile == 'full' else 'skipped'
            self.assertTrue(gate(profile, states))
            for name in states:
                for value in ('success','skipped','failure','cancelled','timed_out',''):
                    if value != states[name]: self.assertFalse(gate(profile, {**states,name:value}))
                incomplete = dict(states); incomplete.pop(name); self.assertFalse(gate(profile, incomplete))
            self.assertFalse(gate('invalid', states))



class CiContextTests(unittest.TestCase):
    def setUp(self):
        self.repository = 'fixture/project'
        self.head = 'a' * 40
        self.event = {'after': self.head, 'ref': 'refs/heads/feature',
                      'repository': {'default_branch': 'main'}}
        self.pr = {'number': 7, 'state': 'open', 'base': {'ref': 'main'},
                   'head': {'repo': {'full_name': self.repository}, 'ref': 'feature', 'sha': self.head}}

    def choose(self, event=None, pulls=None, name='push'):
        return CONTEXT['select_ref'](name, self.event if event is None else event,
                                     self.repository, lambda *_: [] if pulls is None else pulls)

    def test_push_without_pr_main_test_tag_manual_and_pr_keep_validation(self):
        self.assertEqual(self.choose(), self.head)
        for ref in ('refs/heads/main', 'refs/heads/test'):
            event = {**self.event, 'ref': ref}
            def forbidden(*_):
                self.fail('integration branches must not need a PR lookup')
            self.assertEqual(CONTEXT['select_ref']('push', event, self.repository, forbidden), self.head)
        # Tags keep their ref so an annotated tag is checked out and peeled.
        tag_event = {**self.event, 'ref': 'refs/tags/deploy-test-v1.2.3'}
        self.assertEqual(CONTEXT['select_ref']('push', tag_event, self.repository,
                                               lambda *_: self.fail('tags must not need a PR lookup')),
                         'refs/tags/deploy-test-v1.2.3')
        with self.assertRaises(ValueError):
            CONTEXT['select_ref']('push', {**self.event, 'ref': 'refs/tags/'}, self.repository, lambda *_: [])
        for malformed in ('refs/tags/deploy-test-v1.2', 'refs/tags/deploy-test-v01.2.3'):
            with self.subTest(malformed=malformed), self.assertRaises(ValueError):
                CONTEXT['select_ref']('push', {**self.event, 'ref': malformed}, self.repository, lambda *_: [])
        self.assertIsNone(self.choose(name='workflow_dispatch'))
        for base in ('main', 'test'):
            event = {'number': 7, 'pull_request': {'base': {'ref': base}, 'head': {'sha': self.head}}}
            self.assertEqual(self.choose(event, name='pull_request'), 'refs/pull/7/merge')
        for base in ('feature', 'other', ''):
            event = {'number': 7, 'pull_request': {'base': {'ref': base}, 'head': {'sha': self.head}}}
            with self.assertRaises(ValueError):
                self.choose(event, name='pull_request')

    def test_surviving_push_and_pr_use_same_integration_ref(self):
        self.assertEqual(self.choose(pulls=[self.pr]), 'refs/pull/7/merge')
        event = {'number': 7, 'pull_request': {'base': {'ref': 'main'}, 'head': {'sha': self.head}}}
        self.assertEqual(self.choose(pulls=[self.pr]), self.choose(event, name='pull_request'))

    def test_push_to_integration_branch_ignores_open_promotion_pr(self):
        for ref in ('refs/heads/main', 'refs/heads/test'):
            def forbidden(*_):
                self.fail('an integration push must freeze its own SHA')
            self.assertEqual(CONTEXT['select_ref']('push', {**self.event, 'ref': ref},
                                                   self.repository, forbidden), self.head)

    def test_lookup_error_stale_head_multiple_or_incomplete_is_not_silently_ignored(self):
        bad = copy.deepcopy(self.pr)
        bad['head']['sha'] = 'b' * 40
        for pulls in ([bad], [self.pr, {**self.pr, 'number': 8}], [self.pr] * 100, [{}], {}):
            with self.subTest(pulls=str(pulls)[:30]), self.assertRaises((ValueError, KeyError, TypeError)):
                self.choose(pulls=pulls)
        with self.assertRaises(OSError):
            CONTEXT['select_ref']('push', self.event, self.repository,
                                  lambda *_: (_ for _ in ()).throw(OSError('API failure')))

    def test_cli_errors_are_visible_and_redacted(self):
        with tempfile.TemporaryDirectory() as tmp:
            event = Path(tmp) / 'event.json'
            event.write_text(json.dumps({**self.event, 'after': '0' * 40}))
            output = Path(tmp) / 'output'
            env = {**os.environ, 'GITHUB_EVENT_PATH': str(event), 'GITHUB_EVENT_NAME': 'push',
                   'GITHUB_REPOSITORY': self.repository, 'GITHUB_OUTPUT': str(output),
                   'GH_TOKEN': 'fictional-token-for-redaction'}
            r = subprocess.run(['python3', str(ROOT / 'scripts/ci_context.py')], env=env, capture_output=True)
            self.assertNotEqual(r.returncode, 0)
            self.assertFalse(output.exists())
            self.assertNotIn(env['GH_TOKEN'].encode(), r.stdout + r.stderr)

    def test_concurrency_cancels_only_superseded_prs_and_isolates_tag_and_manual_runs(self):
        # Evaluate only the expression grammar used by the reviewed recipe; no eval().
        import re
        def value(expression, context):
            if ' || ' in expression:
                for part in expression.split(' || '):
                    item = value(part, context)
                    if item:
                        return item
                return ''
            if ' && ' in expression:
                result = True
                for part in expression.split(' && '):
                    result = value(part, context) if result else False
                return result
            for op in (' != ', ' == '):
                if op in expression:
                    a, b = expression.split(op)
                    return (value(a, context) != value(b, context)) if op == ' != ' else (value(a, context) == value(b, context))
            if expression.startswith("'"):
                return expression[1:-1]
            node = context
            for part in expression.split('.'):
                node = node.get(part, {}) if isinstance(node, dict) else {}
            return node if node != {} else ''
        def render(template, context):
            return re.sub(r'\$\{\{ (.*?) \}\}', lambda m: str(value(m[1], {'github': context})), template)
        policy = json.loads(CANDIDATE.read_text())['concurrency']
        push = {'workflow': 'Validate project', 'repository': self.repository, 'event': {},
                'ref_name': 'feature', 'ref': 'refs/heads/feature', 'head_ref': '',
                'event_name': 'push', 'run_id': 1, 'ref_type': 'branch'}
        main_push = {**push, 'ref_name': 'main', 'ref': 'refs/heads/main'}
        test_push = {**push, 'ref_name': 'test', 'ref': 'refs/heads/test'}
        pr = {**push, 'event_name': 'pull_request', 'head_ref': 'feature', 'ref_name': '7/merge',
              'ref': 'refs/pull/7/merge', 'event': {'pull_request': {'head': {'repo': {'full_name': self.repository}}}}}
        promotion = {**pr, 'head_ref': 'test', 'ref_name': '9/merge', 'ref': 'refs/pull/9/merge'}
        tag = {**push, 'ref_type': 'tag', 'ref_name': 'deploy-test-v1.2.3',
               'ref': 'refs/tags/deploy-test-v1.2.3'}
        # Automatic branch pushes no longer trigger this workflow; PRs keep their
        # own group and deploy tag/manual runs never cancel or get cancelled.
        self.assertNotEqual(render(policy['group'], main_push), render(policy['group'], test_push))
        self.assertNotEqual(render(policy['group'], test_push), render(policy['group'], pr))
        fork = copy.deepcopy(pr)
        fork['event']['pull_request']['head']['repo']['full_name'] = 'other/project'
        self.assertNotEqual(render(policy['group'], pr), render(policy['group'], fork))
        self.assertNotEqual(render(policy['group'], push), render(policy['group'], tag))
        self.assertNotEqual(render(policy['group'], push), render(policy['group'], promotion))
        manual = {**push, 'event_name': 'workflow_dispatch'}
        self.assertNotEqual(render(policy['group'], push), render(policy['group'], manual))
        expr = policy['cancel-in-progress'][4:-3]
        self.assertTrue(value(expr, {'github': pr}))
        self.assertTrue(value(expr, {'github': promotion}))
        self.assertFalse(value(expr, {'github': main_push}))
        self.assertFalse(value(expr, {'github': test_push}))
        self.assertFalse(value(expr, {'github': tag}))
        self.assertFalse(value(expr, {'github': manual}))


class CiLinuxTests(unittest.TestCase):
    def setUp(self):
        self.calls = []
        self.missing = set()

    def execute(self, command):
        self.calls.append(command)
        if command[:2] == ['node', 'node_modules/@playwright/test/cli.js']:
            return SimpleNamespace(returncode=0, stdout='Version 1.64.1\n', stderr='')
        if command[0] == 'dpkg-query':
            package = command[-1]
            if package in self.missing:
                return SimpleNamespace(returncode=1, stdout='', stderr=f'dpkg-query: no packages found matching {package}\n')
            return SimpleNamespace(returncode=0, stdout='installed', stderr='')
        return SimpleNamespace(returncode=0, stdout='', stderr='')

    def prepare(self, execute=None, **kwargs):
        return LINUX['prepare'](ROOT, execute or self.execute,
                                os_release=kwargs.get('os_release', 'ID=ubuntu\nVERSION_ID="24.04"\n'),
                                machine=kwargs.get('machine', 'x86_64'))

    def test_present_packages_do_not_touch_apt(self):
        self.assertEqual(self.prepare(), [])
        self.assertFalse(any(c[0] == 'sudo' for c in self.calls))

    def test_only_missing_packages_and_age_share_one_apt_update(self):
        self.missing = {'age', 'fonts-wqy-zenhei'}
        self.assertEqual(set(self.prepare()), self.missing)
        commands = [c for c in self.calls if c[0] == 'sudo']
        self.assertEqual(len(commands), 2)
        self.assertEqual(commands[0], ['sudo', 'apt-get', '-o', 'Acquire::Retries=3',
                                       '-o', 'DPkg::Lock::Timeout=120', 'update'])
        self.assertEqual(set(commands[1][10:]), self.missing)
        self.assertEqual(commands[1][:10], ['sudo', 'apt-get', '-o', 'Acquire::Retries=3',
                                            '-o', 'DPkg::Lock::Timeout=120', 'install', '-y',
                                            '--no-install-recommends', '--'])

    def test_prepare_always_uses_the_full_plan_and_checks_playwright(self):
        self.missing = {'age'}
        self.prepare()
        self.assertTrue(any(c[:2] == ['node', 'node_modules/@playwright/test/cli.js'] for c in self.calls))
        installs = [c for c in self.calls if c[:2] == ['sudo', 'apt-get'] and 'install' in c]
        self.assertIn('age', installs[0])
        # No API-only mode survives: every preparation is the full dependency plan.
        self.assertNotIn('api', [c for call in self.calls for c in call])

    def test_unsupported_runner_version_inventory_or_installation_fails(self):
        for kwargs in ({'os_release': 'ID=ubuntu\nVERSION_ID=26.04'}, {'machine': 'aarch64'}):
            with self.assertRaises(ValueError):
                self.prepare(**kwargs)
        for failure in ('version', 'inventory', 'apt'):
            self.missing = {'age'}
            def broken(command):
                result = self.execute(command)
                if ((failure == 'version' and command[0] == 'node')
                        or (failure == 'inventory' and command[0] == 'dpkg-query')
                        or (failure == 'apt' and command[0] == 'sudo')):
                    return SimpleNamespace(returncode=2, stdout='', stderr='failure')
                return result
            with self.subTest(failure=failure), self.assertRaises(ValueError):
                self.prepare(broken)

    def test_apt_lock_failure_reports_command_code_and_stderr(self):
        self.missing = {'age'}
        lock = 'E: Could not get lock /var/lib/dpkg/lock-frontend'
        def locked(command):
            result = self.execute(command)
            if command[:2] == ['sudo', 'apt-get']:
                return SimpleNamespace(returncode=100, stdout='', stderr=lock + '\n')
            return result
        with self.assertRaises(ValueError) as caught:
            self.prepare(locked)
        message = str(caught.exception)
        self.assertIn('sudo apt-get -o Acquire::Retries=3 -o DPkg::Lock::Timeout=120 update', message)
        self.assertIn('100', message)
        self.assertIn(lock, message)

    def test_inventory_failure_reports_command_code_and_stderr(self):
        detail = 'dpkg-query: error: failed to open package info file'
        def broken(command):
            result = self.execute(command)
            if command[:1] == ['dpkg-query']:
                return SimpleNamespace(returncode=2, stdout='', stderr=detail + '\n')
            return result
        with self.assertRaises(ValueError) as caught:
            self.prepare(broken)
        message = str(caught.exception)
        self.assertIn('dpkg-query -W -f=${db:Status-Status}', message)
        self.assertIn('exited 2', message)
        self.assertIn(detail, message)

    def test_unexpected_inventory_failure_never_reaches_install(self):
        def broken(command):
            result = self.execute(command)
            if command[:1] == ['dpkg-query']:
                return SimpleNamespace(returncode=2, stdout='', stderr='inventory unavailable')
            return result
        with self.assertRaises(ValueError):
            self.prepare(broken)
        self.assertFalse(any(c[:2] == ['sudo', 'apt-get'] for c in self.calls))

    def test_main_prints_error_detail_before_generic_failure(self):
        detail = 'command sudo apt-get update exited 100; stderr: lock'
        def broken(*args, **kwargs):
            raise ValueError(detail)
        original = LINUX['main'].__globals__['prepare']
        LINUX['main'].__globals__['prepare'] = broken
        try:
            with contextlib.redirect_stderr(io.StringIO()) as err, \
                    contextlib.redirect_stdout(io.StringIO()):
                status = LINUX['main']()
        finally:
            LINUX['main'].__globals__['prepare'] = original
        lines = err.getvalue().splitlines()
        self.assertEqual(status, 1)
        self.assertEqual(lines[0], 'CI Linux preparation detail: ' + detail)
        self.assertEqual(lines[-1], 'CI Linux preparation failed; browser checks must not be skipped.')

    def test_manifest_version_drift_is_rejected_before_install(self):
        with tempfile.TemporaryDirectory() as tmp:
            root = Path(tmp)
            (root / 'scripts').mkdir()
            shutil.copy2(ROOT / 'scripts/ci-linux-packages.json', root / 'scripts/ci-linux-packages.json')
            (root / 'package.json').write_text(json.dumps({'devDependencies': {'@playwright/test': '0.0.0'}}))
            with self.assertRaises(ValueError):
                LINUX['prepare'](root, self.execute, os_release='ID=ubuntu\nVERSION_ID=24.04', machine='x86_64')
            self.assertEqual(self.calls, [])


class RootlessWorkflowTests(unittest.TestCase):
    """The deploy workflow may only build and deploy; suites live in the profiles."""

    def setUp(self):
        tmp = tempfile.TemporaryDirectory()
        self.addCleanup(tmp.cleanup)
        self.root = Path(tmp.name)
        self.source = (ROOT / '.github/workflows/rootless.yml').read_text()

    def errors(self, text):
        path = self.root / 'rootless.yml'
        path.write_text(text)
        return WORKFLOW['validate_rootless_workflow'](path)

    def test_actual_workflow_is_reviewed_and_has_no_application_job(self):
        self.assertEqual(self.errors(self.source), [])
        self.assertEqual(WORKFLOW['validate_rootless_workflow'](
            ROOT / '.github/workflows/rootless.yml'), [])

    def test_reject_reintroduced_application_jobs_and_weakened_guards(self):
        replacements = {
            're-added qa job': ('  deploy:\n', '  qa:\n    needs: capability\n    steps:\n'
                                              '      - run: bun test apps/web\n\n  deploy:\n'),
            'weakened dependency': ('needs: [capability]', 'needs: [capability, qa]'),
            'removed smoke': ('infra/smoke.py', 'echo smoke'),
            'removed evidence': ('--qa-equivalence', '--check-evidence'),
            'removed tag wait': ("Wait for the tag's own required FULL validation", 'echo wait'),
            'unpinned action': ('actions/checkout@11d5960a326750d5838078e36cf38b85af677262',
                                'actions/checkout@v4'),
            'postmerge push': ("  push:\n    tags:\n", "  push:\n    branches:\n      - test\n    tags:\n"),
            'allowed failure': ('    timeout-minutes: 60\n',
                                '    timeout-minutes: 60\n    continue-on-error: true\n'),
            'persisted credentials': ('persist-credentials: false',
                                      'persist-credentials: true'),
            'narrowed paths': ("      - 'bun.lock'\n", ''),
            'external environment': ('environment: test', 'environment: production'),
        }
        for name, (old, new) in replacements.items():
            with self.subTest(name=name):
                self.assertIn(old, self.source)
                self.assertTrue(self.errors(self.source.replace(old, new, 1)))

    def test_unreadable_workflow_fails_visibly(self):
        self.assertEqual(WORKFLOW['validate_rootless_workflow'](self.root / 'missing'),
                         ['rootless: unreadable workflow'])
        (self.root / 'empty.yml').write_text('name: Empty\n')
        self.assertTrue(WORKFLOW['validate_rootless_workflow'](self.root / 'empty.yml'))


if __name__ == '__main__':
    unittest.main(verbosity=2)
