#!/usr/bin/env python3
"""Validate the Git facts and raw-log inventory of local QA evidence.

This is deliberately a checker, not a second evidence registry. The coordinator
records the command, environment and raw logs in the existing testplan/checkpoint;
this program only refuses stale, dirty or incomplete evidence. It cannot prove
that a log is authentic: independent QA still inspects the raw output.

The --qa-equivalence mode is a different check: it proves that the integration
commit contains exactly the content of an independently reviewed commit and that
the declared QA reference is a real GitHub artifact bound to that commit and its
pull request. Reusing QA evidence this way never substitutes independent QA,
merge approval or deployment authorization.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from urllib.parse import urlparse

ROOT = Path(__file__).resolve().parents[1]
SHA = re.compile(r'[0-9a-f]{40}')
REPOSITORY = re.compile(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+')
REVIEW = re.compile(r'pullrequestreview-([0-9]+)')
DISCUSSION = re.compile(r'discussion_r([0-9]+)')
ISSUE_COMMENT = re.compile(r'issuecomment-([0-9]+)')
COMMIT_COMMENT = re.compile(r'commitcomment-([0-9]+)')
VERDICT = 'qa=APTO'


def git(root, *args):
    return subprocess.run(['git', '-C', str(root), *args], text=True,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)


def require(condition, message):
    if not condition:
        raise ValueError(message)


def full_sha(value, label):
    require(SHA.fullmatch(value or '') is not None, f'{label} must be a full commit SHA')
    return value


def pairs(values, label):
    result = {}
    for value in values or ():
        name, separator, path = value.partition('=')
        if not separator or not name or not path:
            raise ValueError(f'invalid {label} entry; expected name=path')
        if name in result:
            raise ValueError(f'duplicate {label} entry: {name}')
        result[name] = Path(path)
    return result


def commit_exists(root, sha):
    return git(root, 'cat-file', '-e', sha + '^{commit}').returncode == 0


def tree_oid(root, sha):
    result = git(root, 'rev-parse', sha + '^{tree}')
    require(result.returncode == 0, f'cannot resolve the tree of {sha}')
    return result.stdout.strip()


def commit_parents(root, sha):
    result = git(root, 'rev-list', '--parents', '-n', '1', sha)
    require(result.returncode == 0, f'cannot resolve the parents of {sha}')
    return result.stdout.split()[1:]


def ancestry(root, ancestor, descendant):
    result = git(root, 'merge-base', '--is-ancestor', ancestor, descendant)
    if result.returncode == 0:
        return True
    if result.returncode == 1:
        return False
    raise ValueError(f'cannot resolve ancestry between {ancestor} and {descendant}')


def merge_tree(root, base, other):
    """Return the clean merge tree of both commits, or None when it conflicts."""
    result = git(root, 'merge-tree', '--write-tree', base, other)
    if result.returncode != 0:
        return None
    value = result.stdout.split()
    if not value or SHA.fullmatch(value[0]) is None:
        return None
    return value[0]


def api(endpoint):
    result = subprocess.run(['gh', 'api', endpoint], text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    require(result.returncode == 0,
            'QA evidence lookup failed for ' + endpoint + '; publish real evidence first')
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise ValueError('QA evidence lookup returned invalid JSON: ' + str(error))


def check_evidence_artifact(repository, pull_request, reviewed, url):
    """Require a real GitHub artifact bound to the reviewed commit and its PR."""
    parsed = urlparse(url)
    require(parsed.scheme == 'https' and parsed.netloc == 'github.com',
            'QA evidence must be an https://github.com URL')
    parts = [part for part in parsed.path.split('/') if part]
    require(len(parts) >= 4 and parts[0] + '/' + parts[1] == repository,
            'QA evidence belongs to another repository')
    kind, identifier, fragment = parts[2], parts[3], parsed.fragment

    def author(data):
        return (data.get('user') or {}).get('login') or 'unknown'

    if kind == 'pull':
        require(identifier.isdigit() and int(identifier) == pull_request,
                'QA evidence does not belong to the declared pull request')
        match = REVIEW.fullmatch(fragment)
        if match:
            data = api(f'repos/{repository}/pulls/{pull_request}/reviews/{match.group(1)}')
            require(data.get('commit_id') == reviewed,
                    'QA review does not belong to the reviewed commit')
            require(data.get('state') in ('APPROVED', 'COMMENTED'),
                    'QA review must be published as APPROVED or COMMENTED')
            require(data.get('state') == 'APPROVED'
                    or VERDICT in (data.get('body') or ''),
                    'QA review must be APPROVED or declare qa=APTO')
            return 'review:' + match.group(1), author(data)
        match = DISCUSSION.fullmatch(fragment)
        if match:
            data = api(f'repos/{repository}/pulls/comments/{match.group(1)}')
            require(str(data.get('pull_request_url', '')).endswith(f'/pulls/{pull_request}'),
                    'QA review comment does not belong to the declared pull request')
            require(reviewed in (data.get('commit_id'), data.get('original_commit_id')),
                    'QA review comment does not belong to the reviewed commit')
            require(VERDICT in (data.get('body') or ''),
                    'QA review comment must declare qa=APTO')
            return 'review-comment:' + match.group(1), author(data)
        match = ISSUE_COMMENT.fullmatch(fragment)
        if match:
            data = api(f'repos/{repository}/issues/comments/{match.group(1)}')
            require(str(data.get('issue_url', '')).endswith(f'/issues/{pull_request}'),
                    'QA comment does not belong to the declared pull request')
            body = data.get('body') or ''
            require(VERDICT in body, 'QA comment must declare qa=APTO')
            require(f'reviewed={reviewed}' in body,
                    'QA comment must name the reviewed commit as reviewed=<sha>')
            return 'issue-comment:' + match.group(1), author(data)
        raise ValueError('QA evidence must point to a review, review comment or PR comment')

    if kind == 'commit':
        require(identifier.lower() == reviewed,
                'QA evidence commit differs from the reviewed commit')
        match = COMMIT_COMMENT.fullmatch(fragment)
        require(match is not None, 'QA evidence must point to a commit comment')
        data = api(f'repos/{repository}/comments/{match.group(1)}')
        require(data.get('commit_id') == reviewed,
                'QA commit comment does not belong to the reviewed commit')
        require(VERDICT in (data.get('body') or ''),
                'QA commit comment must declare qa=APTO')
        return 'commit-comment:' + match.group(1), author(data)

    raise ValueError('QA evidence must be a pull request or commit URL in this repository')


def qa_equivalence(args):
    """Reuse QA of a reviewed commit when the integration tree contains it exactly."""
    root = args.root.resolve()
    integration = full_sha(args.integration, 'integration')
    reviewed = full_sha(args.reviewed, 'reviewed')
    require(args.pr is not None and args.pr > 0, 'a positive --pr is required')
    require(bool(args.evidence), '--evidence is required')
    repository = args.repository or os.getenv('GITHUB_REPOSITORY', '')
    require(REPOSITORY.fullmatch(repository) is not None, 'repository owner/name is required')
    for value, label in ((integration, 'integration'), (reviewed, 'reviewed')):
        require(commit_exists(root, value), f'{label} commit is unavailable: {value}')

    artifact, evidence_author = check_evidence_artifact(repository, args.pr, reviewed,
                                                       args.evidence)
    pull = api(f'repos/{repository}/pulls/{args.pr}')
    require(pull.get('merged') is True, f'pull request #{args.pr} is not merged')
    head = (pull.get('head') or {}).get('sha') or ''
    require(SHA.fullmatch(head) is not None,
            f'pull request #{args.pr} head SHA is unavailable')
    require(commit_exists(root, head),
            f'pull request head {head} is unavailable; fetch refs/pull/{args.pr}/head first')
    require(ancestry(root, reviewed, head),
            'reviewed commit is not part of the declared pull request')

    target = tree_oid(root, integration)
    parents = commit_parents(root, integration)
    if tree_oid(root, reviewed) == target:
        mode = 'tree'
    else:
        require(bool(parents), 'integration commit has no parent')
        require(merge_tree(root, parents[0], reviewed) == target,
                'integration tree is not the reviewed content composed onto its first '
                'parent; a conflict resolution, extra change or different commit '
                'requires new independent QA')
        mode = 'merge'

    # These guards apply to both modes: an empty integration commit, or a reviewed
    # commit that the base already contains, cannot carry the deployed content even
    # when the trees happen to match.
    if parents:
        parent = parents[0]
        require(not ancestry(root, reviewed, parent),
                'reviewed commit is already contained in the integration base and '
                'contributes no deployed content; new independent QA is required')
        require(tree_oid(root, parent) != target,
                'integration commit does not change the tree and cannot carry the '
                'reviewed content; new independent QA is required')

    reference = (f'reviewed={reviewed} integration={integration} '
                 f'pr={args.pr} qa={args.evidence}')
    print('QA equivalence PASS')
    print('mode=' + mode)
    print('integration=' + integration)
    print('reviewed=' + reviewed)
    print('tree=' + target)
    print('evidence=' + artifact)
    print('evidence_author=' + evidence_author)
    print('qa_reference=' + reference)
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--qa-equivalence', action='store_true',
                        help='reuse QA of --reviewed when --integration contains it exactly')
    parser.add_argument('--integration', help='commit that will be tagged and deployed')
    parser.add_argument('--reviewed', help='independently reviewed commit SHA')
    parser.add_argument('--pr', type=int, help='pull request number of the reviewed commit')
    parser.add_argument('--evidence', help='GitHub URL of the independent QA evidence')
    parser.add_argument('--repository', help='owner/name of the GitHub repository')
    parser.add_argument('--candidate')
    parser.add_argument('--base')
    parser.add_argument('--environment',
                        help='tested environment, for example linux-debian13-glibc')
    parser.add_argument('--base-ref', help='optional ref that must equal --base')
    parser.add_argument('--linux-required', default='',
                        help='comma-separated log names that require a Linux/glibc environment')
    parser.add_argument('--log', action='append', default=[], metavar='NAME=PATH')
    parser.add_argument('--record', action='append', default=[], metavar='PATH',
                        help='existing testplan/checkpoint that must name candidate and base')
    parser.add_argument('--root', type=Path, default=ROOT)
    args = parser.parse_args(argv)
    try:
        if args.qa_equivalence:
            return qa_equivalence(args)
        require(args.candidate and args.base and args.environment,
                'candidate, base and environment are required')
        root = args.root.resolve()
        require(SHA.fullmatch(args.candidate or '') is not None, 'candidate must be a full commit SHA')
        require(SHA.fullmatch(args.base or '') is not None, 'base must be a full commit SHA')
        head = git(root, 'rev-parse', 'HEAD')
        require(head.returncode == 0 and head.stdout.strip() == args.candidate,
                'candidate differs from HEAD')
        status = git(root, 'status', '--porcelain=v1', '-z', '--untracked-files=all')
        require(status.returncode == 0 and not status.stdout,
                'working tree is dirty or untracked files are present')
        commit = git(root, 'cat-file', '-e', args.base + '^{commit}')
        require(commit.returncode == 0, 'base commit is unavailable')
        ancestor = git(root, 'merge-base', '--is-ancestor', args.base, args.candidate)
        require(ancestor.returncode == 0, 'base is not an ancestor of candidate')
        if args.base_ref:
            ref = git(root, 'rev-parse', args.base_ref)
            require(ref.returncode == 0 and ref.stdout.strip() == args.base,
                    'base is not the current integration ref')

        logs = pairs(args.log, 'log')
        require(bool(logs), 'at least one raw log is required')
        digests = {}
        for name, path in logs.items():
            require(path.is_file() and path.stat().st_size > 0,
                    f'log is missing or empty: {name}')
            digests[name] = hashlib.sha256(path.read_bytes()).hexdigest()

        linux = [name.strip() for name in args.linux_required.split(',') if name.strip()]
        if linux:
            environment = args.environment.lower()
            require('linux' in environment and ('debian' in environment or 'glibc' in environment),
                    'Linux/glibc environment is required for: ' + ', '.join(linux))
            missing = [name for name in linux if name not in logs]
            require(not missing, 'Linux-required logs are missing: ' + ', '.join(missing))

        for record in args.record:
            path = Path(record)
            require(path.is_file(), f'record is missing: {record}')
            text = path.read_text(encoding='utf-8', errors='replace')
            require(args.candidate in text and args.base in text,
                    f'record does not name candidate and base: {record}')

        print('Evidence PASS')
        print('candidate=' + args.candidate)
        print('base=' + args.base)
        print('environment=' + args.environment)
        for name in sorted(logs):
            print(f'log.{name}.sha256={digests[name]}')
        return 0
    except (OSError, ValueError) as error:
        print('FAIL evidence: ' + str(error), file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
