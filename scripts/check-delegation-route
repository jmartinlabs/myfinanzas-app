#!/usr/bin/env python3
"""Read the effective route/model of a delegation from attributable runtime metadata.

A delegation that names a route is only valid if that route applied: a per-task route
parameter can fail to reach the tool, and the task then runs on the backend's default
route with no error at all. This check answers, from the client's own records, which
provider/model/effort each task ran on and whether it finished, and never emits PASS
without an explicit expectation to compare against.

Source: the Hermes profile's `state.db` → `async_delegations.result_json`, one entry per
task carrying `status` and `route.backend/label/provider/model/reasoning_effort`. No
network, no model calls, read-only.

Expectations are arguments, never constants: they come from the `options` entry the caller
dispatched with (name, provider, model, effort). The runtime does not persist that option —
it keeps the resolved route per task and `task_json.model`, the model resolved at dispatch —
so take the expected values from the option used at dispatch, not from the config as it
reads afterwards.

Exit codes: 0 every task finished and matched every requested expectation; 1 a task did
not finish successfully, or did not match, or the delegation never completed; 2 no verdict
is possible here (no expectation, no state.db, unreadable metadata, or malformed
`result_json`) — never a pass.

Examples:
    scripts/check-delegation-route --profile <profile> --delegation deleg_abc \
        --expect-label <option> --expect-provider <provider> --expect-effort <effort>
    scripts/check-delegation-route --state-db /tmp/state.db --latest --expect-label <option> --json
"""
import argparse
import json
import os
from pathlib import Path
import sqlite3
import sys

UNAVAILABLE = 2
EXPECTATIONS = ('label', 'model', 'provider', 'effort')


class Unavailable(Exception):
    """No verdict is possible here: unreadable or malformed metadata. Never a pass."""


def state_db_path(args):
    """`--state-db` wins, then `--profile`, then `HERMES_HOME`; nothing is guessed."""
    if args.state_db:
        return Path(args.state_db).expanduser()
    if args.profile:
        return Path.home() / '.hermes' / 'profiles' / args.profile / 'state.db'
    home = os.environ.get('HERMES_HOME', '').strip()
    return Path(home) / 'state.db' if home else None


def read_delegation(path, delegation):
    """`(delegation_id, state, results)` for one delegation; `--latest` picks the newest."""
    if path is None or not path.is_file():
        raise Unavailable(f'no state.db at {path or "HERMES_HOME unset"}')
    try:
        connection = sqlite3.connect(f'file:{path}?mode=ro', uri=True)
    except sqlite3.Error as error:
        raise Unavailable(f'cannot open {path}: {error}')
    try:
        if delegation:
            row = connection.execute(
                'select delegation_id, state, result_json from async_delegations where delegation_id = ?',
                (delegation,)).fetchone()
        else:
            row = connection.execute(
                'select delegation_id, state, result_json from async_delegations '
                'order by coalesce(completed_at, dispatched_at) desc limit 1').fetchone()
    except sqlite3.Error as error:
        raise Unavailable(f'cannot read {path}: {error}')
    finally:
        connection.close()
    if row is None:
        raise Unavailable(f'delegation {delegation or "latest"} not found in {path}')
    delegation_id, state, raw = row
    try:
        payload = json.loads(raw) if raw else {}
    except (TypeError, ValueError) as error:
        raise Unavailable(f'delegation {delegation_id} has unreadable result_json: {error}')
    if not isinstance(payload, dict):
        raise Unavailable(f'delegation {delegation_id} result_json is not an object')
    results = payload.get('results')
    if results is None:
        return delegation_id, state, []
    if not isinstance(results, list):
        raise Unavailable(f'delegation {delegation_id} results is not a list')
    return delegation_id, state, results


def route_of(entry):
    route = entry.get('route') if isinstance(entry, dict) else None
    return route if isinstance(route, dict) else {}


def verdicts(results, expected):
    """One line per task: what ran, whether it finished and whether it is the route asked for."""
    lines, failures = [], 0
    for entry in results:
        route = route_of(entry)
        observed = {'label': route.get('label') or '', 'model': route.get('model') or '',
                    'provider': route.get('provider') or '',
                    'effort': route.get('reasoning_effort') or '',
                    'backend': route.get('backend') or ''}
        finished = (entry.get('status') if isinstance(entry, dict) else None) == 'completed'
        wrong = [] if finished else [f"status={entry.get('status') if isinstance(entry, dict) else '-'} (not completed)"]
        for key in EXPECTATIONS:
            if expected[key] and observed[key] != expected[key]:
                wrong.append(f'{key}={observed[key] or "-"} (expected {expected[key]})')
        status = 'FAIL' if wrong else 'PASS'
        failures += bool(wrong)
        lines.append({
            'task': entry.get('task_index') if isinstance(entry, dict) else None,
            'status': status, 'finished': finished, 'expected': expected,
            'observed': observed, 'reason': ', '.join(wrong)})
    return lines, failures


def main(argv=None):
    parser = argparse.ArgumentParser(
        description='Check the route, model, provider, effort and completion a delegation really had.')
    source = parser.add_mutually_exclusive_group()
    source.add_argument('--state-db', help='path to the profile state.db (default: $HERMES_HOME/state.db)')
    source.add_argument('--profile', help='Hermes profile name, e.g. engineering-lead')
    target = parser.add_mutually_exclusive_group()
    target.add_argument('--delegation', help='delegation id, e.g. deleg_27ce6a52')
    target.add_argument('--latest', action='store_true',
                        help='the most recent delegation (default); prefer --delegation <id> '
                             'while other sessions may also delegate')
    parser.add_argument('--expect-label', help='option name the tasks must have run on, e.g. advisor')
    parser.add_argument('--expect-model', help='exact model id the tasks must have run on')
    parser.add_argument('--expect-provider', help='provider the tasks must have run on')
    parser.add_argument('--expect-effort', help='reasoning effort the route must have carried, e.g. low')
    parser.add_argument('--json', action='store_true', help='print one JSON document')
    args = parser.parse_args(argv)

    expected = {'label': args.expect_label, 'model': args.expect_model,
                'provider': args.expect_provider, 'effort': args.expect_effort}
    if not any(expected.values()):
        print('SKIP no verdict: give at least one of --expect-label/--expect-model/'
              '--expect-provider/--expect-effort; PASS is never emitted without an expectation',
              file=sys.stderr)
        return UNAVAILABLE

    try:
        delegation_id, state, results = read_delegation(state_db_path(args), args.delegation)
    except Unavailable as error:
        print(f'SKIP delegation route unverified: {error}', file=sys.stderr)
        return UNAVAILABLE
    if not results:
        print(f'FAIL delegation {delegation_id} ({state}) has no results yet: not verified',
              file=sys.stderr)
        return 1
    if state != 'completed':
        print(f'FAIL delegation {delegation_id} state={state} (not completed): not verified',
              file=sys.stderr)
        return 1

    lines, failures = verdicts(results, expected)
    if args.json:
        print(json.dumps({'delegation': delegation_id, 'state': state, 'expected': expected,
                          'tasks': lines, 'failures': failures}, indent=2))
    else:
        for line in lines:
            observed = line['observed']
            detail = (f"backend={observed['backend']} label={observed['label'] or '-'} "
                      f"model={observed['model'] or '-'} provider={observed['provider'] or '-'} "
                      f"effort={observed['effort'] or '-'}")
            print(f"{line['status']} task={line['task']} {detail}"
                  + (f" — {line['reason']}" if line['reason'] else ''))
        print(f"delegation {delegation_id}: {len(lines) - failures}/{len(lines)} tasks finished on the requested route")
    return 1 if failures else 0


if __name__ == '__main__':
    sys.exit(main())