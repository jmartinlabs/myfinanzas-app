#!/usr/bin/env python3
"""Portable structural validation, not a complete security or semantic audit."""
from pathlib import Path
import re
import runpy
import sys
from urllib.parse import unquote, urlsplit
SKILLS = ('init-project', 'bootstrap', 'roadmap', 'spec', 'dev')
REQUIRED = ('AGENTS.md','README.md','NEW_PROJECT_PROMPT.md','.gitignore','.github/workflows/validate.yml','specs/README.md',
 *(f'specs/guidelines/{n}.md' for n in ('architecture','ui','quality','security')),
 *(f'templates/{n}.md' for n in ('brainstorming','specification','roadmap','progress','testplan')),
 *(f'.agents/skills/{n}/SKILL.md' for n in SKILLS),'scripts/validate-template','scripts/test-validator')
def validate(root):
 root=Path(root).resolve(); errors=[]
 def fail(rule,msg): errors.append(f'{rule}: {msg}')
 def read(name):
  p=root/name
  return p.read_text(encoding='utf-8') if p.is_file() else ''
 for name in REQUIRED:
  if not (root/name).is_file() or not (root/name).stat().st_size: fail('structure',f'missing or empty {name}')
 docs=[root/n for n in ('AGENTS.md','README.md','NEW_PROJECT_PROMPT.md') if (root/n).is_file()]
 for folder in ('specs','templates','.agents/skills'):
  docs.extend((root/folder).rglob('*.md'))
 for p in docs:
  s=p.read_text(encoding='utf-8')
  for dest in re.findall(r'(?<!!)\[[^\]\n]+\]\(([^)\n]+)\)',s):
   dest=dest.strip().split(' "',1)[0].strip('<>'); u=urlsplit(dest)
   if u.scheme or dest.startswith('#'): continue
   target=(p.parent/unquote(u.path)).resolve()
   if not target.is_relative_to(root) or not target.exists(): fail('links',f'{p.relative_to(root)} -> {dest}')
 agents=read('AGENTS.md')
 for n in ('architecture','ui','quality','security'):
  if f'(specs/guidelines/{n}.md)' not in agents: fail('agents',f'missing guideline {n}')
 if len(agents.splitlines())>65: fail('agents','AGENTS.md exceeds 65 lines')
 for name in SKILLS:
  s=read(f'.agents/skills/{name}/SKILL.md')
  m=re.match(r'\A---\nname: ([a-z0-9-]+)\ndescription: ([^\n]+)\n---\n',s)
  if not m or m[1]!=name or not 1<=len(m[2])<=1024: fail('manifest',f'{name}: invalid name/description')
  elif any(c in m[2] for c in (': ',' #','{','}','[',']')): fail('manifest',f'{name}: use plain scalar description')
  for h in ('## Inputs','## Outputs','## Procedure','## Stop conditions'):
   if h not in s: fail('contracts',f'{name}: missing {h}')
 s=read('.agents/skills/init-project/SKILL.md')
 for token in ('specs/setup-progress.md','### Resume protocol','## Pending decisions','## Confirmed decisions','## Next action','awaiting-approval',*(f'### Stage {i} —' for i in range(1,8))):
  if token not in s: fail('resume',f'init-project missing {token}')
 s=read('NEW_PROJECT_PROMPT.md'); m=re.search(r'```text\n(.*?)\n```',s,re.S)
 tokens=('[PROJECT_NAME]','[SHORT_DESCRIPTION]','https://github.com/','independent','AGENTS.md','$init-project','specs/setup-progress.md','owner','visibility','authorization','planning','$spec','$dev')
 if not m or any(t.lower() not in m[1].lower() for t in tokens): fail('prompt','incomplete copyable prompt')
 safety=docs+[root/n for n in ('PROMPT_BACKUP.md','PROMPT_BACKUP_COMPLETE.md','.gitignore','.github/workflows/validate.yml','scripts/validate-template','scripts/test-validator') if (root/n).is_file()]
 patterns=(r'-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----',r'\bgh[pousr]_[A-Za-z0-9]{30,}\b',r'\bgithub_pat_[A-Za-z0-9_]{30,}\b',r'\bAKIA[A-Z0-9]{16}\b',r'\bsk-[A-Za-z0-9]{32,}\b',r'(?im)^\s*(?:password|api_key|access_token|secret)\s*[:=]\s*["\']?[A-Za-z0-9+/=_-]{20,}')
 for p in safety:
  s=p.read_text(encoding='utf-8')
  if any(re.search(pat,s) for pat in patterns): fail('secrets',f'credential-like content in {p.relative_to(root)} (value withheld)')
  if re.search(r'/(?:Users|home|workspace)/[A-Za-z0-9_.-]+|[A-Z]:\\Users\\',s): fail('portability',f'machine-specific path in {p.relative_to(root)}')
 for p in [root/'AGENTS.md',*(root/'.agents/skills').rglob('SKILL.md')]:
  if p.is_file() and re.search(r'(?i)(?:all projects|every project|all applications) must (?:use|install|run)\b',p.read_text()): fail('neutrality',f'universal stack mandate in {p.relative_to(root)}')
 # The project workflow contract checks parsed structure/conditions, not token presence.
 try:
  policy=runpy.run_path(str(root/'scripts/ci_workflow.py'))
  errors.extend(policy['validate_workflow'](root/'.github/workflows/validate.yml',allow_legacy=True))
 except (OSError,ValueError): fail('ci','workflow policy unavailable')
 return errors
if __name__=='__main__':
 if len(sys.argv)>2: sys.exit('Usage: validate-template [repository-root]')
 try: errors=validate(sys.argv[1] if len(sys.argv)==2 else Path(__file__).resolve().parents[1])
 except (OSError,UnicodeError,ValueError) as e: sys.exit(f'Validation could not complete: {e}')
 for e in errors: print(e,file=sys.stderr)
 if errors: sys.exit(1)
 print('Template validation passed: structure, links, manifests, contracts, resume, prompt, safety heuristics and CI.')
