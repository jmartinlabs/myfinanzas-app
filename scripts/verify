#!/usr/bin/env python3
"""Canonical MyFinanzas local/CI verification; provisioning is separate."""
import argparse
import contextlib
import io
import json
import os
from pathlib import Path
import re
import runpy
import shutil
import subprocess
import sys
ROOT = Path(__file__).resolve().parents[1]
POLICY = runpy.run_path(str(ROOT / 'scripts/ci_policy.py'))
BASELINE = tuple((name, [sys.executable, 'scripts/' + name], 'unittest' if name.startswith('test-') else None) for name in (
    'check-repository', 'check-project', 'validate-template', 'test-checks',
    'test-validator', 'test-agent-relay', 'test-agent-usage', 'test-auto-agent-usage', 'test-verification',
    'test-evidence', 'test-release')) + (
    ('working-whitespace', ['git', 'diff', '--check'], None),
    ('commit-whitespace', ['git', 'show', '--format=', '--check', '--first-parent', 'HEAD'], None))
# Harness regressions read scripts, fixtures and protected instructions; a verified
# documentation-only comparison leaves all of those byte-identical. Every other
# baseline control (repository, project, template, links, whitespace) still runs.
HARNESS_SUITES = frozenset((
    'test-checks', 'test-validator', 'test-agent-relay', 'test-verification', 'test-evidence',
    'test-agent-usage', 'test-auto-agent-usage', 'test-release'))
APPLICATION = (('typecheck', ['bun', 'run', 'typecheck'], None),
               ('build', ['bun', 'run', 'build'], None),
               ('api', ['bun', 'run', 'test'], 'bun'),
               ('e2e', ['bun', 'run', 'test:e2e'], 'playwright'))
LEGACY_BRANCH = 'feat/07-ciclos-operacion'
ANSI = re.compile(r'\x1b\[[0-?]*[ -/]*[@-~]')

class VerificationError(ValueError):
    pass

def test_coverage(output, kind, expected_filtered=0):
    """A successful process is insufficient: pinned reporters must prove coverage."""
    output = ANSI.sub('', output)
    filtered = re.findall(r'(?m)^\s*(\d+) filtered out\s*$', output)
    if (int(filtered[-1]) if filtered else 0) != expected_filtered:
        return False
    if kind == 'bun':
        passed = re.findall(r'(?m)^\s*(\d+) pass\s*$', output)
        failures = re.findall(r'(?m)^\s*(\d+) fail\s*$', output)
        skipped = re.findall(r'(?m)^\s*(\d+) (?:skip|skipped|todo)\b', output)
        valid = len(passed) == 1 and int(passed[0]) > 0 and failures == ['0']
    elif kind == 'unittest':
        passed = re.findall(r'(?m)^Ran (\d+) tests? in ', output)
        skipped = re.findall(r'(?:skipped|expected failures|unexpected successes)=(\d+)', output)
        valid = len(passed) == 1 and int(passed[0]) > 0 and bool(re.search(r'(?m)^OK(?:\s|$)', output)) and not re.search(r'(?m)^FAILED', output)
    else:
        passed = re.findall(r'(?m)^\s*(\d+) passed(?:\s|$)', output)
        failures = re.findall(r'(?m)^\s*(\d+) (?:failed|interrupted)\b', output)
        skipped = re.findall(r'(?m)^\s*(\d+) (?:skipped|did not run|fixme)\b', output)
        valid = len(passed) == 1 and int(passed[0]) > 0 and not any(map(int, failures))
    return valid and not any(map(int, skipped))

def classification(args):
    if args.full:
        return 'full'
    command = ['classify']
    for flag in ('base', 'head'):
        value = getattr(args, flag)
        if value is not None:
            command.extend(['--' + flag, value])
    if args.pull_request:
        command.append('--pull-request')
    output = io.StringIO()
    with contextlib.redirect_stdout(output):
        code = POLICY['main'](command)
    value = output.getvalue().strip()
    if code != 0 or value not in ('docs', 'full'):
        raise VerificationError('Shared classifier failed or returned an invalid result.')
    if value == 'docs':
        # The comparison cannot authorize omission over a different local snapshot.
        status = subprocess.run(['git', 'status', '--porcelain=v1', '-z', '--untracked-files=all'],
                                cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        head = subprocess.run(['git', 'rev-parse', 'HEAD'], cwd=ROOT,
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if (status.returncode or status.stdout or head.returncode or
                (args.head and head.stdout.decode().strip() != args.head)):
            return 'full'
    return value

def legacy_required():
    names = [os.getenv('GITHUB_HEAD_REF'), os.getenv('GITHUB_REF_NAME')]
    if not any(names):
        result = subprocess.run(['git', 'branch', '--show-current'], cwd=ROOT,
                                text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        if result.returncode == 0:
            names.append(result.stdout.strip())
    return LEGACY_BRANCH in names

def baseline_checks(profile, checks=None):
    """Omit harness regressions only for a verified docs profile; all else runs them."""
    checks = BASELINE if checks is None else tuple(checks)
    return [check for check in checks
            if profile != 'docs' or check[0] not in HARNESS_SUITES]

def baseline_profile():
    """Reuse the shared CI selector; no verified context runs the complete baseline."""
    try:
        event = json.loads(Path(os.environ['GITHUB_EVENT_PATH']).read_text())
        profile = POLICY['ci_profile'](ROOT, os.environ['GITHUB_EVENT_NAME'], event,
                                       os.getenv('CI_CHECKOUT_REF'))
        if profile == 'docs':
            # A local dirty/untracked snapshot cannot inherit the committed comparison.
            status = subprocess.run(['git', 'status', '--porcelain=v1', '-z', '--untracked-files=all'],
                                    cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            if status.returncode or status.stdout:
                print('Baseline profile downgraded: working tree is not clean.', file=sys.stderr)
                return 'full'
        return profile
    except (OSError, ValueError, KeyError, TypeError, AttributeError, subprocess.SubprocessError):
        print('Baseline profile unavailable; running the complete baseline.', file=sys.stderr)
        return 'full'

def application_checks(profile='full'):
    if profile == 'critical':
        api = ['bun', 'test', 'apps/api', '--test-name-pattern',
               POLICY['full_only_pattern'](), '--pass-with-no-tests']
        filtered = len(POLICY['FULL_ONLY_TESTS'])
    else:
        api = ['bun', 'run', 'test']
        filtered = 0
    checks = [('typecheck', ['bun', 'run', 'typecheck'], None),
              ('build', ['bun', 'run', 'build'], None),
              ('api', api, 'bun', filtered),
              ('e2e', ['bun', 'run', 'test:e2e'], 'playwright')]
    if legacy_required():
        # Preserve explicit historical acceptance repeats, not duplicate core suites.
        legacy = [('legacy-ac23-' + str(i), ['bun', 'test', 'apps/api/src/movimientos.test.ts',
                   '--test-name-pattern', '04 AC22/23/28: dos procesos'], 'bun') for i in range(1, 6)]
        legacy.append(('legacy-continuity', ['bun', 'test', 'apps/api/src/cycle-operations.test.ts',
                       '--test-name-pattern', '07 O[457]'], 'bun'))
        checks[2:2] = legacy
    return checks

def run_checks(checks, prerequisites=()):
    missing = [tool for tool in prerequisites if shutil.which(tool) is None]
    if missing:
        print('FAIL prerequisites: ' + ', '.join(missing), file=sys.stderr)
        for check in checks:
            print('UNRUN ' + check[0])
        return False
    for index, check in enumerate(checks):
        name, command, reporter = check[:3]
        expected_filtered = check[3] if len(check) > 3 else 0
        print('RUN ' + name, flush=True)
        try:
            env = {**os.environ}
            if reporter == 'bun':
                env.setdefault('NODE_ENV', 'test')
            result = subprocess.run(command, cwd=ROOT, env=env, text=True,
                                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            print(result.stdout, end='' if result.stdout.endswith('\n') else '\n', flush=True)
            if result.returncode != 0:
                raise VerificationError('exit ' + str(result.returncode))
            if reporter and not test_coverage(result.stdout, reporter, expected_filtered):
                raise VerificationError('missing/zero test coverage or unexpected skips/failures (filtered count mismatch)')
            print('PASS ' + name, flush=True)
        except (OSError, VerificationError) as error:
            print('FAIL ' + name + ': ' + str(error), file=sys.stderr)
            for unrun in checks[index + 1:]:
                print('UNRUN ' + unrun[0])
            return False
    return True

def main(argv=None):
    if sys.version_info < (3, 10):
        print('FAIL prerequisite: Python 3.10+ is required for canonical verification.', file=sys.stderr)
        return 1
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('mode', nargs='?', choices=('all', 'classify', 'baseline', 'application', 'result', 'ci-plan', 'ci', 'ci-result'), default='all')
    parser.add_argument('--full', action='store_true', help='Force full; never provisions dependencies')
    parser.add_argument('--base')
    parser.add_argument('--head')
    parser.add_argument('--pull-request', action='store_true')
    args = parser.parse_args(argv)
    if args.mode not in ('all', 'classify') and (args.full or args.base or args.head or args.pull_request):
        parser.error('Comparison and forced-full flags belong to all/classify modes.')
    if args.mode == 'ci-result':
        names = ('context', 'snapshot', 'plan', 'baseline', 'verify', 'bun', 'install', 'prepare', 'browser')
        states = {name: os.getenv('CI_' + name.upper()) for name in names}
        ok = POLICY['ci_result_ok'](os.getenv('CI_PROFILE'), states)
        print('CI required result: ' + ('PASS' if ok else 'FAIL'))
        return 0 if ok else 1
    if args.mode in ('ci-plan', 'ci'):
        try:
            event = json.loads(Path(os.environ['GITHUB_EVENT_PATH']).read_text())
            profile = POLICY['ci_profile'](ROOT, os.environ['GITHUB_EVENT_NAME'], event, os.getenv('CI_CHECKOUT_REF'))
        except (OSError, ValueError, KeyError, TypeError) as error:
            raise VerificationError('CI context/profile unavailable; no successful omission') from error
        if args.mode == 'ci-plan':
            print(profile)
            return 0
        if profile == 'docs':
            print('INTENTIONALLY SKIPPED application checks: docs profile; local QA evidence is separate.')
            return 0
        if profile == 'full':
            checks = application_checks('full')
        elif profile == 'critical':
            checks = [check for check in application_checks('critical') if check[0] != 'e2e']
        else:
            checks = list(APPLICATION[:2])
        tools = ('bun', 'node', 'age', 'git') if profile == 'full' else (
            ('bun', 'node', 'git') if profile == 'critical' else ('bun', 'git'))
        ok = run_checks(checks, tools)
        print('CI profile ' + profile + ': ' + ('PASS' if ok else 'FAIL') + '; local full QA is a separate integration gate.')
        return 0 if ok else 1
    if args.mode == 'result':
        return POLICY['main'](['result'])
    if args.mode == 'baseline':
        profile = baseline_profile()
        print('Baseline profile: ' + profile)
        if profile == 'docs':
            print('INTENTIONALLY SKIPPED harness regressions: docs profile; critical/full retain them.')
        ok = run_checks(baseline_checks(profile), ('git',))
        print('Baseline phase: ' + ('PASS' if ok else 'FAIL') + '; application phase not included.')
        return 0 if ok else 1
    if args.mode == 'application':
        ok = run_checks(application_checks('full'), ('bun', 'node', 'age', 'git'))
        print('Application phase: ' + ('PASS' if ok else 'FAIL') + '; baseline phase not included.')
        return 0 if ok else 1
    selected = classification(args)
    if args.mode == 'classify':
        print(selected)
        return 0
    print('Classification: ' + selected)
    if selected == 'docs':
        print('INTENTIONALLY SKIPPED harness regressions: documentation-only changes; not reported as passed.')
    if not run_checks(baseline_checks(selected), ('git',)):
        print('UNRUN application checks')
        return 1
    if selected == 'docs':
        print('INTENTIONALLY SKIPPED application checks: documentation-only changes; not reported as passed.')
        app_status = 'skipped'
    else:
        if not run_checks(application_checks('full'), ('bun', 'node', 'age', 'git')):
            return 1
        app_status = 'success'
    ok = POLICY['result_ok'](selected, 'success', app_status)
    print('Verification: ' + ('PASS' if ok else 'FAIL'))
    return 0 if ok else 1

if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, VerificationError) as error:
        print('Verification failed: ' + str(error), file=sys.stderr)
        sys.exit(1)
