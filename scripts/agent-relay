#!/usr/bin/env python3
"""Agent Relay v1: two participants, one Git branch, one current message.

Transport only. It does not grant approvals, complete tasks or control another client.
"""
from __future__ import annotations

import argparse
import os
import re
import secrets
import stat
import subprocess
import sys
import tempfile
import uuid
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import quote, urlsplit

FILE = "relay.md"
BRANCH_PREFIX = "relay/"
MAX_BODY = 65536
MAX_DESCRIPTION = 200
AGENT_RE = re.compile(r"[^\s,:]{1,32}")
ID_RE = re.compile(r"[a-z0-9][a-z0-9-]{2,40}")
REMOTE_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}")
SECRET_PATTERNS = (
    re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"),
    re.compile(r"\bgh[pousr]_[A-Za-z0-9]{30,}\b"),
    re.compile(r"\bgithub_pat_[A-Za-z0-9_]{30,}\b"),
    re.compile(r"\bsk-[A-Za-z0-9]{32,}\b"),
    re.compile(r"\bAKIA[A-Z0-9]{16}\b"),
)
HEADER_ORDER = (
    "conversation", "description", "type", "state", "participants", "sequence",
    "message_id", "from", "to", "reply_expected", "read_by", "in_reply_to",
    "joined", "created_at",
)


class RelayError(Exception):
    pass


def now():
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def seq_text(value):
    return f"{int(value):04d}"


def github_blob_url(repo, remote, commit, path=FILE):
    """Return a GitHub blob URL pinned to the commit, or None when not derivable."""
    if not re.fullmatch(r"[0-9a-f]{40,64}", commit or ""):
        return None
    proc = run_git(["remote", "get-url", remote], repo, check=False)
    if proc.returncode:
        return None
    url = proc.stdout.strip()
    if not url:
        return None
    scp = re.fullmatch(r"(?:[^@/]+@)?github\.com:(.+)", url, re.IGNORECASE)
    if scp:
        repo_path = scp.group(1)
    else:
        parsed = urlsplit(url)
        if parsed.scheme not in ("http", "https", "ssh", "git"):
            return None
        if (parsed.hostname or "").lower() not in ("github.com", "www.github.com"):
            return None
        repo_path = parsed.path.lstrip("/")
    repo_path = repo_path.rstrip("/")
    if repo_path.endswith(".git"):
        repo_path = repo_path[:-4]
    parts = repo_path.split("/")
    if len(parts) != 2 or not all(parts):
        return None
    owner, name = parts
    return (
        f"https://github.com/{quote(owner, safe='')}/{quote(name, safe='')}"
        f"/blob/{commit}/{quote(path, safe='/')}"
    )


def print_relay_link(repo, remote, commit, label):
    url = github_blob_url(repo, remote, commit)
    if url:
        print(f"Relay: [{label}]({url})")
    else:
        print(f"Relay: commit {commit} (sin enlace GitHub disponible)")


def git_env(extra=None):
    env = os.environ.copy()
    env["GIT_TERMINAL_PROMPT"] = "0"
    if extra:
        env.update(extra)
    return env


def run_git(args, cwd, check=True, input_text=None):
    proc = subprocess.run(
        ["git", *args], cwd=str(cwd), input=input_text,
        capture_output=True, text=True, encoding="utf-8", env=git_env(),
    )
    if check and proc.returncode:
        detail = (proc.stderr or proc.stdout).strip()
        raise RelayError(detail or f"git {' '.join(args)} failed")
    return proc


def run_git_bytes(args, cwd, input_bytes):
    proc = subprocess.run(
        ["git", *args], cwd=str(cwd), input=input_bytes, capture_output=True,
        env=git_env(),
    )
    if proc.returncode:
        detail = proc.stderr.decode("utf-8", "replace").strip()
        raise RelayError(detail or f"git {' '.join(args)} failed")
    return proc.stdout.decode("ascii").strip()


def repo_root():
    proc = run_git(["rev-parse", "--show-toplevel"], Path.cwd())
    return Path(proc.stdout.strip())


def identity(explicit):
    value = (explicit or os.environ.get("RELAY_AGENT") or "").strip()
    if not value:
        raise RelayError("agent identity missing; set RELAY_AGENT or pass --me")
    if not AGENT_RE.fullmatch(value):
        raise RelayError("invalid agent identity; use 1-32 characters without spaces, comma or colon")
    return value


def check_text(text, label, limit=MAX_BODY):
    if not isinstance(text, str):
        raise RelayError(f"{label} must be text")
    if "\x00" in text:
        raise RelayError(f"{label} contains a NUL byte")
    if len(text.encode("utf-8")) > limit:
        raise RelayError(f"{label} exceeds {limit} bytes")
    for pattern in SECRET_PATTERNS:
        if pattern.search(text):
            raise RelayError(f"{label} contains an evident credential; relay is not a secret channel")


def read_body(path):
    try:
        if path == "-":
            data = sys.stdin.buffer.read(MAX_BODY + 1)
            if len(data) > MAX_BODY:
                raise RelayError(f"body exceeds {MAX_BODY} bytes")
        else:
            if not stat.S_ISREG(os.stat(path).st_mode):
                raise RelayError("body file must be a regular file")
            with open(path, "rb") as stream:
                data = stream.read(MAX_BODY + 1)
            if len(data) > MAX_BODY:
                raise RelayError(f"body exceeds {MAX_BODY} bytes")
    except OSError as exc:
        raise RelayError(f"cannot read body file: {exc}") from exc
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise RelayError("body must be UTF-8 text") from exc
    if not text.strip():
        raise RelayError("body is empty")
    check_text(text, "body")
    return text.rstrip("\n") + "\n"


def parse_document(text, expected_conversation=None):
    if not text.startswith("# Agent Relay\n"):
        raise RelayError("relay.md does not start with '# Agent Relay'")
    head, marker, body = text.partition("\n## Message\n")
    body = body if marker else None
    meta = {}
    for line in head.splitlines()[1:]:
        if not line.strip():
            continue
        if ": " not in line:
            raise RelayError(f"invalid header line: {line!r}")
        key, value = line.split(": ", 1)
        if key in meta:
            raise RelayError(f"duplicate header field: {key}")
        meta[key] = value
    required = ("conversation", "description", "type", "state", "participants", "sequence", "created_at")
    for key in required:
        if key not in meta:
            raise RelayError(f"missing header field: {key}")
    if expected_conversation is not None and meta["conversation"] != expected_conversation:
        raise RelayError("conversation ID does not match the branch")
    if meta["type"] not in ("init", "join", "message", "close"):
        raise RelayError("invalid record type")
    if meta["state"] not in ("open", "closed"):
        raise RelayError("invalid conversation state")
    try:
        meta["sequence"] = int(meta["sequence"])
    except ValueError as exc:
        raise RelayError("sequence must be an integer") from exc
    if meta["sequence"] < 0:
        raise RelayError("sequence must not be negative")
    participants = [p.strip() for p in meta["participants"].split(",") if p.strip()]
    if not participants or len(participants) > 2 or len(set(participants)) != len(participants):
        raise RelayError("participants must contain one or two distinct names")
    if any(not AGENT_RE.fullmatch(p) for p in participants):
        raise RelayError("invalid participant name")
    meta["participants"] = participants
    if meta["type"] in ("message", "close"):
        if len(participants) != 2:
            raise RelayError("a message needs exactly two participants")
        for key in ("from", "to", "created_at"):
            if key not in meta:
                raise RelayError(f"missing header field: {key}")
        if meta["from"] not in participants or meta["to"] not in participants:
            raise RelayError("from/to must be participants")
        if meta["from"] == meta["to"]:
            raise RelayError("from and to must differ")
    if meta["type"] == "join":
        if len(participants) != 2:
            raise RelayError("join needs two participants")
        if meta.get("joined") not in participants:
            raise RelayError("join record does not name the joined participant")
        if meta["sequence"] != 0:
            raise RelayError("join must not advance the message sequence")
    if meta["type"] == "init":
        if len(participants) != 1:
            raise RelayError("init needs exactly one participant")
        if meta["sequence"] != 0:
            raise RelayError("init must use sequence 0")
    if meta["type"] == "message":
        if meta["state"] != "open":
            raise RelayError("message cannot exist in a closed conversation")
        if meta["sequence"] < 1:
            raise RelayError("message sequence must be at least 1")
        for key in ("message_id", "reply_expected", "read_by"):
            if key not in meta:
                raise RelayError(f"missing header field: {key}")
        if meta["reply_expected"] not in ("true", "false"):
            raise RelayError("reply_expected must be true or false")
        read_by = [] if meta["read_by"] in ("", "none") else [p.strip() for p in meta["read_by"].split(",") if p.strip()]
        if len(set(read_by)) != len(read_by):
            raise RelayError("duplicate read_by participant")
        if any(p not in participants for p in read_by):
            raise RelayError("read_by must name participants")
        if any(p != meta["to"] for p in read_by):
            raise RelayError("only the recipient can acknowledge a message")
        meta["read_by"] = read_by
        if "in_reply_to" in meta:
            try:
                meta["in_reply_to"] = int(meta["in_reply_to"])
            except ValueError as exc:
                raise RelayError("in_reply_to must be an integer") from exc
            if not 0 < meta["in_reply_to"] < meta["sequence"]:
                raise RelayError("in_reply_to must reference an earlier message")
    if meta["type"] == "close":
        if meta["state"] != "closed":
            raise RelayError("close record must close the conversation")
        if meta["sequence"] < 1:
            raise RelayError("close sequence must be at least 1")
    return meta, body


def render_document(meta, body):
    lines = ["# Agent Relay"]
    for key in HEADER_ORDER:
        if key in meta and meta[key] is not None:
            value = meta[key]
            if isinstance(value, list):
                value = "none" if not value else ", ".join(value)
            lines.append(f"{key}: {value}")
    text = "\n".join(lines) + "\n"
    if body is not None:
        text += "\n## Message\n\n" + body.rstrip("\n") + "\n"
    return text


def fetch_branch(repo, remote, branch):
    ref = f"refs/remotes/{remote}/{branch}"
    proc = run_git(
        ["fetch", "--no-tags", remote, f"refs/heads/{branch}:{ref}"],
        repo, check=False,
    )
    if proc.returncode:
        detail = (proc.stderr or proc.stdout).strip()
        raise RelayError(f"cannot read {branch}: {detail}")
    return run_git(["rev-parse", ref], repo).stdout.strip()


def branch_exists(repo, remote, branch):
    proc = run_git(["ls-remote", "--heads", remote, f"refs/heads/{branch}"], repo)
    return bool(proc.stdout.strip())


def show_document(repo, revision, conversation):
    proc = run_git(["show", f"{revision}:{FILE}"], repo, check=False)
    if proc.returncode:
        raise RelayError(f"cannot read {FILE} at {revision[:12]}")
    return parse_document(proc.stdout, conversation)


def commit_file(repo, parent, content, message):
    blob = run_git_bytes(["hash-object", "-w", "--stdin"], repo, content.encode("utf-8"))
    with tempfile.TemporaryDirectory(prefix="agent-relay-") as temp:
        index = Path(temp) / "index"
        env = git_env({"GIT_INDEX_FILE": str(index)})
        if parent:
            proc = subprocess.run(
                ["git", "read-tree", f"{parent}^{{tree}}"], cwd=str(repo), env=env,
                capture_output=True, text=True,
            )
        else:
            proc = subprocess.run(
                ["git", "read-tree", "--empty"], cwd=str(repo), env=env,
                capture_output=True, text=True,
            )
        if proc.returncode:
            raise RelayError((proc.stderr or proc.stdout).strip() or "cannot prepare relay tree")
        proc = subprocess.run(
            ["git", "update-index", "--add", "--cacheinfo", f"100644,{blob},{FILE}"],
            cwd=str(repo), env=env, capture_output=True, text=True,
        )
        if proc.returncode:
            raise RelayError((proc.stderr or proc.stdout).strip() or "cannot stage relay file")
        proc = subprocess.run(
            ["git", "write-tree"], cwd=str(repo), env=env, capture_output=True, text=True,
        )
        if proc.returncode:
            raise RelayError((proc.stderr or proc.stdout).strip() or "cannot write relay tree")
        tree = proc.stdout.strip()
    args = ["commit-tree", tree]
    if parent:
        args += ["-p", parent]
    args += ["-m", message]
    return run_git(args, repo).stdout.strip()


def publish(repo, remote, branch, commit):
    proc = run_git(["push", remote, f"{commit}:refs/heads/{branch}"], repo, check=False)
    if proc.returncode:
        detail = (proc.stderr or proc.stdout).strip()
        raise RelayError(f"publication rejected; no retry attempted: {detail}")
    return proc


def is_ancestor(repo, commit, head):
    return run_git(["merge-base", "--is-ancestor", commit, head], repo, check=False).returncode == 0


def latest(repo, remote, branch, conversation):
    head = fetch_branch(repo, remote, branch)
    meta, body = show_document(repo, head, conversation)
    return head, meta, body


def verify_published(repo, remote, branch, commit, conversation, expected_message_id=None):
    head = fetch_branch(repo, remote, branch)
    if head == commit:
        return head, "current"
    if not is_ancestor(repo, commit, head):
        raise RelayError("remote verification failed; commit is not reachable from the branch")
    meta, _ = show_document(repo, head, conversation)
    if expected_message_id and meta.get("message_id") == expected_message_id:
        return head, "current"
    return head, "superseded"


def history(repo, head, conversation):
    revisions = run_git(["rev-list", head], repo).stdout.split()
    records = []
    for revision in revisions:
        meta, body = show_document(repo, revision, conversation)
        records.append((revision, meta, body))
    return records


def message_revisions(repo, head, conversation):
    seen = set()
    records = []
    for revision, meta, body in history(repo, head, conversation):
        if meta["type"] == "message":
            if meta["message_id"] in seen:
                continue
            seen.add(meta["message_id"])
            records.append((revision, meta, body))
        elif meta["type"] == "close":
            records.append((revision, meta, body))
    return records


def print_record(meta, body, revision=None, show_body=True):
    label = seq_text(meta["sequence"])
    if meta["type"] == "message":
        print(f"Mensaje {label} · {meta['from']} -> {meta['to']} · reply_expected={meta['reply_expected']} · read_by={','.join(meta['read_by']) or 'none'}", end="")
        if meta.get("in_reply_to") is not None:
            print(f" · in_reply_to={seq_text(meta['in_reply_to'])}", end="")
        print()
        print(f"message_id: {meta['message_id']}")
        if revision:
            print(f"commit: {revision}")
        if show_body and body is not None:
            print(body.rstrip("\n"))
    elif meta["type"] == "close":
        print(f"Conversación cerrada - {label} · {meta['from']} -> {meta['to']}")
        if revision:
            print(f"commit: {revision}")
        if show_body and body is not None:
            print(body.rstrip("\n"))
    else:
        print(f"{meta['type']} · {label} · estado={meta['state']} · participantes={', '.join(meta['participants'])}")


def generate_id(repo, remote):
    alphabet = "abcdefghjkmnpqrstuvwxyz23456789"
    for _ in range(8):
        candidate = "r-" + "".join(secrets.choice(alphabet) for _ in range(8))
        if not branch_exists(repo, remote, BRANCH_PREFIX + candidate):
            return candidate
    raise RelayError("could not allocate a unique conversation ID")


def cmd_init(args, repo, remote):
    me = identity(args.me)
    description = " ".join(args.description.split())
    if not description:
        raise RelayError("description is empty")
    if len(description) > MAX_DESCRIPTION:
        raise RelayError(f"description exceeds {MAX_DESCRIPTION} characters")
    check_text(description, "description", MAX_DESCRIPTION)
    conversation = generate_id(repo, remote)
    branch = BRANCH_PREFIX + conversation
    meta = {
        "conversation": conversation,
        "description": description,
        "type": "init",
        "state": "open",
        "participants": [me],
        "sequence": 0,
        "created_at": now(),
    }
    content = render_document(meta, None)
    commit = commit_file(repo, None, content, f"relay: init {conversation} by {me}")
    publish(repo, remote, branch, commit)
    try:
        verify_published(repo, remote, branch, commit, conversation)
    except RelayError as exc:
        print(f"Publicado, no verificado - {conversation} (rama {branch}): {exc}", file=sys.stderr)
        return 2
    print(f"Conversación creada: {conversation}")
    print(f"Participante: {me}")
    print(f"Rama: {branch}")
    print(f"Indica al otro participante: relay join {conversation}")
    return 0


def cmd_join(args, repo, remote):
    me = identity(args.me)
    conversation = validate_id(args.id)
    branch = BRANCH_PREFIX + conversation
    head, meta, _ = latest(repo, remote, branch, conversation)
    if meta["state"] == "closed":
        raise RelayError("conversation is closed")
    participants = list(meta["participants"])
    if me in participants:
        if len(participants) == 2:
            print(f"Conectado a la conversación {conversation}. Listo para recibir mensajes.")
            return 0
        raise RelayError("the initiator cannot join its own conversation")
    if len(participants) == 2:
        raise RelayError("conversation already has two participants")
    if meta["type"] != "init":
        raise RelayError("conversation is not joinable")
    participants.append(me)
    new_meta = {
        "conversation": conversation,
        "description": meta["description"],
        "type": "join",
        "state": "open",
        "participants": participants,
        "sequence": 0,
        "joined": me,
        "created_at": now(),
    }
    commit = commit_file(repo, head, render_document(new_meta, None), f"relay: join {conversation} by {me}")
    publish(repo, remote, branch, commit)
    try:
        verify_published(repo, remote, branch, commit, conversation)
    except RelayError as exc:
        print(f"Publicado, no verificado - join {conversation}: {exc}", file=sys.stderr)
        return 2
    print(f"Conectado a la conversación {conversation}. Listo para recibir mensajes.")
    return 0


def find_message(repo, head, conversation, sequence):
    for revision, meta, body in history(repo, head, conversation):
        if meta["type"] == "message" and meta["sequence"] == sequence:
            return revision, meta, body
    raise RelayError(f"message {seq_text(sequence)} not found")


def cmd_send(args, repo, remote):
    me = identity(args.me)
    conversation = validate_id(args.id)
    branch = BRANCH_PREFIX + conversation
    body = read_body(args.body_file)
    head, current, _ = latest(repo, remote, branch, conversation)
    if current["state"] != "open":
        raise RelayError("conversation is closed")
    participants = current["participants"]
    if me not in participants:
        raise RelayError("agent is not a participant; run join first")
    if len(participants) != 2:
        raise RelayError("conversation needs two participants; run join first")
    if current["type"] == "close":
        raise RelayError("conversation is closed")
    to = next(p for p in participants if p != me)
    if args.in_reply_to is not None:
        ref_revision, ref_meta, _ = find_message(repo, head, conversation, args.in_reply_to)
        if ref_meta["to"] != me:
            raise RelayError("cannot reply to a message not addressed to this agent")
        if ref_meta["type"] != "message":
            raise RelayError("in_reply_to must reference a message")
    sequence = current["sequence"] + 1
    meta = {
        "conversation": conversation,
        "description": current.get("description", ""),
        "type": "message",
        "state": "open",
        "participants": participants,
        "sequence": sequence,
        "message_id": str(uuid.uuid4()),
        "from": me,
        "to": to,
        "reply_expected": args.reply_expected,
        "read_by": [],
        "created_at": now(),
    }
    if args.in_reply_to is not None:
        meta["in_reply_to"] = args.in_reply_to
    commit = commit_file(repo, head, render_document(meta, body), f"relay: message {seq_text(sequence)} {me} -> {to}")
    publish(repo, remote, branch, commit)
    try:
        _, state = verify_published(repo, remote, branch, commit, conversation, meta["message_id"])
    except RelayError as exc:
        print(f"No verificado - {seq_text(sequence)}: {exc}", file=sys.stderr)
        return 2
    print_relay_link(repo, remote, commit, seq_text(sequence))
    if state == "superseded":
        head2 = fetch_branch(repo, remote, branch)
        latest_meta, _ = show_document(repo, head2, conversation)
        print(f"Listo - {seq_text(sequence)} (superado por {seq_text(latest_meta['sequence'])})")
    else:
        print(f"Listo - {seq_text(sequence)}")
    return 0


def cmd_read(args, repo, remote):
    me = identity(args.me)
    conversation = validate_id(args.id)
    branch = BRANCH_PREFIX + conversation
    head = fetch_branch(repo, remote, branch)
    if args.ack and (args.seq is not None or args.last is not None or args.after is not None):
        raise RelayError("--ack cannot be combined with historical reads")
    if args.message_id is not None and not args.ack:
        raise RelayError("--message-id is only valid with --ack")
    if args.ack and not args.message_id:
        raise RelayError("--ack requires --message-id from the read message")
    if args.last is not None and args.last < 1:
        raise RelayError("--last must be at least 1")
    if args.after is not None and args.after < 0:
        raise RelayError("--after must not be negative")
    if args.seq is not None and args.seq < 1:
        raise RelayError("--seq must be at least 1")
    if args.seq is not None or args.last is not None or args.after is not None:
        current_head, _ = show_document(repo, head, conversation)
        if me not in current_head["participants"]:
            raise RelayError("agent is not a participant; run join first")
        records = message_revisions(repo, head, conversation)
        if args.seq is not None:
            selected = [r for r in records if r[1]["sequence"] == args.seq]
        elif args.after is not None:
            selected = [r for r in records if r[1]["sequence"] > args.after]
        else:
            selected = records[: args.last]
        selected.reverse()
        if not selected:
            print("No hay mensajes en ese rango.")
            return 0
        for revision, meta, body in selected:
            print_record(meta, body, revision)
        return 0
    current, body = show_document(repo, head, conversation)
    if args.ack and current["type"] != "message":
        raise RelayError("no current message to acknowledge")
    if current["type"] in ("init", "join"):
        if me not in current["participants"]:
            raise RelayError("agent is not a participant; run join first")
        print_record(current, body, head)
        return 0
    if current["type"] == "close":
        if me not in current["participants"]:
            raise RelayError("agent is not a participant")
        print_relay_link(repo, remote, head, seq_text(current["sequence"]))
        print_record(current, body, head)
        return 0
    if me not in current["participants"]:
        raise RelayError("agent is not a participant; run join first")
    if current["to"] != me:
        print(f"No corresponde - {seq_text(current['sequence'])}")
        return 0 if not args.ack else 4
    if args.ack and current["message_id"] != args.message_id:
        print(
            f"Leído, no registrado - {seq_text(current['sequence'])}: "
            "the current message no longer matches the read message ID",
            file=sys.stderr,
        )
        return 2
    if me in current["read_by"]:
        print_relay_link(repo, remote, head, seq_text(current["sequence"]))
        print(f"Leído y registrado - {seq_text(current['sequence'])}")
        return 0
    if not args.ack:
        print_relay_link(repo, remote, head, seq_text(current["sequence"]))
        print_record(current, body, head)
        return 0
    if current["state"] != "open":
        raise RelayError("conversation is closed")
    new_meta = dict(current)
    new_meta["read_by"] = current["read_by"] + [me]
    commit = commit_file(repo, head, render_document(new_meta, body), f"relay: ack {seq_text(current['sequence'])} by {me}")
    publish(repo, remote, branch, commit)
    try:
        _, state = verify_published(repo, remote, branch, commit, conversation)
    except RelayError as exc:
        print(f"Leído, no verificado - {seq_text(current['sequence'])}: {exc}", file=sys.stderr)
        return 2
    if state not in ("current", "superseded"):
        print(f"Leído, no verificado - {seq_text(current['sequence'])}: remote verification failed", file=sys.stderr)
        return 2
    print_relay_link(repo, remote, commit, seq_text(current['sequence']))
    print(f"Leído y registrado - {seq_text(current['sequence'])}")
    return 0


def cmd_status(args, repo, remote):
    conversation = validate_id(args.id)
    branch = BRANCH_PREFIX + conversation
    head = fetch_branch(repo, remote, branch)
    meta, _ = show_document(repo, head, conversation)
    print(f"Conversación: {conversation}")
    print(f"Descripción: {meta['description']}")
    print(f"Estado: {meta['state']}")
    print(f"Participantes: {', '.join(meta['participants'])}")
    print(f"Rama: {branch}")
    print(f"HEAD: {head}")
    print(f"Secuencia: {seq_text(meta['sequence'])}")
    if meta["type"] == "message":
        line = f"Último: message {meta['from']} -> {meta['to']} · reply_expected={meta['reply_expected']} · read_by={','.join(meta['read_by']) or 'none'}"
        if meta.get("in_reply_to") is not None:
            line += f" · in_reply_to={seq_text(meta['in_reply_to'])}"
        print(line)
        print(f"message_id: {meta['message_id']}")
    else:
        print(f"Último: {meta['type']}")
    return 0


def cmd_close(args, repo, remote):
    me = identity(args.me)
    conversation = validate_id(args.id)
    branch = BRANCH_PREFIX + conversation
    head, current, _ = latest(repo, remote, branch, conversation)
    if current["state"] == "closed":
        raise RelayError("conversation is already closed")
    participants = current["participants"]
    if me not in participants:
        raise RelayError("agent is not a participant")
    if len(participants) != 2:
        raise RelayError("conversation needs two participants")
    to = next(p for p in participants if p != me)
    body = read_body(args.body_file) if args.body_file else None
    sequence = current["sequence"] + 1
    meta = {
        "conversation": conversation,
        "description": current.get("description", ""),
        "type": "close",
        "state": "closed",
        "participants": participants,
        "sequence": sequence,
        "from": me,
        "to": to,
        "created_at": now(),
    }
    commit = commit_file(repo, head, render_document(meta, body), f"relay: close {seq_text(sequence)} by {me}")
    publish(repo, remote, branch, commit)
    try:
        _, state = verify_published(repo, remote, branch, commit, conversation)
    except RelayError as exc:
        print(f"Publicado, no verificado - {conversation} close {seq_text(sequence)}: {exc}", file=sys.stderr)
        return 2
    print_relay_link(repo, remote, commit, seq_text(sequence))
    if state == "superseded":
        head2 = fetch_branch(repo, remote, branch)
        latest_meta, _ = show_document(repo, head2, conversation)
        print(f"Listo - {seq_text(sequence)} (superado por {seq_text(latest_meta['sequence'])})")
    else:
        print(f"Listo - {seq_text(sequence)}")
    return 0


def validate_id(value):
    if not ID_RE.fullmatch(value or ""):
        raise RelayError("invalid conversation ID")
    return value


def parser():
    root = argparse.ArgumentParser(prog="agent-relay", description="Two-participant Git relay transport.")
    root.add_argument("--remote", default="origin")
    sub = root.add_subparsers(dest="command", required=True)

    init = sub.add_parser("init", help="create a conversation with an automatic ID")
    init.add_argument("description")
    init.add_argument("--me")
    init.set_defaults(func=cmd_init)

    join = sub.add_parser("join", help="join an existing conversation")
    join.add_argument("id")
    join.add_argument("--me")
    join.set_defaults(func=cmd_join)

    send = sub.add_parser("send", help="publish a message")
    send.add_argument("id")
    send.add_argument("--body-file", required=True)
    send.add_argument("--reply-expected", required=True, choices=("true", "false"))
    send.add_argument("--in-reply-to", type=int)
    send.add_argument("--me")
    send.set_defaults(func=cmd_send)

    read = sub.add_parser("read", help="read the latest message or a historical range")
    read.add_argument("id")
    read.add_argument("--ack", action="store_true", help="record read_by on the current message")
    read.add_argument("--message-id", help="message ID read by this agent; required with --ack")
    read.add_argument("--seq", type=int)
    read.add_argument("--last", type=int)
    read.add_argument("--after", type=int)
    read.add_argument("--me")
    read.set_defaults(func=cmd_read)

    status = sub.add_parser("status", help="show conversation metadata without the body")
    status.add_argument("id")
    status.set_defaults(func=cmd_status)

    close = sub.add_parser("close", help="publish a terminal close record")
    close.add_argument("id")
    close.add_argument("--body-file")
    close.add_argument("--me")
    close.set_defaults(func=cmd_close)
    return root


def main():
    args = parser().parse_args()
    try:
        repo = repo_root()
        if not REMOTE_RE.fullmatch(args.remote):
            raise RelayError("invalid remote name; use a configured Git remote name")
        return args.func(args, repo, args.remote)
    except RelayError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
