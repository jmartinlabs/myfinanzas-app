#!/usr/bin/env python3
"""Check the approved workspace/dependency and browser/server boundaries."""
import argparse
import json
import runpy
from pathlib import Path
import re
import sys


def validate(root, workflow_path=None):
    root = Path(root)
    errors = []
    try:
        manifest = json.loads((root / 'package.json').read_text())
        if manifest.get('packageManager') != 'bun@' + (root / '.bun-version').read_text().strip():
            errors.append('toolchain: packageManager must match .bun-version')
        if 'apps/*' not in manifest.get('workspaces', []):
            errors.append('workspaces: apps/* is required')
        packages = [root / 'package.json', root / 'apps/api/package.json', root / 'apps/web/package.json']
        orms = {'prisma', '@prisma/client', 'typeorm', 'drizzle-orm', 'sequelize', 'mikro-orm', '@mikro-orm/core'}
        for path in packages:
            package = json.loads(path.read_text())
            if package.get('private') is not True:
                errors.append(f'package: {path.relative_to(root)} must prevent npm publication')
            for section in ('dependencies', 'devDependencies'):
                for name, version in package.get(section, {}).items():
                    if not re.fullmatch(r'\d+\.\d+\.\d+(?:-[A-Za-z0-9.-]+)?', version):
                        errors.append(f'version: {name} must have an exact version')
                    if name in orms:
                        errors.append(f'orm: {name} conflicts with direct SQL')
        if not (root / 'scripts/verify').is_file():
            errors.append('verification-entry: canonical scripts/verify is required')
        policy = runpy.run_path(str(root / 'scripts/ci_workflow.py'))
        active = Path(workflow_path) if workflow_path else root / '.github/workflows/validate.yml'
        errors.extend(policy['validate_workflow'](active))
        # The inactive fixture and active graph must independently satisfy the recipe.
        errors.extend(policy['validate_workflow'](root / 'scripts/fixtures/ci-policy.workflow.json'))
        for path in (root / 'apps/web/src').rglob('*'):
            if path.suffix not in ('.ts', '.tsx', '.js', '.jsx'):
                continue
            source = path.read_text()
            imports = re.findall(r'''(?:from\s*|import\s*\(|require\s*\()\s*["']([^"']+)["']''', source)
            imports += re.findall(r'''\bimport\s*["']([^"']+)["']''', source)
            for target in imports:
                resolved = (path.parent / target).resolve()
                api = (root / 'apps/api').resolve()
                if target.startswith(('bun:', 'node:')) or (target.startswith('.') and resolved.is_relative_to(api)):
                    errors.append(f'boundary: browser source imports server code in {path.relative_to(root)}')
    except (OSError, ValueError, TypeError) as error:
        errors.append(f'configuration: {type(error).__name__}')
    return errors


if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('--workflow', type=Path, help='validate an additional workflow against the supported recipe')
    args = parser.parse_args()
    errors = validate(Path(__file__).resolve().parents[1], args.workflow)
    for error in errors:
        print(error, file=sys.stderr)
    if errors:
        sys.exit(1)
    print('Project checks passed: Bun workspaces, exact dependencies, no known ORM, browser/server imports.')
