# Template only. Do not replace /etc/caddy/Caddyfile until production gates pass.
# Static Vite build must be delivered independently to /var/www/myfinanzas.
myfinanzas.pp.ua {
    encode zstd gzip
    handle /api/* {
        reverse_proxy 127.0.0.1:18081
    }
    handle {
        root * /var/www/myfinanzas
        try_files {path} /index.html
        file_server
    }
}
